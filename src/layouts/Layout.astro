---
import '../styles/global.css';
import QuoteDialog from '../components/QuoteDialog.astro';

/* Above-the-fold hero fonts, preloaded by URL below. Same files the
   @font-face rules reference, so the hashed build output is shared. */
import Fraunces600 from '../../node_modules/@fontsource/fraunces/files/fraunces-latin-600-normal.woff2?url';
import InstrumentSans400 from '../../node_modules/@fontsource/instrument-sans/files/instrument-sans-latin-400-normal.woff2?url';
import InstrumentSans500 from '../../node_modules/@fontsource/instrument-sans/files/instrument-sans-latin-500-normal.woff2?url';

interface Props {
  title: string;
  description: string;
  /** Path to a 1200x630 social preview image, relative to /public */
  ogImage?: string;
}

const {
  title,
  description,
  ogImage = '/og-image.png',
} = Astro.props;

const siteName = 'Karamba Technologies';
const fullTitle = title === siteName ? title : `${title} | ${siteName}`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />

		<!-- No-flash theme init: must run before first paint -->
		<script is:inline>
			(function () {
				const stored = localStorage.getItem('kt-theme');
				const theme =
					stored ||
					(window.matchMedia('(prefers-color-scheme: dark)').matches
						? 'dark'
						: 'light');
				document.documentElement.setAttribute('data-theme', theme);
			})();
		</script>

		<!-- Preload only the above-the-fold hero fonts -->
		<link rel="preload" href={Fraunces600} as="font" type="font/woff2" crossorigin />
		<link rel="preload" href={InstrumentSans400} as="font" type="font/woff2" crossorigin />
		<link rel="preload" href={InstrumentSans500} as="font" type="font/woff2" crossorigin />

		<title>{fullTitle}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonicalURL} />

		<!-- Favicons -->
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<link rel="icon" href="/favicon.ico" sizes="48x48" />

		<!-- Open Graph / social preview -->
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content={siteName} />
		<meta property="og:title" content={fullTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={new URL(ogImage, Astro.site)} />
		<meta property="og:url" content={canonicalURL} />
		<meta name="twitter:card" content="summary_large_image" />

		<meta name="generator" content={Astro.generator} />
	</head>
	<body>
		<a href="#main" class="skip-link">Skip to content</a>
		<main id="main" tabindex="-1">
			<slot />
		</main>

		<QuoteDialog />

		<!-- Without JS there is no observer, so make sure nothing stays hidden -->
		<noscript>
			<style>.scroll-reveal { opacity: 1; }</style>
		</noscript>

		<!-- Scroll-triggered reveals - see .scroll-reveal in global.css. Runs
		     once per page and fires each element a single time. -->
		<script is:inline>
			(function () {
				const targets = document.querySelectorAll('.scroll-reveal');
				if (!targets.length) return;

				// Reduced-motion visitors get the CSS fallback (fully visible, no
				// movement) - no observers needed.
				if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
					targets.forEach((el) => el.classList.add('is-visible'));
					return;
				}

				const observer = new IntersectionObserver((entries) => {
					entries.forEach((entry) => {
						if (!entry.isIntersecting) return;
						entry.target.classList.add('is-visible');
						observer.unobserve(entry.target);
					});
				}, { rootMargin: '0px 0px 60px 0px', threshold: 0.05 });

				targets.forEach((el) => observer.observe(el));
			})();
		</script>

		<!-- 3D cursor tilt for .tilt-card (Services cards, Product mockup).
		     Page-wide and after <slot /> so one copy serves every component and
		     every card already exists when the query runs. Being a bundled
		     <script>, Astro emits it as a deferred module, so it executes after
		     parsing even ahead of its position in the body. -->
		<script>
			const MAX_TILT = 8;      // degrees at the card's edge
			const HOVER_SCALE = 1.02;
			const PERSPECTIVE = 800; // px
			// Short, but eased rather than linear: pointer moves arrive in bursts
			// and linear reads mechanical. Long enough to take the jitter out,
			// short enough to still feel attached to the cursor.
			const FOLLOW = 'transform 0.05s ease-out';
			const RETURN = 'transform 0.4s cubic-bezier(0.22, 1, 0.36, 1)';
			const FLAT = `perspective(${PERSPECTIVE}px) rotateX(0deg) rotateY(0deg) scale3d(1, 1, 1)`;

			const fine = window.matchMedia('(hover: hover) and (pointer: fine)');
			const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
			const cards = Array.from(document.querySelectorAll('.tilt-card'));

			// .scroll-reveal animates transform with fill "both", so once it has
			// finished the animation still owns the property - and animation
			// declarations outrank normal inline styles in the cascade. Left alone
			// the tilt below is computed and then silently discarded, which is
			// exactly the "nothing happens on hover" symptom. The end state is
			// already declared on .scroll-reveal.is-visible, so dropping the
			// animation is safe and hands transform back to the inline style.
			const released = new WeakSet();
			function releaseReveal(card) {
				if (released.has(card)) return;
				released.add(card);
				card.style.animation = 'none';
			}

			function attach(card) {
				const onEnter = () => releaseReveal(card);
				const onMove = (e) => {
					releaseReveal(card);
					const r = card.getBoundingClientRect();
					const x = (e.clientX - r.left) / r.width; // 0 at the left edge, 1 at the right
					const y = (e.clientY - r.top) / r.height; // 0 at the top edge, 1 at the bottom
					card.style.transition = FOLLOW;
					card.style.transform =
						`perspective(${PERSPECTIVE}px) ` +
						`rotateX(${((0.5 - y) * MAX_TILT * 2).toFixed(2)}deg) ` +
						`rotateY(${((x - 0.5) * MAX_TILT * 2).toFixed(2)}deg) ` +
						`scale3d(${HOVER_SCALE}, ${HOVER_SCALE}, ${HOVER_SCALE})`;
				};
				const onLeave = () => {
					card.style.transition = RETURN;
					card.style.transform = FLAT;
				};
				const onRevealEnd = () => releaseReveal(card);

				card.addEventListener('mouseenter', onEnter);
				card.addEventListener('mousemove', onMove);
				card.addEventListener('mouseleave', onLeave);
				card.addEventListener('animationend', onRevealEnd);

				return () => {
					card.removeEventListener('mouseenter', onEnter);
					card.removeEventListener('mousemove', onMove);
					card.removeEventListener('mouseleave', onLeave);
					card.removeEventListener('animationend', onRevealEnd);
					card.style.transition = '';
					card.style.transform = '';
				};
			}

			// Attach only where hovering is genuinely real, and re-check if that
			// changes mid-session (a mouse plugged in, reduced motion switched on).
			let detachers = [];
			function sync() {
				const wanted = fine.matches && !reduce.matches;
				if (wanted && !detachers.length) {
					detachers = cards.map(attach);
				} else if (!wanted && detachers.length) {
					detachers.forEach((off) => off());
					detachers = [];
				}
			}
			fine.addEventListener('change', sync);
			reduce.addEventListener('change', sync);
			sync();
		</script>

		<style>
			/* Skip link: out of sight until keyboard focus lands on it. */
			.skip-link {
				position: absolute;
				left: 1rem;
				top: -4rem;
				z-index: 100;
				padding: 0.6rem 1.1rem;
				border-radius: 999px;
				background-color: var(--color-primary);
				color: var(--color-primary-text);
				font-size: 0.875rem;
				font-weight: 600;
				text-decoration: none;
				transition: top 0.2s ease;
			}
			.skip-link:focus-visible {
				top: 1rem;
				outline: 2px solid var(--color-accent-strong);
				outline-offset: 2px;
			}
			#main:focus {
				outline: none;
			}
			@media (prefers-reduced-motion: reduce) {
				.skip-link {
					transition: none;
				}
			}
		</style>
	</body>
</html>
