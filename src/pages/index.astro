---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Services from '../components/Services.astro';
import Product from '../components/Product.astro';
import CaseStudy from '../components/CaseStudy.astro';
import Process from '../components/Process.astro';
import About from '../components/About.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';

const title = 'Karamba Technologies';
const description = 'Karamba Technologies builds web and mobile software that replaces paper and spreadsheets for farms, schools, NGOs and growing businesses.';
---

<Layout title={title} description={description}>
	<Header />
	<Hero />
	<Services />
	<Product />
	<CaseStudy />
	<Process />
	<About />
	<Contact />
	<Footer />
</Layout>