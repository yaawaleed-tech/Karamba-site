---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import WhatWeBuild from '../components/WhatWeBuild.astro';
import HowWeWork from '../components/HowWeWork.astro';
import ClosingCta from '../components/ClosingCta.astro';
import Footer from '../components/Footer.astro';

const title = 'Karamba Technologies';
const description = 'Karamba Technologies builds web and mobile software that replaces paper and spreadsheets for farms, schools, NGOs and growing businesses.';
---

<Layout title={title} description={description}>
	<Header />
	<Hero />
	<WhatWeBuild />
	<HowWeWork />
	<ClosingCta />
	<Footer />
</Layout>