---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import ServicePage from '../../components/page/ServicePage.astro';
import { serviceBySlug } from '../../data/services';

const entry = serviceBySlug('custom-software');

const trail = [
  { name: 'Home', url: '/' },
  { name: 'Services', url: '/services' },
  { name: entry.name, url: `/services/${entry.slug}` },
];
const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: trail.map((crumb, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: crumb.name,
    item: new URL(crumb.url, Astro.site).toString(),
  })),
});
---

<Layout title={entry.name} description={entry.metaDescription}>
	<Header />
	<ServicePage entry={entry} />
	<script type="application/ld+json" set:html={jsonLd} />
	<Footer />
</Layout>
