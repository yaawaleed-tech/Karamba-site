---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import PagePlaceholder from '../../components/PagePlaceholder.astro';
import { NAV_MENUS } from '../../data/nav';

const MENU_KEY = 'services';
const ITEM_HREF = '/services/automation-and-ai';

const menu = NAV_MENUS.find((m) => m.key === MENU_KEY)!;
const item = menu.items.find((i) => i.href === ITEM_HREF)!;

const TITLE = item.name;
const DESCRIPTION = item.description;
---

<Layout title={TITLE} description={DESCRIPTION}>
	<Header />
	<PagePlaceholder
		hubHref={menu.hubHref}
		hubLabel={menu.label}
		title={TITLE}
		description={DESCRIPTION}
		status={item.status}
	/>
	<Footer />
</Layout>
