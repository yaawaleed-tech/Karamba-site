     as before. Letters and the second sentence are inline-blocks so the
     scroll transforms apply (transforms ignore plain inline boxes). */
  .hl-a {
    white-space: nowrap;
  }
  .hl-letter,
  .hl-b {
    display: inline-block;
  }
  .hero-support {
    margin: 0.6em auto 0;
    max-width: 38em;
    font-size: 12px;
    font-size: clamp(12px, 1.35cqw, 17px);
    line-height: 1.5;
    color: var(--color-text-muted);
  }

