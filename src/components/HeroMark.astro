    text-transform: uppercase;
    color: var(--color-accent-strong);
    margin-bottom: 3px;
  }
  .lb span {
    display: block;
    font-size: 13px;
    font-size: clamp(10px, 1.3cqw, 15px);
    line-height: 1.4;
    color: var(--color-text);
