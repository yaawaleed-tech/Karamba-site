     still live, so screen readers hear the current callout. Fixed height
     fits the name plus the longest description on two lines, so swapping
     callouts never moves the layout. The 400ms fade is the mobile
     crossfade; desktop swaps are instant under the hidden clipping. */
  .cap {
    text-align: center;
    margin: 10px 20px 0;
    min-height: 4.6em;
    font-size: 15px;
    color: var(--color-text-muted);
    transition: opacity 0.4s ease;
  }
  .cap-hide {
    opacity: 0;
  }
  .cap b {
    display: block;
    font-size: 12px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-accent-strong);
  }

  /* Facet dots live on phones only; hidden everywhere else. */
  .dots {
    display: none;
  }
  @media (min-width: 720px) {
    .cap {
      position: absolute;
      width: 1px;
      height: 1px;
      margin: -1px;
      padding: 0;
      overflow: hidden;
      clip: rect(0 0 0 0);
      clip-path: inset(50%);
      white-space: nowrap;
      border: 0;
    }
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0 0 0 0);
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }

  @media (max-width: 719px) {
    .hero-stage {
      aspect-ratio: auto;
    }
    .hero-mark {
      position: relative;
      left: auto;
      top: auto;
      width: min(84%, 380px);
      margin: 4px auto 0;
    }
    .lines,
    .lb {
      display: none;
    }
