---
import manifest from '../assets/brand/karamba-pieces/manifest.json';
import {
  HERO_LAYOUT,
  HERO_FACETS,
  HERO_ASSEMBLY_ORDER,
  HERO_FIXED_FACETS,
} from '../data/hero-facets';

interface ManifestPiece {
  k: string;
  file: string;
  x: number;
  y: number;
  w: number;
  h: number;
  ax: number;
  ay: number;
  poly: string;
}

interface Props {
  headline: string;
  support: string;
}

const { headline, support } = Astro.props;

const { stage, mark, canvas, slots } = HERO_LAYOUT;
const pieces = (manifest.pieces as ManifestPiece[]).filter((p) =>
  HERO_FACETS.some((f) => f.key === p.k),
);
const facetByKey = new Map(HERO_FACETS.map((f) => [f.key, f]));
const slotById = new Map(slots.map((s) => [s.id, s]));

/* Unprocessed file URLs: the pieces are served byte-identical, never
   re-encoded. Keys look like ../assets/brand/karamba-pieces/next.webp. */
const pieceUrls = import.meta.glob(
  '../assets/brand/karamba-pieces/*.webp',
  { query: '?url', import: 'default', eager: true },
) as Record<string, string>;
function pieceUrl(file: string): string {
  const hit = Object.entries(pieceUrls).find(([path]) => path.endsWith('/' + file));
  return hit ? hit[1] : '';
}

/* Logo centre in canvas coordinates, for the fly-in and hover vectors. */
const CX = 328;
const CY = 342;
const scale = mark.width / canvas.width;

const pct = (v: number, base: number) => ((v / base) * 100).toFixed(3) + '%';
const r1 = (v: number) => Math.round(v * 10) / 10;

function anchorStage(p: ManifestPiece) {
  return { x: r1(mark.left + p.ax * scale), y: r1(mark.top + p.ay * scale) };
}

/* Diagonal from the anchor, then horizontal into the slot dot. */
function linePath(a: { x: number; y: number }, s: { x: number; y: number }) {
  const ex = r1(a.x + (s.x - a.x) * 0.5);
  return `M${a.x},${a.y} L${ex},${s.y} L${s.x},${s.y}`;
}

/* About 10px away from the logo centre, in rendered pixels. */
function lift(p: ManifestPiece) {
  const dx = p.ax - CX;
  const dy = p.ay - CY;
  const n = Math.hypot(dx, dy) || 1;
  return { x: ((dx / n) * 10).toFixed(1), y: ((dy / n) * 10).toFixed(1) };
}

/* Scroll-exit vectors (Chunk 2E): unit vector away from the logo centre
   (same direction source as the hover lift), per-piece depth, and rotation
   sign alternating in manifest order. */
const DEPTH: Record<string, number> = {
  arrow: 1.4,
  intelligence: 1.3,
  cloud: 1.2,
  commerce: 1.1,
  next: 1.0,
  logistics: 0.9,
  education: 0.8,
  automation: 0.7,
  core: 0.6,
};
const RS: Record<string, number> = {
  next: 1,
  arrow: -1,
  education: 1,
  core: -1,
  commerce: 1,
  cloud: -1,
  logistics: 1,
  automation: -1,
  intelligence: 1,
};
function unit(p: ManifestPiece) {
  const dx = p.ax - CX;
  const dy = p.ay - CY;
  const n = Math.hypot(dx, dy) || 1;
  return { x: (dx / n).toFixed(3), y: (dy / n).toFixed(3) };
}

/* Headline choreography (Chunk 2G): split the first sentence into one span
   per character with deterministic scatter vectors; the rest stays one
   span. Derived from the headline prop so the copy has a single source. */
const HL_A_TEXT = headline.includes('. ') ? headline.split('. ')[0] + '.' : headline;
const HL_B_TEXT = headline.slice(HL_A_TEXT.length).trim();
interface HlLetter {
  ch: string;
  i: number;
  dx: number;
  dy: number;
  r: number;
  o: number;
}
const HL_A: HlLetter[] = HL_A_TEXT.split('').map((ch, i) => ({
  ch: ch === ' ' ? ' ' : ch,
  i,
  dx: ((i * 37) % 11 - 5) * 38,
  dy: ((i * 53) % 9 - 4) * 30 - 50,
  r: ((i * 29) % 13 - 6) * 16,
  o: +(i * 1.2).toFixed(1),
}));
---

<div class="hero-stage" id="hero-stage" data-fixed={HERO_FIXED_FACETS.join(' ')}>
  <div class="hero-mark" id="hero-mark">
    {
      pieces.map((p) => {
        const v = lift(p);
        const u = unit(p);
        return (
          <div
            class="pc"
            data-facet={p.k}
            data-ax={p.ax}
            data-ay={p.ay}
            data-order={HERO_ASSEMBLY_ORDER.indexOf(p.k)}
            style={`left:${pct(p.x, canvas.width)};top:${pct(p.y, canvas.height)};width:${pct(p.w, canvas.width)};height:${pct(p.h, canvas.height)};--hx:${v.x}px;--hy:${v.y}px;--ux:${u.x};--uy:${u.y};--depth:${DEPTH[p.k] ?? 1};--rs:${RS[p.k] ?? 1}`}
            aria-hidden="true"
          >
            <img
              src={pieceUrl(p.file)}
              width={p.w}
              height={p.h}
              alt=""
              decoding="async"
              draggable="false"
              fetchpriority="high"
            />
          </div>
        );
      })
    }
    <svg class="hit" viewBox="0 0 656 684">
      {
        pieces.map((p) => {
          const f = facetByKey.get(p.k);
          if (!f) return null;
          return p.k === 'next' ? (
            <a href="#contact" class="hit-link" data-facet={p.k} aria-label={f.name}>
              <polygon points={p.poly} fill="transparent" />
            </a>
          ) : (
            <polygon
              data-facet={p.k}
              points={p.poly}
              fill="transparent"
              role="button"
              tabindex="0"
              aria-label={f.name}
            />
          );
        })
      }
    </svg>
  </div>

  {/* Scroll-exit shell around labels and leader lines: fading this one
      wrapper never touches the class-driven opacity underneath. */}
  <div class="hero-callouts">
  <svg class="lines" viewBox="0 0 1000 620" aria-hidden="true">
    {
      pieces.map((p) => {
        const f = facetByKey.get(p.k);
        const s = f && slotById.get(f.slot);
        if (!f || !s) return null;
        const a = anchorStage(p);
        return (
          <g data-facet={p.k}>
            <path d={linePath(a, s)} pathLength="1" />
            <circle cx={a.x} cy={a.y} r="4" />
            <circle cx={s.x} cy={s.y} r="4" />
          </g>
        );
      })
    }
  </svg>

  {
    pieces.map((p) => {
      const f = facetByKey.get(p.k);
      const s = f && slotById.get(f.slot);
      if (!f || !s) return null;
      return (
        <div
          class={`lb ${s.side}`}
          data-facet={p.k}
          data-slot={f.slot}
          data-side={s.side}
          style={`left:${(s.x / stage.width) * 100}%;top:${((s.y / stage.height) * 100).toFixed(2)}%`}
          aria-hidden="true"
        >
          <b>{f.name}</b>
          <span>{f.description}</span>
        </div>
      );
    })
  }
  </div>

  <p class="cap cap-hide" aria-live="polite" aria-atomic="true">
    <b id="hero-cap-name"></b><span id="hero-cap-desc"></span>
  </p>

  {/* Phone facet dots, in scheduler order: the lit dot names the facet
      the caption belongs to. Hidden on desktop. */}
  <div class="dots" role="group" aria-label="Facet selector">
    {HERO_FACETS.map((f) => (
      <button
        type="button"
        class="dot"
        data-facet={f.key}
        aria-label={`Show ${f.name}`}
        aria-pressed="false"
      >
        <span aria-hidden="true"></span>
      </button>
    ))}
  </div>

  {/* Scroll-exit shell around the headline: the lift and fade animate
      this box so .hero-copy keeps its own reveal transition. */}
  <div class="hero-copy-outer">
    <div class="hero-copy">
      <h1 class="hero-title">
        <span class="visually-hidden">{headline}</span>
        <span class="hl-visual" aria-hidden="true">
          <span class="hl-a">
            {HL_A.map((l) => (
              <span
                class="hl-letter"
                style={`--i:${l.i};--dx:${l.dx}px;--dy:${l.dy}px;--r:${l.r}deg;--o:${l.o}`}
              >
                {l.ch}
              </span>
            ))}
          </span>{' '}
          <span class="hl-b">{HL_B_TEXT}</span>
        </span>
      </h1>
      <p class="hero-support">{support}</p>
    </div>
  </div>

  <ul class="visually-hidden">
    {
      HERO_FACETS.map((f) => (
        <li>
          <strong>{f.name}:</strong> {f.description}
        </li>
      ))
    }
  </ul>

</div>

<noscript>
  <style>
    .hero-mark .pc { opacity: 1; }
    .hero-copy { opacity: 1; transform: none; }
  </style>
</noscript>

<script>
  (function () {
    var stage = document.getElementById('hero-stage');
    if (!stage) return;
    var mark = document.getElementById('hero-mark');
    var heroRoot = document.getElementById('hero');
    var capName = document.getElementById('hero-cap-name');
    var capDesc = document.getElementById('hero-cap-desc');
    var capEl = stage.querySelector('.cap');
    var reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    var mobileQ = window.matchMedia('(max-width: 719.98px)');
    var coarseQ = window.matchMedia('(pointer: coarse)');

    /* Phone exit geometry for "One system.", measured from LAYOUT so
       transforms cannot feed back into the numbers. Both values land on
       #hero-track next to each other and the keyframes read them there.
       scale: 0.87 of the viewport over the span's own width.
       dx: distance from the span's centre to the track's centre, because
       the span sits in the right half of the one-line headline at rest.
       If either measurement is unusable, the CSS fallbacks in global.css
       stay in charge. */
    var hlB = stage.querySelector('.hl-b');
    var heroTrack = document.getElementById('hero-track');
    function offsetCentreX(el) {
      var x = 0;
      var node = el;
      while (node && node !== heroTrack) {
        x += node.offsetLeft || 0;
        node = node.offsetParent;
      }
      return x;
    }
    function measureOneSystem() {
      if (!hlB || !heroTrack) return;
      var w = hlB.offsetWidth;
      if (!w) return;
      var scale = (0.87 * window.innerWidth) / w;
      if (scale < 1.2 || scale > 6) return;
      heroTrack.style.setProperty('--one-system-final-scale', scale.toFixed(3));
      var dx = heroTrack.clientWidth / 2 - (offsetCentreX(hlB) + w / 2);
      if (isFinite(dx)) {
        heroTrack.style.setProperty('--one-system-dx', dx.toFixed(1) + 'px');
      }
    }
    if (document.fonts && document.fonts.ready) {
      document.fonts.ready.then(measureOneSystem);
    } else {
      measureOneSystem();
    }
    var resizeTimer = 0;
    window.addEventListener('resize', function () {
      clearTimeout(resizeTimer);
      resizeTimer = window.setTimeout(measureOneSystem, 200);
    });

    var pieceEls = new Map();
    var labelEls = new Map();
    var lineGroups = new Map();
    stage.querySelectorAll('.pc').forEach(function (el) {
      pieceEls.set(el.dataset.facet, el);
    });
    stage.querySelectorAll('.lb').forEach(function (el) {
      labelEls.set(el.dataset.facet, el);
    });
    stage.querySelectorAll('.lines g').forEach(function (el) {
      lineGroups.set(el.dataset.facet, el);
    });
    var hitEls = Array.from(stage.querySelectorAll('.hit [data-facet]'));
    var dotEls = new Map();
    stage.querySelectorAll('.dots .dot').forEach(function (el) {
      dotEls.set(el.dataset.facet, el);
    });

    function slotOf(key) {
      var lb = labelEls.get(key);
      return lb ? lb.dataset.slot : '';
    }

    function sideOf(key) {
      var lb = labelEls.get(key);
      return lb ? lb.dataset.side : '';
    }

    /* Last shown callout per side, for the periphery rail markers. */
    var lastBySide = { L: '', R: '' };

    function heroLabelCenter(key) {
      var lb = labelEls.get(key);
      if (!lb || !heroRoot) return null;
      var lr = lb.getBoundingClientRect();
      var hr = heroRoot.getBoundingClientRect();
      if (!lr.height) return null;
      return Math.round((lr.top + lr.height / 2 - hr.top) * 10) / 10;
    }

    /* Publish one side's marker: the label centre in px relative to the
       hero through --mk-l/--mk-r, visibility through data-mk-l/data-mk-r.
       Falls back to any remaining callout on that side, else switches off. */
    function refreshMarker(side) {
      if (!heroRoot) return;
      var attr = side === 'L' ? 'mkL' : 'mkR';
      var prop = side === 'L' ? '--mk-l' : '--mk-r';
      var pick = lastBySide[side] && active.has(lastBySide[side]) ? lastBySide[side] : '';
      if (!pick) {
        active.forEach(function (exp, k) {
          if (!pick && sideOf(k) === side) pick = k;
        });
        lastBySide[side] = pick;
      }
      if (pick) {
        var y = heroLabelCenter(pick);
        if (y !== null) heroRoot.style.setProperty(prop, y + 'px');
        heroRoot.dataset[attr] = 'on';
      } else {
        heroRoot.dataset[attr] = 'off';
      }
    }

    /* Visible callouts: key -> expiry timestamp. */
    var active = new Map();
    var target = 3;
    var lastMobileKey = '';
    var mobileGapUntil = 0;
    var hoverPaused = false;
    var focusPaused = false;
    var heroVisible = true;
    /* True only while the hero still sits at the top of the page. Once the
       visitor scrolls into the phone exit the timed captions stop, so they
       never fight the scroll. Driven by a 1px sentinel, not a scroll
       listener. */
    var atRest = true;
    var timer = 0;

    function setOn(key, v) {
      var lb = labelEls.get(key);
      if (lb) lb.classList.toggle('on', v);
      var g = lineGroups.get(key);
      if (g) {
        g.querySelectorAll('path, circle').forEach(function (n) {
          n.classList.toggle('on', v);
        });
      }
      var pc = pieceEls.get(key);
      if (pc) pc.classList.toggle('lit', v);
      var dot = dotEls.get(key);
      if (dot) {
        dot.classList.toggle('on', v);
        dot.setAttribute('aria-pressed', v ? 'true' : 'false');
      }
    }

    function show(key, ms) {
      active.set(key, Date.now() + ms);
      setOn(key, true);
      var lb = labelEls.get(key);
      if (lb && capName && capDesc) {
        var b = lb.querySelector('b');
        var s = lb.querySelector('span');
        capName.textContent = b ? b.textContent : '';
        capDesc.textContent = s ? s.textContent : '';
      }
      if (capEl) capEl.classList.remove('cap-hide');
      var shown = sideOf(key);
      if (shown === 'L' || shown === 'R') {
        lastBySide[shown] = key;
        refreshMarker(shown);
      }
    }

    function hide(key) {
      active.delete(key);
      setOn(key, false);
      var sd = sideOf(key);
      if ((sd === 'L' || sd === 'R') && lastBySide[sd] === key) {
        var rep = '';
        active.forEach(function (exp, k) {
          if (!rep && sideOf(k) === sd) rep = k;
        });
        lastBySide[sd] = rep;
        refreshMarker(sd);
      }
    }

    /* Pin, evicting whoever holds the same slot. On mobile there is only
       ever one callout, so evict everything; taps hold 10s there, 9s here. */
    function pin(key) {
      var mobile = mobileQ.matches;
      if (mobile) {
        Array.from(active.keys()).forEach(function (k) {
          if (k !== key) hide(k);
        });
        /* Resume the fixed order from the facet just tapped. */
        var idx = PHONE_ORDER.indexOf(key);
        if (idx >= 0) phoneCursor = idx;
      } else {
        var slot = slotOf(key);
        Array.from(active.keys()).forEach(function (k) {
          if (k !== key && slotOf(k) === slot) hide(k);
        });
      }
      show(key, mobile ? 7000 : 9000);
    }

    function activate(key) {
      pin(key);
      if (key === 'next') {
        var contact = document.getElementById('contact');
        if (contact) {
          contact.scrollIntoView({ behavior: reduced ? 'auto' : 'smooth', block: 'start' });
        } else {
          window.location.hash = '#contact';
        }
      }
    }

    hitEls.forEach(function (el) {
      var key = el.dataset.facet;
      var wrap = pieceEls.get(key);
      el.addEventListener('mouseenter', function () {
        if (wrap) wrap.classList.add('hot');
        hoverPaused = true;
      });
      el.addEventListener('mouseleave', function () {
        if (wrap) wrap.classList.remove('hot');
        hoverPaused = false;
      });
      el.addEventListener('focus', function () {
        if (wrap) wrap.classList.add('hot');
        focusPaused = true;
      });
      el.addEventListener('blur', function () {
        if (wrap) wrap.classList.remove('hot');
        focusPaused = false;
      });
      el.addEventListener('click', function () {
        if (coarseQ.matches && wrap) {
          wrap.classList.add('pulse');
          window.setTimeout(function () {
            wrap.classList.remove('pulse');
          }, 120);
        }
        activate(key);
      });
      el.addEventListener('keydown', function (e) {
        if (e.key === 'Enter' && key !== 'next') {
          /* Links already activate natively on Enter; Space needs help. */
          e.preventDefault();
          activate(key);
        } else if (e.key === ' ') {
          e.preventDefault();
          activate(key);
        }
      });
    });

    dotEls.forEach(function (el, key) {
      el.addEventListener('click', function () {
        activate(key);
      });
    });

    function expire(now) {
      Array.from(active.keys()).forEach(function (k) {
        if (active.get(k) <= now) hide(k);
      });
    }

    /* Phone caption cycle (Chunk 3B3): strictly one callout at a time,
       walked in a fixed order so it reads as a tour of the logo rather
       than random flicker. Dwell comes from --phone-caption-dwell
       (reduced motion uses 6000ms and no crossfade). When one expires it
       fades out and the next starts only after the crossfade gap, so two
       never overlap. Taps pin and the cycle resumes from that facet. */
    var PHONE_ORDER = [
      'arrow',
      'core',
      'education',
      'commerce',
      'logistics',
      'automation',
      'cloud',
      'intelligence',
      'next',
    ];
    var phoneCursor = -1;
    function phoneDwell() {
      if (reduced) return 6000;
      var base = parseFloat(
        getComputedStyle(document.documentElement).getPropertyValue('--phone-caption-dwell'),
      );
      if (!isFinite(base) || !base) return 4200;
      /* Plus or minus 600ms so it does not feel mechanical. */
      return base + (Math.random() * 1200 - 600);
    }
    function nextInOrder() {
      phoneCursor = (phoneCursor + 1) % PHONE_ORDER.length;
      return PHONE_ORDER[phoneCursor];
    }
    function mobileTick(now) {
      var keys = Array.from(active.keys());
      if (keys.length > 1) {
        keys.sort(function (a, b) {
          return active.get(b) - active.get(a);
        });
        keys.slice(1).forEach(hide);
        keys = keys.slice(0, 1);
      }
      if (keys.length && active.get(keys[0]) <= now) {
        hide(keys[0]);
        keys = [];
        mobileGapUntil = now + 300;
        if (capEl) capEl.classList.add('cap-hide');
      }
      if (!keys.length && now >= mobileGapUntil) {
        var key = nextInOrder();
        if (!pieceEls.has(key)) return;
        lastMobileKey = key;
        show(key, phoneDwell());
      }
    }

    function tick() {
      if (hoverPaused || focusPaused || document.hidden || !heroVisible || !atRest) return;
      var now = Date.now();
      if (reduced) {
        expire(now);
        return;
      }
      if (mobileQ.matches) {
        mobileTick(now);
        return;
      }
      expire(now);
      if (active.size < target && Math.random() < 0.65) {
        var used = new Set(Array.from(active.keys()).map(slotOf));
        var order = Array.from(pieceEls.keys());
        var free = order.filter(function (k) {
          return !active.has(k) && !used.has(slotOf(k));
        });
        if (free.length) show(free[(Math.random() * free.length) | 0], 4000 + Math.random() * 5000);
      }
      if (Math.random() < 0.08) target = 2 + ((Math.random() * 3) | 0);
    }

    var EASE = 'cubic-bezier(.16,1,.3,1)';

    function assemble() {
      var ordered = Array.from(pieceEls.values()).sort(function (a, b) {
        return parseInt(a.dataset.order || '0', 10) - parseInt(b.dataset.order || '0', 10);
      });
      var flights = [];
      ordered.forEach(function (el, i) {
        el.style.opacity = '1';
        if (reduced) return;
        var ax = parseFloat(el.dataset.ax || '328');
        var ay = parseFloat(el.dataset.ay || '342');
        var ang = Math.atan2(ay - 342, ax - 328);
        var dist = 700 + Math.random() * 500;
        var rot = (Math.random() < 0.5 ? -1 : 1) * (30 + Math.random() * 60);
        try {
          var anim = el.animate(
            [
              {
                transform:
                  'translate(' +
                  Math.round(Math.cos(ang) * dist) +
                  'px,' +
                  Math.round(Math.sin(ang) * dist) +
                  'px) rotate(' +
                  Math.round(rot) +
                  'deg) scale(.55)',
                opacity: '0',
              },
              { opacity: '1', offset: 0.3 },
              { transform: 'none', opacity: '1' },
            ],
            {
              duration: 1500 + Math.random() * 400,
              delay: i * 90,
              easing: EASE,
              fill: 'backwards',
            },
          );
          if (anim && anim.finished) flights.push(anim.finished);
        } catch (err) {
          /* No Web Animations: the piece is already visible, skip it. */
        }
      });
      var done = function () {
        if (mark) mark.classList.add('done');
        if (reduced) {
          var fixed = (stage.dataset.fixed || '')
            .split(' ')
            .filter(function (k) {
              return pieceEls.has(k);
            });
          fixed.forEach(function (k) {
            show(k, Infinity);
          });
        } else {
          show('arrow', mobileQ.matches ? 7000 : 6000);
        }
        timer = window.setInterval(tick, 600);
      };
      if (flights.length) {
        Promise.all(flights).then(done, done);
      } else {
        done();
      }
    }

    if ('IntersectionObserver' in window) {
      var io = new IntersectionObserver(
        function (entries) {
          heroVisible = entries.some(function (e) {
            return e.isIntersecting;
          });
        },
        { threshold: 0 },
      );
      io.observe(stage);

      /* 1px sentinel at the very top of the track: it leaves the viewport
         as soon as the visitor scrolls down, which pauses the caption
         scheduler for the rest of the phone exit. */
      var sentinel = heroTrack && heroTrack.querySelector('.hero-sentinel');
      if (sentinel) {
        var sio = new IntersectionObserver(
          function (entries) {
            atRest = entries.some(function (e) {
              return e.isIntersecting;
            });
          },
          { threshold: 0 },
        );
        sio.observe(sentinel);
      }
    }

    /* Rail markers track label positions across resizes. */
    if ('ResizeObserver' in window && heroRoot) {
      var mro = new ResizeObserver(function () {
        refreshMarker('L');
        refreshMarker('R');
      });
      mro.observe(heroRoot);
    }

    assemble();

    /* Dev-only readout (?hero=debug). import.meta.env.DEV is replaced with
       false at build time, so this whole block is tree-shaken out of the
