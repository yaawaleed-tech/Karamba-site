<style>
  .hero-stage {
    position: relative;
    width: 100%;
    aspect-ratio: 1000 / 620;
    container-type: inline-size;
    /* Scroll-exit knob: final scale of "One system." so it finishes at
       about 88% of the stage width. At a 1200px stage the span measures
       about 290px (5.26em at 55.2px Fraunces 600); 0.88 x 1200 / 290 is
       3.64, rounded to 3.6. Tune by eye: raise it if the ending reads
       narrow, lower it if the span touches the stage edges. */
    --one-system-final-scale: 3.6;
  }

  .hero-mark {
    position: absolute;
    left: 33%;
    top: 16.94%;
    width: 34%;
    aspect-ratio: 656 / 684;
    transition: filter 0.8s ease;
    /* Paint above the growing headline (which comes later in the DOM) so
       scattering pieces stay on top; the filter already creates a
       stacking context, so sibling order is the only thing this changes. */
    z-index: 1;
  }
  /* Soft glow once the pieces have landed. Light: indigo shadow, no neon. */
  .hero-mark.done {
    filter: drop-shadow(0 18px 32px color-mix(in srgb, var(--color-primary) 30%, transparent));
  }
  /* Dark: cyan-teal glow. The data-theme ancestor is :global because it lives
     on <html>, which Astro never scopes; scoping it would match nothing. */
  :global([data-theme='dark']) .hero-mark.done {
    filter: drop-shadow(0 0 44px color-mix(in srgb, var(--color-accent) 45%, transparent));
  }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .hero-mark.done {
      filter: drop-shadow(0 0 44px color-mix(in srgb, var(--color-accent) 45%, transparent));
    }
  }

  /* Hidden until the script starts the fly-in; the noscript style below is
     the no-JavaScript fallback. */
  .pc {
    position: absolute;
    opacity: 0;
  }
  .pc img {
    display: block;
    width: 100%;
    height: 100%;
    user-select: none;
    transition: transform 0.25s ease, filter 0.25s ease;
  }
  .pc.lit img {
    filter: brightness(1.1);
  }
  /* Hover lift and brighten only where hovering is real: on touch a tap
     would otherwise leave the hot state stuck on the piece. Taps use the
     pinned lit state instead. Keyboard focus still adds .hot for its lift
     on hover-capable devices. */
  @media (hover: hover) and (pointer: fine) {
    .pc.hot img {
      transform: translate(var(--hx), var(--hy));
      filter: brightness(1.18) saturate(1.1);
    }
  }

  .hit {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    -webkit-tap-highlight-color: transparent;
