    }
    @media (prefers-color-scheme: dark) {
      :global(:root:not([data-theme='light'])) .hero-mark::before {
        background: radial-gradient(
          closest-side,
          color-mix(in srgb, var(--color-accent-strong) 38%, transparent),
          transparent 72%
