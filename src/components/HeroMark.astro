        animation-timeline: --hero;
        animation-range: contain 0% contain 100%;
      }
      @keyframes phone-mark-zoom {
        0%, 12% { transform: scale(1); }
        55%, 100% { transform: scale(1.25); }
      }
      .pc {
        animation: phone-piece-out linear both;
        animation-timeline: --hero;
        animation-range: contain 0% contain 100%;
      }
      @keyframes phone-piece-out {
