  /* No outline on the hit areas: browsers draw SVG outlines as the
     bounding box, so clicking a piece showed a stray rectangle. Keyboard
     focus instead gets a stroke that follows the piece's real shape. */
  .hit polygon,
  .hit a {
    outline: none;
  }
  .hit polygon:focus-visible,
  .hit a:focus-visible polygon {
    stroke: var(--color-accent-strong);
    stroke-width: 3;
    stroke-linejoin: round;
  }

  .lines {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    overflow: visible;
  }
  .lines path {
    fill: none;
    stroke: var(--color-accent-strong);
    stroke-width: 1.6;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    transition: stroke-dashoffset 0.8s ease;
  }
  .lines path.on {
    stroke-dashoffset: 0;
  }
  /* Thinner in dark mode, where the glow already carries the line. */
  :global([data-theme='dark']) .lines path {
    stroke-width: 1.3;
  }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .lines path {
      stroke-width: 1.3;
    }
  }
  .lines circle {
    fill: var(--color-accent-strong);
    opacity: 0;
    transition: opacity 0.5s ease;
  }
  .lines circle.on {
    opacity: 1;
  }

  /* Labels sit beside their slot dot: L labels extend left (right-aligned),
     R labels extend right. translateY lifts the block so the dot meets the
     name line, and the 120-unit slot spacing keeps neighbours apart. */
  .lb {
    position: absolute;
    width: 21%;
    opacity: 0;
    transition: opacity 0.7s ease;
    pointer-events: none;
