      /* "One system." rises to the middle of the pinned view, moves from
         the right half of the headline line to the horizontal centre
         (both offsets measured in JS), and grows to the measured scale.
         Colour settles by 60% and it never fades. */
      .hl-b {
        animation: phone-one-out linear both;
        animation-timeline: --hero;
        animation-range: contain 15% contain 100%;
      }
      @keyframes phone-one-out {
        0% {
          transform: translate(0, 0) scale(1);
          color: var(--color-text);
        }
        60% { color: var(--color-accent-strong); }
        100% {
