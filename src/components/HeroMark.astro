      .hero-mark::before {
        animation: phone-glow-out linear both;
        animation-timeline: --hero;
        animation-range: contain 0% contain 100%;
      }
      @keyframes phone-glow-out {
        0%, 60% { opacity: 1; }
        100% { opacity: 0; }
      }
    }
  }
</style>
