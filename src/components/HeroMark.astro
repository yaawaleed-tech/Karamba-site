    transform: translate(-100%, -0.75em);
    text-align: right;
    padding-right: 14px;
  }
  .lb.R {
    transform: translate(0, -0.75em);
    padding-left: 14px;
  }
  .lb b {
    display: block;
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 11px;
    font-size: clamp(8px, 1.05cqw, 13px);
