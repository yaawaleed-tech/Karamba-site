    opacity: 1;
    transform: none;
  }
  .hero-title {
    margin: 0;
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 28px;
    font-size: clamp(28px, 4.6cqw, 56px);
    line-height: 1.1;
    color: var(--color-text);
  }
