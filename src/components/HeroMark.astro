     shell, since .hero-copy itself is no longer a sibling of .hero-mark. */
  .hero-copy {
    position: absolute;
    left: 4%;
    right: 4%;
    top: 77%;
    bottom: 1%;
    text-align: center;
    opacity: 0;
    transform: translateY(12px);
    transition: opacity 0.8s ease, transform 0.8s ease;
  }
