---
// Replace with your real Web3Forms access key from web3forms.com
const WEB3FORMS_ACCESS_KEY = import.meta.env.PUBLIC_WEB3FORMS_KEY;
---

<section id="contact" class="mx-auto max-w-6xl px-6 py-20">
	<div class="grid gap-12 lg:grid-cols-5 lg:gap-16">
		<!-- Info -->
		<div class="lg:col-span-2">
			<h2 class="font-heading text-3xl font-bold sm:text-4xl" style="color: var(--color-text);">
				Let's Talk
			</h2>
			<p class="mt-3 text-lg" style="color: var(--color-text-muted);">
				Tell us what you're trying to build. We reply within 24 hours.
			</p>

			<div class="mt-8 space-y-4">
				<a
					href="https://wa.me/2347081258889"
					target="_blank"
					rel="noopener noreferrer"
					class="flex items-center gap-3 text-sm font-medium transition-opacity hover:opacity-70"
					style="color: var(--color-text);"
				>
					<span class="flex h-10 w-10 flex-none items-center justify-center rounded-full" style="background-color: var(--color-bg-subtle);">
						<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="h-4.5 w-4.5 fill-current" style="color: var(--color-primary);">
							<path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.48 1.32 4.99L2 22l5.25-1.38a9.9 9.9 0 0 0 4.79 1.22h.01c5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.86 9.86 0 0 0 12.04 2z"/>
						</svg>
					</span>
					+234 708 125 8889
				</a>
				<a
					href="mailto:abdullahi.haroon.tech@gmail.com"
					class="flex items-center gap-3 text-sm font-medium transition-opacity hover:opacity-70"
					style="color: var(--color-text);"
				>
					<span class="flex h-10 w-10 flex-none items-center justify-center rounded-full" style="background-color: var(--color-bg-subtle);">
						<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="h-4.5 w-4.5" style="color: var(--color-primary);">
							<path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75"/>
						</svg>
					</span>
					abdullahi.haroon.tech@gmail.com
				</a>
				<a
					href="https://github.com/yaawaleed-tech"
					target="_blank"
					rel="noopener noreferrer"
					class="flex items-center gap-3 text-sm font-medium transition-opacity hover:opacity-70"
					style="color: var(--color-text);"
				>
					<span class="flex h-10 w-10 flex-none items-center justify-center rounded-full" style="background-color: var(--color-bg-subtle);">
						<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="h-4.5 w-4.5 fill-current" style="color: var(--color-primary);">
							<path d="M12 2C6.48 2 2 6.58 2 12.17c0 4.47 2.87 8.26 6.84 9.6.5.1.68-.22.68-.48 0-.24-.01-.87-.01-1.7-2.78.62-3.37-1.36-3.37-1.36-.45-1.18-1.11-1.49-1.11-1.49-.91-.63.07-.62.07-.62 1 .07 1.53 1.05 1.53 1.05.89 1.56 2.34 1.11 2.91.85.09-.66.35-1.11.63-1.37-2.22-.26-4.56-1.14-4.56-5.06 0-1.12.39-2.03 1.03-2.75-.1-.26-.45-1.3.1-2.71 0 0 .84-.28 2.75 1.05a9.3 9.3 0 015 0c1.91-1.33 2.75-1.05 2.75-1.05.55 1.41.2 2.45.1 2.71.64.72 1.03 1.63 1.03 2.75 0 3.93-2.34 4.79-4.57 5.05.36.32.68.94.68 1.9 0 1.37-.01 2.48-.01 2.81 0 .27.18.59.69.48A10.02 10.02 0 0022 12.17C22 6.58 17.52 2 12 2z"/>
						</svg>
					</span>
					GitHub — yaawaleed-tech
				</a>
			</div>

			<p
				class="mt-8 inline-flex items-center gap-2 rounded-full px-3 py-1.5 text-xs font-semibold"
				style="background-color: var(--color-accent); color: var(--color-accent-text);"
			>
				We reply within 24 hours
			</p>
		</div>

		<!-- Form -->
		<div class="lg:col-span-3">
			<form id="contact-form" class="space-y-5 rounded-2xl p-7" style="background-color: var(--color-card-bg); border: 1px solid var(--color-border);">
				<input type="hidden" name="access_key" value={WEB3FORMS_ACCESS_KEY} />
				<input type="hidden" name="subject" value="New inquiry from karambatechnologies.com" />
				<!-- Honeypot spam trap, hidden from real visitors -->
				<input type="checkbox" name="botcheck" class="hidden" style="display: none;" />

				<div class="grid gap-5 sm:grid-cols-2">
					<div>
						<label for="name" class="text-sm font-medium" style="color: var(--color-text);">Your Name</label>
						<input
							type="text" id="name" name="name" required
							class="mt-1.5 w-full rounded-lg px-4 py-2.5 text-sm outline-none"
							style="background-color: var(--color-bg); border: 1px solid var(--color-border); color: var(--color-text);"
						/>
					</div>
					<div>
						<label for="email" class="text-sm font-medium" style="color: var(--color-text);">Your Email</label>
						<input
							type="email" id="email" name="email" required
							class="mt-1.5 w-full rounded-lg px-4 py-2.5 text-sm outline-none"
							style="background-color: var(--color-bg); border: 1px solid var(--color-border); color: var(--color-text);"
						/>
					</div>
				</div>

				<div>
					<label for="message" class="text-sm font-medium" style="color: var(--color-text);">What are you trying to build?</label>
					<textarea
						id="message" name="message" rows="5" required
						class="mt-1.5 w-full resize-none rounded-lg px-4 py-2.5 text-sm outline-none"
						style="background-color: var(--color-bg); border: 1px solid var(--color-border); color: var(--color-text);"
					></textarea>
				</div>

				<button
					type="submit"
					id="submit-btn"
					class="w-full rounded-full px-7 py-3.5 text-sm font-semibold transition-transform hover:scale-[1.02] disabled:opacity-60"
					style="background-color: var(--color-primary); color: var(--color-primary-text);"
				>
					Send Message
				</button>

				<p id="form-status" class="hidden text-center text-sm" role="status"></p>
			</form>
		</div>
	</div>
</section>

<script is:inline>
	(function () {
		const form = document.getElementById('contact-form');
		const btn = document.getElementById('submit-btn');
		const status = document.getElementById('form-status');

		form.addEventListener('submit', async function (e) {
			e.preventDefault();
			btn.disabled = true;
			btn.textContent = 'Sending...';
			status.classList.add('hidden');

			try {
				const res = await fetch('https://api.web3forms.com/submit', {
					method: 'POST',
					headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
					body: JSON.stringify(Object.fromEntries(new FormData(form))),
				});
				const data = await res.json();

				if (data.success) {
					status.textContent = "Thanks — we've received your message and will reply within 24 hours.";
					status.style.color = 'var(--color-primary)';
					form.reset();
				} else {
					throw new Error(data.message || 'Submission failed');
				}
			} catch (err) {
				status.textContent = 'Something went wrong. Please try WhatsApp or email us directly instead.';
				status.style.color = '#e05252';
			} finally {
				status.classList.remove('hidden');
				btn.disabled = false;
				btn.textContent = 'Send Message';
			}
		});
	})();
</script>