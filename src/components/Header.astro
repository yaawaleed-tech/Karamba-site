---
import { Image } from 'astro:assets';
import logoLight from '../assets/brand/logo-full.png';
import logoDark from '../assets/brand/logo-full-dark.png';
import ThemeToggle from './ThemeToggle.astro';
import manifest from '../assets/brand/karamba-pieces/manifest.json';
import { NAV_MENUS, PRIMARY_ACTION, menuForPath } from '../data/nav';

interface ManifestPiece {
  k: string;
  file: string;
  x: number;
  y: number;
  w: number;
  h: number;
}

/* Unprocessed file URLs for the mini logo, same pattern as the hero:
   byte-identical files, never re-encoded. */
const pieceUrls = import.meta.glob(
  '../assets/brand/karamba-pieces/*.webp',
  { query: '?url', import: 'default', eager: true },
) as Record<string, string>;
function pieceUrl(file: string): string {
  const hit = Object.entries(pieceUrls).find(([path]) => path.endsWith('/' + file));
  return hit ? hit[1] : '';
}

const pieces = manifest.pieces as ManifestPiece[];
const pct = (v: number, base: number) => `${((v / base) * 100).toFixed(3)}%`;
const current = menuForPath(Astro.url.pathname);
---

<header id="site-header" class="sticky top-0 z-50 border-b" style="border-color: var(--color-border);">
	<div class="header-glow"></div>

	<div id="header-inner" class="relative mx-auto flex max-w-6xl items-center justify-between px-6 transition-all duration-300">
		<a href="/" class="relative z-10 flex items-center" aria-label="Karamba Technologies, home">
			<Image src={logoLight} alt="Karamba Technologies" id="logo-light" class="header-logo h-9 w-auto transition-all duration-300" widths={[200, 400]} sizes="200px" />
			<Image src={logoDark} alt="Karamba Technologies" id="logo-dark" class="header-logo hidden h-9 w-auto transition-all duration-300" widths={[200, 400]} sizes="200px" />
		</a>

		<nav id="desktop-nav" aria-label="Primary" class="relative hidden items-center gap-1 md:flex">
			<span id="nav-underline" class="pointer-events-none absolute rounded-full transition-all duration-300 ease-out" style="background-color: var(--color-bg-subtle); height: 34px; opacity: 0;"></span>
			{NAV_MENUS.map((menu) => (
				<a
					href={menu.hubHref}
					class="nav-link relative z-10 rounded-full px-4 py-2 text-sm font-medium transition-colors"
					style={current?.key === menu.key ? 'color: var(--color-accent);' : 'color: var(--color-text);'}
					data-menu={menu.key}
					aria-expanded="false"
					aria-controls="menu-panel"
					aria-current={current?.key === menu.key ? 'page' : undefined}
				>
					{menu.label}
				</a>
			))}
		</nav>

		<div class="relative z-10 flex items-center gap-3">
			<ThemeToggle />
			<a href={PRIMARY_ACTION.href} class="cta-shimmer hidden rounded-full px-5 py-2.5 text-sm font-semibold sm:inline-block" style="background-color: var(--color-primary); color: var(--color-primary-text);">
				<span>{PRIMARY_ACTION.label}</span>
			</a>

			<button id="menu-toggle" type="button" aria-label="Open menu" aria-expanded="false" class="inline-flex h-10 w-10 items-center justify-center rounded-full border transition-colors md:hidden" style="border-color: var(--color-border); background-color: var(--color-bg-subtle);">
				<svg id="icon-burger" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" class="h-5 w-5" style="color: var(--color-text);">
					<path d="M4 6h16M4 12h16M4 18h16"></path>
				</svg>
				<svg id="icon-close" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" class="hidden h-5 w-5" style="color: var(--color-text);">
					<path d="M6 6l12 12M18 6L6 18"></path>
				</svg>
			</button>
		</div>
	</div>

	<!-- Shared dropdown card. One panel, one menu's content visible at a
	     time; every card is server-rendered so all links exist with or
	     without JavaScript. -->
	<div id="menu-panel" class="menu-panel" hidden>
		{NAV_MENUS.map((menu) => (
			<div class="menu-card" data-menu-card={menu.key} hidden>
				<div class="menu-intro-col">
					<div class="menu-intro">
						<p class="menu-intro-text">{menu.introText}</p>
						<a href={menu.hubHref} class="menu-hub-btn">{menu.introButtonText}</a>
					</div>
					<div class="menu-logo" aria-hidden="true">
						{pieces.map((p) => (
							<img
								src={pieceUrl(p.file)}
								alt=""
								loading="lazy"
								draggable="false"
								data-facet={p.k}
								style={`left:${pct(p.x, 656)};top:${pct(p.y, 684)};width:${pct(p.w, 656)};height:${pct(p.h, 684)}`}
							/>
						))}
					</div>
				</div>
				<ul class="menu-items">
					{menu.items.map((item) => (
						<li>
							<a href={item.href} class="menu-item" data-facet={item.facet}>
								<span class="menu-item-name">{item.name}</span>
								<span class="menu-item-desc">{item.description}</span>
								{item.status && <span class="menu-item-status">{item.status}</span>}
							</a>
						</li>
					))}
				</ul>
			</div>
		))}
	</div>

	<div id="mobile-menu" class="hidden border-t md:hidden" style="border-color: var(--color-border); background-color: var(--color-bg);">
		<nav aria-label="Mobile" class="flex flex-col gap-1 px-6 py-4">
			{NAV_MENUS.map((menu) => (
				<div class="mobile-group">
					<button
						type="button"
						class="mobile-group-btn"
						aria-expanded="false"
						aria-controls={`mobile-panel-${menu.key}`}
					>
						<span>{menu.label}</span>
						<span class="mobile-chev" aria-hidden="true"></span>
					</button>
					<div id={`mobile-panel-${menu.key}`} class="mobile-group-panel" hidden>
						<a href={menu.hubHref} class="mobile-nav-link mobile-hub-link">{menu.introButtonText}</a>
						{menu.items.map((item) => (
							<a href={item.href} class="mobile-nav-link mobile-item-link">
								<span class="mobile-item-name">{item.name}</span>
								<span class="mobile-item-desc">{item.description}</span>
								{item.status && <span class="mobile-item-status">{item.status}</span>}
							</a>
						))}
					</div>
				</div>
			))}
			<a href={PRIMARY_ACTION.href} class="cta-shimmer mobile-nav-link mt-2 rounded-full px-5 py-3 text-center text-sm font-semibold" style="background-color: var(--color-primary); color: var(--color-primary-text);">
				<span>{PRIMARY_ACTION.label}</span>
			</a>
		</nav>
	</div>
</header>

<style>
	#site-header {
		background-color: color-mix(in srgb, var(--color-bg) 70%, transparent);
		backdrop-filter: blur(14px);
		-webkit-backdrop-filter: blur(14px);
	}
	#site-header.is-scrolled {
		background-color: color-mix(in srgb, var(--color-bg) 92%, transparent);
	}
	#header-inner {
		padding-top: 1.1rem;
		padding-bottom: 1.1rem;
	}
	#site-header.is-scrolled #header-inner {
		padding-top: 0.55rem;
		padding-bottom: 0.55rem;
	}
	#site-header.is-scrolled .header-logo {
		height: 1.85rem;
	}

	/* Logo settle bounce. The height change above is a plain linear transition,
	   which makes the shrink read as mechanical. This one-shot scale is layered
	   on the same crossing so the logo dips just under its compressed size and
	   springs back up to rest, which is what sells it as a settle. The class is
	   added by the scroll listener only on the transition INTO the compressed
	   state and removed afterwards, so it cannot re-fire on every scroll tick.
	   Same overshoot curve as the theme toggle, for consistency. */
	#site-header .header-logo.logo-settle {
		animation: logo-settle-bounce 0.45s cubic-bezier(0.34, 1.56, 0.64, 1);
	}
	@keyframes logo-settle-bounce {
		0% { transform: scale(1); }
		40% { transform: scale(0.92); }
		75% { transform: scale(1.05); }
		100% { transform: scale(1); }
	}

	/* Cursor-follow glow.
	   Inherently mouse-only: it tracks pointer position via the mousemove
	   handler below and touch devices have no cursor to track. The trigger is
	   scoped to genuine hover support, and on touch the layer is removed
	   outright - a tap can synthesise a mouseover with no mouselever to follow
	   it, which would otherwise leave the glow stuck on. */
	.header-glow {
		position: absolute;
		inset: 0;
		pointer-events: none;
		opacity: 0;
		transition: opacity 0.4s ease;
		background: radial-gradient(
			320px circle at var(--mx, 50%) var(--my, 0%),
			color-mix(in srgb, var(--color-primary) 16%, transparent),
			transparent 70%
		);
	}
	@media (hover: hover) and (pointer: fine) {
		#site-header:hover .header-glow {
			opacity: 1;
		}
	}
	@media (hover: none) {
		.header-glow { display: none; }
	}

	/* Nav link dimming. The sliding underline below is driven by
	   mouseenter/mouseleave, so it is hidden on touch: a tap fires
	   mouseenter but never mouseleave and the underline would stick on. */
	@media (hover: hover) and (pointer: fine) {
		.nav-link:hover {
			opacity: 0.85;
		}
	}

	/* Visible keyboard focus everywhere in the header. */
	#site-header :focus-visible {
		outline: 2px solid var(--color-accent-strong);
		outline-offset: 2px;
	}

	/* CTA shimmer sweep */
	.cta-shimmer {
		position: relative;
		overflow: hidden;
		transition: transform 0.25s ease, box-shadow 0.25s ease;
	}
	.cta-shimmer::after {
		content: '';
		position: absolute;
		top: 0;
		left: -60%;
		width: 40%;
		height: 100%;
		background: linear-gradient(120deg, transparent, rgba(255,255,255,0.45), transparent);
		transform: skewX(-20deg);
		transition: left 0.6s ease;
	}
	/* Gated on real hover support so a tap cannot leave the button stuck in
	   its hover state. */
	@media (hover: hover) and (pointer: fine) {
		.cta-shimmer:hover {
			transform: scale(1.05);
			box-shadow: 0 8px 24px -6px color-mix(in srgb, var(--color-primary) 55%, transparent);
		}
		.cta-shimmer:hover::after {
			left: 130%;
		}
	}

	/* ---- Touch equivalents ---------------------------------------------
	   Touch has no hover state, so each hover-only effect above needs
	   something that still responds to a finger. */
	@media (hover: none) {
		/* The shimmer is decorative and needs no interaction to read, so on
		   touch it sweeps itself once every 5s rather than waiting on a hover
		   that will never arrive. Mouse users keep the hover-only version. */
		.cta-shimmer::after {
			transition: none;
			animation: cta-shimmer-sweep 5s ease-in-out infinite;
		}
		/* :active fires on tap-down and clears on tap-up, so it gives
		   immediate press feedback and cannot stick the way :hover can. */
		.cta-shimmer:active { transform: scale(0.96); }
		.nav-link:active { opacity: 0.6; }
		#nav-underline { display: none; }
	}
	/* Parked off the left edge, one sweep, then loop. Both 0% and 100% sit
	   outside the button, so the wrap back round is invisible. */
	@keyframes cta-shimmer-sweep {
		0%, 76% { left: -60%; }
		100% { left: 130%; }
	}

	/* ---- Dropdown card --------------------------------------------------
	   One shared fixed panel; a single menu card shows at a time. Hidden
	   uses the attribute (works with no JavaScript); opening removes it
	   and fades the panel in. */
	.menu-panel {
		position: fixed;
		left: 50%;
		transform: translateX(-50%) translateY(-8px);
		width: min(760px, calc(100vw - 2rem));
		z-index: 60;
		background-color: var(--color-card-bg);
		border: 1px solid var(--color-border);
		border-radius: 20px;
		box-shadow: 0 24px 60px -12px color-mix(in srgb, var(--color-text) 25%, transparent);
		visibility: hidden;
		opacity: 0;
		transition: opacity 0.2s ease, transform 0.2s ease, visibility 0s linear 0.2s;
	}
	.menu-panel.is-open {
		visibility: visible;
		opacity: 1;
		transform: translateX(-50%) translateY(0);
		transition: opacity 0.2s ease, transform 0.2s ease;
	}
	.menu-panel[hidden] {
		display: none;
	}
	@media (max-width: 767.98px) {
		.menu-panel {
			display: none;
		}
	}
	.menu-card {
		display: grid;
		grid-template-columns: 250px 1fr;
		gap: 1.5rem;
		padding: 1.25rem;
	}
	.menu-card[hidden] {
		display: none;
	}
	.menu-intro {
		background-color: var(--color-soft);
		border-radius: 14px;
		padding: 1.25rem;
	}
	.menu-intro-text {
		font-family: var(--font-heading);
		font-size: 1.05rem;
		line-height: 1.5;
		color: var(--color-text);
		margin: 0 0 1rem;
	}
	.menu-hub-btn {
		display: inline-block;
		border-radius: 999px;
		padding: 0.55rem 1.2rem;
		font-size: 0.8rem;
		font-weight: 600;
		text-decoration: none;
		background-color: var(--color-primary);
		color: var(--color-primary-text);
	}
	.menu-logo {
		position: relative;
		width: 120px;
		aspect-ratio: 656 / 684;
		margin-top: 1rem;
	}
	.menu-logo img {
		position: absolute;
		opacity: 0.22;
		transition: opacity 0.25s ease, filter 0.25s ease;
	}
	.menu-logo img.lit {
		opacity: 1;
		filter: brightness(1.25);
	}
	.menu-items {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
		align-self: start;
	}
	.menu-item {
		display: block;
		border-radius: 12px;
		padding: 0.65rem 0.8rem;
		text-decoration: none;
		transition: background-color 0.2s ease;
	}
	.menu-item:hover {
		background-color: var(--color-bg-subtle);
	}
	.menu-item-name {
		display: block;
		font-family: var(--font-heading);
		font-weight: 600;
		font-size: 0.95rem;
		color: var(--color-text);
	}
	.menu-item-desc {
		display: block;
		font-size: 0.82rem;
		margin-top: 0.15rem;
		color: var(--color-text-muted);
	}
	.menu-item-status {
		display: block;
		font-size: 0.68rem;
		font-weight: 600;
		letter-spacing: 0.18em;
		text-transform: uppercase;
		margin-top: 0.25rem;
		color: var(--color-accent-strong);
	}

	/* ---- Mobile sheet: accordion rows ------------------------------------
	   Same open/close mechanics as before; only the link list changed. */
	.mobile-group-btn {
		display: flex;
		align-items: center;
		justify-content: space-between;
		width: 100%;
		min-height: 48px;
		padding: 12px;
		border: 0;
		border-radius: 12px;
		background: transparent;
		font-size: 1rem;
		font-weight: 600;
		color: var(--color-text);
		cursor: pointer;
	}
	.mobile-chev {
		flex: none;
		width: 10px;
		height: 10px;
		border-left: 2px solid currentColor;
		border-bottom: 2px solid currentColor;
		transform: rotate(-45deg);
		transition: transform 0.25s ease;
	}
	.mobile-group-btn[aria-expanded="true"] .mobile-chev {
		transform: rotate(135deg);
	}
	.mobile-group-panel[hidden] {
		display: none;
	}
	.mobile-group-panel .mobile-nav-link {
		display: block;
		border-radius: 10px;
		padding: 10px 12px 10px 16px;
		text-decoration: none;
	}
	.mobile-hub-link {
		font-weight: 600;
		color: var(--color-text);
	}
	.mobile-item-name {
		display: block;
		font-size: 1rem;
		font-weight: 600;
		color: var(--color-text);
	}
	.mobile-item-desc {
		display: block;
		font-size: 0.85rem;
		margin-top: 0.15rem;
		color: var(--color-text-muted);
	}
	.mobile-item-status {
		display: block;
		font-size: 0.68rem;
		font-weight: 600;
		letter-spacing: 0.18em;
		text-transform: uppercase;
		margin-top: 0.25rem;
		color: var(--color-accent-strong);
	}

	/* ---- Mobile menu open/close -----------------------------------------
	   `hidden` (display: none) cannot be transitioned, so the panel is
	   collapsed with max-height/opacity/translateY and the JS toggles
	   `hidden` either side of the transition. */
	#mobile-menu {
		max-height: 0;
		opacity: 0;
		transform: translateY(-8px);
		overflow: hidden;
		transition:
			max-height 0.35s ease,
			opacity 0.3s ease,
			transform 0.35s ease;
	}
	#mobile-menu.is-open {
		max-height: 80vh;
		opacity: 1;
		transform: translateY(0);
		/* Capped to the viewport so a short landscape screen scrolls the
		   panel instead of hiding the last link off-screen. */
		overflow-y: auto;
	}

	@media (prefers-reduced-motion: reduce) {
		/* Nothing auto-plays, and menus appear/disappear at once. */
		.cta-shimmer::after {
			animation: none;
		}
		#mobile-menu {
			transition: none;
			transform: none;
		}
		#mobile-menu.is-open {
			max-height: 80vh;
			overflow-y: auto;
		}
		.menu-panel,
		.menu-logo img,
		.mobile-chev {
			transition: none;
		}
		/* The header still compresses, it just does not bounce. */
		#site-header .header-logo.logo-settle {
			animation: none;
		}
	}
</style>

<script is:inline>
	(function () {
		function syncLogos() {
			const isDark = document.documentElement.getAttribute('data-theme') === 'dark';
			const light = document.getElementById('logo-light');
			const dark = document.getElementById('logo-dark');
			if (light && dark) {
				light.classList.toggle('hidden', isDark);
				dark.classList.toggle('hidden', !isDark);
			}
		}
		syncLogos();
		new MutationObserver(syncLogos).observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });
	})();
</script>

<script is:inline>
	// Cursor-follow glow
	(function () {
		const header = document.getElementById('site-header');
		header.addEventListener('mousemove', (e) => {
			const rect = header.getBoundingClientRect();
			const x = ((e.clientX - rect.left) / rect.width) * 100;
			const y = ((e.clientY - rect.top) / rect.height) * 100;
			header.style.setProperty('--mx', `${x}%`);
			header.style.setProperty('--my', `${y}%`);
		});
	})();
</script>

<script is:inline>
	// Scroll compression
	(function () {
		const header = document.getElementById('site-header');
		const logos = header.querySelectorAll('.header-logo');
		const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
		const SETTLE_MS = 450; // matches logo-settle-bounce in the stylesheet
		let settleTimer = null;

		// A one-shot class animation will not replay while the class is simply
		// left in place, so it is taken off after the run and forced back through
		// a reflow on the next crossing.
		function settle() {
			clearTimeout(settleTimer);
			logos.forEach((logo) => {
				logo.classList.remove('logo-settle');
				void logo.offsetWidth;
				logo.classList.add('logo-settle');
			});
			settleTimer = setTimeout(() => {
				logos.forEach((logo) => logo.classList.remove('logo-settle'));
			}, SETTLE_MS);
		}

		function onScroll() {
			const scrolled = window.scrollY > 24;
			// Only act on the crossing. A bare toggle runs on every scroll tick,
			// which would restart the bounce continuously and never let it land.
			if (scrolled === header.classList.contains('is-scrolled')) return;
			header.classList.toggle('is-scrolled', scrolled);
			// Scrolling back up just uses the existing plain transition to grow
			// the logo again - a second bounce in reverse reads as jitter.
			if (scrolled && !reduced.matches) settle();
		}
		onScroll();
		window.addEventListener('scroll', onScroll, { passive: true });
	})();
</script>

<script is:inline>
	// Sliding underline that follows hovered nav link
	(function () {
		const nav = document.getElementById('desktop-nav');
		const underline = document.getElementById('nav-underline');
		if (!nav || !underline) return;
		// Mouse-driven only. On touch a tap fires mouseenter with no
		// mouseleave to follow, so the underline would latch on; bail out
		// instead of binding (the stylesheet hides it there too).
		if (!window.matchMedia('(hover: hover)').matches) return;
		const links = nav.querySelectorAll('.nav-link');

		function moveTo(el) {
			const navRect = nav.getBoundingClientRect();
			const r = el.getBoundingClientRect();
			underline.style.width = `${r.width}px`;
			underline.style.left = `${r.left - navRect.left}px`;
			underline.style.opacity = '1';
		}

		links.forEach((link) => {
			link.addEventListener('mouseenter', () => moveTo(link));
		});
		nav.addEventListener('mouseleave', () => {
			underline.style.opacity = '0';
		});
	})();
</script>

<script is:inline>
	// Dropdown cards: one shared panel, one menu visible at a time.
	(function () {
		const header = document.getElementById('site-header');
		const nav = document.getElementById('desktop-nav');
		const panel = document.getElementById('menu-panel');
		if (!header || !nav || !panel) return;
		const fine = window.matchMedia('(hover: hover) and (pointer: fine)');
		const wide = window.matchMedia('(min-width: 768px)');
		const items = Array.from(nav.querySelectorAll('.nav-link'));
		const cards = Array.from(panel.querySelectorAll('.menu-card'));
		let openKey = null;
		let openTimer = null;
		let closeTimer = null;
		let hideTimer = null;

		function cardFor(key) {
			return cards.find((card) => card.dataset.menuCard === key);
		}

		function lightFacet(card, facet) {
			if (!card) return;
			card.querySelectorAll('.menu-logo img').forEach((img) => {
				img.classList.toggle('lit', img.dataset.facet === facet);
			});
		}

		function position() {
			const r = header.getBoundingClientRect();
			panel.style.top = `${r.bottom + 8}px`;
		}

		function setExpanded(key, open) {
			const link = items.find((item) => item.dataset.menu === key);
			if (link) link.setAttribute('aria-expanded', String(open));
		}

		function showPanel() {
			panel.hidden = false;
			void panel.offsetWidth;
			panel.classList.add('is-open');
		}

		function hidePanel() {
			panel.classList.remove('is-open');
			clearTimeout(hideTimer);
			hideTimer = setTimeout(() => {
				if (!panel.classList.contains('is-open')) panel.hidden = true;
			}, 220);
		}

		function openMenu(key) {
			if (openKey === key) return;
			if (openKey) {
				cardFor(openKey).hidden = true;
				setExpanded(openKey, false);
			}
			const card = cardFor(key);
			if (!card) return;
			card.hidden = false;
			showPanel();
			position();
			setExpanded(key, true);
			openKey = key;
			const first = card.querySelector('.menu-items a');
			lightFacet(card, first ? first.dataset.facet : '');
		}

		function closeMenu() {
			if (openKey === null) return;
			cardFor(openKey).hidden = true;
			setExpanded(openKey, false);
			openKey = null;
			hidePanel();
		}

		function desktop() {
			return wide.matches;
		}

		items.forEach((link, i) => {
			const key = link.dataset.menu;
			link.addEventListener('mouseenter', () => {
				if (!fine.matches || !desktop()) return;
				clearTimeout(closeTimer);
				clearTimeout(openTimer);
				openTimer = setTimeout(() => openMenu(key), 120);
			});
			link.addEventListener('mouseleave', () => {
				if (!fine.matches || !desktop()) return;
				clearTimeout(openTimer);
				clearTimeout(closeTimer);
				closeTimer = setTimeout(() => {
					if (!panel.matches(':hover')) closeMenu();
				}, 180);
			});
			link.addEventListener('click', (e) => {
				if (e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
				e.preventDefault();
				if (!desktop()) return;
				if (openKey === key) closeMenu();
				else openMenu(key);
			});
			link.addEventListener('keydown', (e) => {
				if (e.key === 'Enter' || e.key === ' ') {
					e.preventDefault();
					if (!desktop()) return;
					if (openKey === key) closeMenu();
					else openMenu(key);
				} else if (e.key === 'ArrowRight' || e.key === 'ArrowLeft') {
					e.preventDefault();
					const dir = e.key === 'ArrowRight' ? 1 : -1;
					items[(i + dir + items.length) % items.length].focus();
				} else if (e.key === 'Escape') {
					closeMenu();
					link.focus();
				}
			});
		});

		panel.addEventListener('mouseenter', () => {
			clearTimeout(closeTimer);
		});
		panel.addEventListener('mouseleave', () => {
			if (!fine.matches || !desktop()) return;
			clearTimeout(closeTimer);
			closeTimer = setTimeout(closeMenu, 180);
		});
		panel.addEventListener('keydown', (e) => {
			if (e.key === 'Escape' && openKey) {
				const link = items.find((item) => item.dataset.menu === openKey);
				closeMenu();
				if (link) link.focus();
			}
		});

		// Facet lighting follows the hovered or focused item; the resting
		// state is the first item of the open card.
		panel.querySelectorAll('.menu-card').forEach((card) => {
			const links = Array.from(card.querySelectorAll('.menu-items a'));
			const first = links.length ? links[0].dataset.facet : '';
			links.forEach((a) => {
				a.addEventListener('mouseenter', () => lightFacet(card, a.dataset.facet));
				a.addEventListener('focus', () => lightFacet(card, a.dataset.facet));
			});
			const list = card.querySelector('.menu-items');
			if (list) {
				list.addEventListener('mouseleave', () => lightFacet(card, first));
			}
			card.addEventListener('focusout', () => {
				requestAnimationFrame(() => {
					if (!card.contains(document.activeElement)) lightFacet(card, first);
				});
			});
		});

		// A followed link navigates on its own; the card just gets out of
		// the way first.
		panel.querySelectorAll('a[href]').forEach((a) => {
			a.addEventListener('click', () => closeMenu());
		});

		document.addEventListener('click', (e) => {
			if (openKey === null) return;
			if (panel.contains(e.target) || nav.contains(e.target)) return;
			closeMenu();
		});
		document.addEventListener('keydown', (e) => {
			if (e.key === 'Escape' && openKey !== null) {
				const link = items.find((item) => item.dataset.menu === openKey);
				closeMenu();
				if (link && document.activeElement && !nav.contains(document.activeElement)) link.focus();
			}
		});

		window.addEventListener('scroll', () => {
			if (openKey !== null) position();
		}, { passive: true });
		window.addEventListener('resize', () => {
			if (!desktop()) closeMenu();
			else if (openKey !== null) position();
		});
		wide.addEventListener('change', () => {
			if (!wide.matches) closeMenu();
		});
	})();
</script>

<script is:inline>
	// Mobile menu
	(function () {
		const btn = document.getElementById('menu-toggle');
		const menu = document.getElementById('mobile-menu');
		const burger = document.getElementById('icon-burger');
		const close = document.getElementById('icon-close');
		if (!btn || !menu) return;

		// Must match the max-height transition in the component styles.
		const DURATION = 350;
		const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
		let closeTimer = null;
		let afterClose = null;

		// Lock body scroll without a layout shift: the disappearing scrollbar
		// would otherwise jog the page sideways by its own width.
		function lockScroll(on) {
			if (on) {
				const sw = window.innerWidth - document.documentElement.clientWidth;
				document.body.style.overflow = 'hidden';
				if (sw > 0) document.body.style.paddingRight = `${sw}px`;
			} else {
				document.body.style.overflow = '';
				document.body.style.paddingRight = '';
			}
		}

		// onClosed runs once the collapse has visually finished, so callers can
		// chain a follow-up action onto the end of the animation instead of
		// running it in parallel with it.
		function setOpen(open, onClosed) {
			clearTimeout(closeTimer);

			if (open) {
				// Re-opening cancels the pending follow-up: the tap that reversed
				// the intent supersedes whatever it was going to trigger.
				afterClose = null;
				// Unhide first, then add .is-open a frame later so the browser
				// has the collapsed state to animate away from - adding both at
				// once would skip the transition entirely.
				menu.classList.remove('hidden');
				requestAnimationFrame(() => requestAnimationFrame(() => {
					menu.classList.add('is-open');
				}));
				lockScroll(true);
				// A panel left open on desktop has no meaning here; shut it.
				const panel = document.getElementById('menu-panel');
				if (panel) panel.classList.remove('is-open');
				document.querySelectorAll('#desktop-nav .nav-link').forEach((link) => {
					link.setAttribute('aria-expanded', 'false');
				});
			} else {
				menu.classList.remove('is-open');
				afterClose = onClosed || null;
				// Wait for the collapse to finish before display:none, or the
				// panel would disappear mid-animation.
				closeTimer = setTimeout(() => {
					if (!menu.classList.contains('is-open')) menu.classList.add('hidden');
					const cb = afterClose;
					afterClose = null;
					if (cb) cb();
				}, reduced.matches ? 0 : DURATION + 40);
				lockScroll(false);
			}

			burger.classList.toggle('hidden', open);
			close.classList.toggle('hidden', !open);
			btn.setAttribute('aria-expanded', String(open));
		}

		// aria-expanded, not the `hidden` class, decides the next state: during
		// the close animation `hidden` is still absent, so reading it would
		// make a second tap close again instead of re-opening.
		btn.addEventListener('click', () => {
			const willOpen = btn.getAttribute('aria-expanded') !== 'true';
			setOpen(willOpen);
			if (willOpen) {
				const first = menu.querySelector('.mobile-group-btn, a[href]');
				if (first) first.focus();
			}
		});

		// Accordion: one menu open at a time.
		const groups = Array.from(menu.querySelectorAll('.mobile-group'));
		groups.forEach((group) => {
			const button = group.querySelector('.mobile-group-btn');
			const section = group.querySelector('.mobile-group-panel');
			if (!button || !section) return;
			button.addEventListener('click', () => {
				const willOpen = button.getAttribute('aria-expanded') !== 'true';
				groups.forEach((other) => {
					other.querySelector('.mobile-group-btn').setAttribute('aria-expanded', 'false');
					other.querySelector('.mobile-group-panel').hidden = true;
				});
				if (willOpen) {
					button.setAttribute('aria-expanded', 'true');
					section.hidden = false;
				}
			});
		});

		// Focus trap while open, Escape closes and hands focus back.
		menu.addEventListener('keydown', (e) => {
			if (e.key === 'Escape') {
				setOpen(false);
				btn.focus();
				return;
			}
			if (e.key !== 'Tab') return;
			const focusables = Array.from(
				menu.querySelectorAll('a[href], button:not([disabled])'),
			).filter((el) => el.offsetParent !== null);
			if (!focusables.length) return;
			const first = focusables[0];
			const last = focusables[focusables.length - 1];
			if (e.shiftKey && document.activeElement === first) {
				e.preventDefault();
				last.focus();
			} else if (!e.shiftKey && document.activeElement === last) {
				e.preventDefault();
				first.focus();
			}
		});

		// Page links close the sheet and navigate on their own; nothing
		// here is a same-page hash, so there is no jump to choreograph.
		menu.querySelectorAll('a[href]').forEach((link) => {
			link.addEventListener('click', () => setOpen(false));
		});
		window.matchMedia('(min-width: 768px)').addEventListener('change', (e) => { if (e.matches) setOpen(false); });
	})();
</script>
