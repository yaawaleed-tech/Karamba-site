---
---

<section class="cs-hero" aria-labelledby="cs-hero-title">
	<div class="cs-hero-panel">
		<div class="cs-hero-grid">
			<div class="cs-hero-copy">
				<nav class="cs-hero-crumb" aria-label="Breadcrumb">
					<a href="/services">Services</a>
					<span aria-hidden="true">/</span>
					<span aria-current="page">Custom software</span>
				</nav>
				<p class="cs-eyebrow cs-rise">Services</p>
				<h1 id="cs-hero-title" class="cs-rise cs-rise-d1">Custom software</h1>
				<p class="cs-hero-intro cs-rise cs-rise-d2">Web and mobile applications built around how your business actually runs.</p>
				<div class="cs-hero-actions cs-rise cs-rise-d3">
					<a class="cs-hero-primary" href="/quote" data-quote>Get a quote</a>
					<a class="cs-hero-secondary" href="#cs-process">How we build</a>
				</div>
			</div>

			<div class="cs-hero-scene" aria-hidden="true">
				<svg class="cs-hero-svg" viewBox="0 0 640 500" role="presentation">
					<g class="cs-scene-depth">
						<g class="cs-scene-browser cs-scene-float">
							<rect x="34" y="106" width="430" height="292" rx="18" class="cs-wire-frame" />
							<rect x="34" y="106" width="430" height="52" rx="18" class="cs-wire-bar" />
							<path d="M34 140h430" class="cs-wire-line" />
							<circle cx="62" cy="132" r="5" class="cs-wire-dot" />
							<circle cx="81" cy="132" r="5" class="cs-wire-dot" />
							<circle cx="100" cy="132" r="5" class="cs-wire-dot" />
							<rect x="68" y="188" width="132" height="14" rx="7" class="cs-wire-block" />
							<rect x="68" y="216" width="82" height="9" rx="4.5" class="cs-wire-muted" />
							<rect x="68" y="264" width="22" height="76" rx="5" class="cs-wire-block" />
							<rect x="102" y="240" width="22" height="100" rx="5" class="cs-wire-block" />
							<rect x="136" y="282" width="22" height="58" rx="5" class="cs-wire-block" />
							<rect x="170" y="254" width="22" height="86" rx="5" class="cs-wire-block" />
							<rect x="238" y="188" width="164" height="12" rx="6" class="cs-wire-block" />
							<rect x="238" y="217" width="164" height="1" class="cs-wire-line" />
							<rect x="238" y="242" width="136" height="9" rx="4.5" class="cs-wire-muted" />
							<rect x="238" y="270" width="164" height="1" class="cs-wire-line" />
							<rect x="238" y="295" width="112" height="9" rx="4.5" class="cs-wire-muted" />
							<rect x="238" y="323" width="164" height="1" class="cs-wire-line" />
							<rect x="238" y="348" width="142" height="9" rx="4.5" class="cs-wire-muted" />

							<g class="cs-finished">
								<rect x="34" y="106" width="430" height="52" rx="18" fill="var(--kt-indigo)" />
								<circle cx="62" cy="132" r="5" fill="var(--kt-clay)" />
								<circle cx="81" cy="132" r="5" fill="var(--kt-teal)" />
								<circle cx="100" cy="132" r="5" fill="var(--kt-cream)" opacity=".55" />
								<rect x="68" y="188" width="132" height="14" rx="7" fill="var(--kt-cream)" />
								<rect x="68" y="216" width="82" height="9" rx="4.5" fill="var(--kt-mist)" opacity=".7" />
								<rect x="68" y="264" width="22" height="76" rx="5" fill="var(--kt-teal)" class="cs-fill-1" />
								<rect x="102" y="240" width="22" height="100" rx="5" fill="var(--kt-mist)" class="cs-fill-2" />
								<rect x="136" y="282" width="22" height="58" rx="5" fill="var(--kt-ink-deep)" class="cs-fill-3" />
								<rect x="170" y="254" width="22" height="86" rx="5" fill="var(--kt-cream)" class="cs-fill-4" />
								<rect x="238" y="188" width="164" height="12" rx="6" fill="var(--kt-cream)" class="cs-fill-2" />
								<rect x="238" y="242" width="136" height="9" rx="4.5" fill="var(--kt-mist)" opacity=".75" class="cs-fill-3" />
								<rect x="238" y="295" width="112" height="9" rx="4.5" fill="var(--kt-mist)" opacity=".75" class="cs-fill-4" />
								<rect x="238" y="348" width="142" height="9" rx="4.5" fill="var(--kt-mist)" opacity=".75" class="cs-fill-5" />
							</g>
						</g>

						<g class="cs-scene-phone cs-scene-float">
							<rect x="392" y="182" width="152" height="278" rx="24" class="cs-phone-frame" />
							<rect x="405" y="219" width="126" height="214" rx="10" class="cs-phone-screen" />
							<rect x="447" y="197" width="42" height="5" rx="2.5" class="cs-wire-line" />
							<rect x="421" y="243" width="76" height="11" rx="5.5" class="cs-wire-block" />
							<rect x="421" y="270" width="94" height="54" rx="9" class="cs-wire-block" />
							<rect x="433" y="286" width="38" height="8" rx="4" class="cs-wire-block" />
							<rect x="421" y="344" width="94" height="1" class="cs-wire-line" />
							<rect x="421" y="363" width="68" height="8" rx="4" class="cs-wire-muted" />
							<rect x="421" y="388" width="82" height="8" rx="4" class="cs-wire-muted" />
							<g class="cs-finished">
								<rect x="392" y="182" width="152" height="278" rx="24" fill="var(--kt-indigo)" />
								<rect x="405" y="219" width="126" height="214" rx="10" fill="var(--kt-cream)" />
								<rect x="421" y="243" width="76" height="11" rx="5.5" fill="var(--kt-indigo)" class="cs-fill-2" />
								<rect x="421" y="270" width="94" height="54" rx="9" fill="var(--kt-mist)" class="cs-fill-3" />
								<rect x="433" y="286" width="38" height="8" rx="4" fill="var(--kt-teal)" class="cs-fill-4" />
								<rect x="421" y="363" width="68" height="8" rx="4" fill="var(--kt-indigo)" opacity=".55" class="cs-fill-5" />
								<rect x="421" y="388" width="82" height="8" rx="4" fill="var(--kt-indigo)" opacity=".55" class="cs-fill-5" />
							</g>
						</g>

						<g class="cs-status cs-scene-float">
							<rect x="82" y="58" width="174" height="72" rx="14" class="cs-status-card" />
							<circle cx="108" cy="94" r="9" fill="var(--kt-teal)" />
							<path d="m104 94 3 3 6-7" fill="none" stroke="var(--kt-indigo)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
							<rect x="130" y="81" width="86" height="9" rx="4.5" class="cs-wire-block" />
							<rect x="130" y="101" width="58" height="7" rx="3.5" class="cs-wire-muted" />
							<g class="cs-finished cs-deployed">
								<rect x="82" y="58" width="174" height="72" rx="14" fill="var(--kt-mist)" />
								<circle cx="108" cy="94" r="9" fill="var(--kt-teal)" />
								<path d="m104 94 3 3 6-7" fill="none" stroke="var(--kt-indigo)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
								<text x="130" y="91" fill="var(--kt-indigo)" font-family="var(--font-mono)" font-size="12">Deployed</text>
								<rect x="130" y="101" width="58" height="7" rx="3.5" fill="var(--kt-indigo)" opacity=".45" />
							</g>
						</g>

						<path class="cs-cursor" d="m284 160 13 29 7-10 10 5 3-6-11-5 10-7z" fill="var(--kt-cream)" stroke="var(--kt-indigo)" stroke-width="2" />
					</g>
				</svg>
			</div>
		</div>

		<div class="cs-ticker-wrap">
			<p class="cs-sr-only">Web apps, Mobile apps, Customer portals, Internal tools, APIs and integrations</p>
			<div class="cs-ticker" aria-hidden="true">
				<div class="cs-ticker-track">
					<div class="cs-ticker-row">
						<span>Web apps</span><i></i><span>Mobile apps</span><i></i><span>Customer portals</span><i></i><span>Internal tools</span><i></i><span>APIs and integrations</span><i></i>
					</div>
					<div class="cs-ticker-row" aria-hidden="true">
						<span>Web apps</span><i></i><span>Mobile apps</span><i></i><span>Customer portals</span><i></i><span>Internal tools</span><i></i><span>APIs and integrations</span><i></i>
					</div>
				</div>
			</div>
		</div>
	</div>
</section>

<script>
	const hero = document.querySelector('.cs-hero');
	const scene = hero?.querySelector('.cs-hero-scene');
	if (hero && scene && 'IntersectionObserver' in window) {
		const observer = new IntersectionObserver(([entry]) => {
			scene.classList.toggle('cs-scene-active', entry.isIntersecting);
		}, { threshold: 0.05 });
		observer.observe(hero);
	} else {
		scene?.classList.add('cs-scene-active');
	}
</script>

<style>
	.cs-hero {
		padding: 0;
		background: var(--color-bg);
		overflow-x: clip;
	}

	.cs-hero-panel {
		position: relative;
		width: 100%;
		max-width: none;
		margin-inline: 0;
		padding: 3.5rem 0 3rem;
		overflow: visible;
		border: 0;
		border-radius: 0 0 1.5rem 1.5rem;
		background: linear-gradient(135deg, var(--kt-ink-deep), var(--kt-indigo));
		color: var(--kt-cream);
	}

	:global([data-theme='dark']) .cs-hero-panel {
		background: linear-gradient(135deg, var(--kt-ink-deep), #22345f);
		border-color: color-mix(in srgb, var(--kt-cream) 34%, var(--kt-indigo));
	}

	.cs-hero-grid {
		display: grid;
		max-width: var(--container-inner);
		margin-inline: auto;
		padding-inline: 24px;
		grid-template-columns: minmax(0, .85fr) minmax(0, 1.15fr);
		gap: clamp(1.5rem, 5vw, 5rem);
		align-items: center;
		min-height: 570px;
		padding: 0;
	}

	.cs-hero-copy {
		position: relative;
		z-index: 1;
		max-width: 34rem;
	}

	.cs-hero-crumb {
		display: flex;
		flex-wrap: wrap;
		gap: .55rem;
		margin-bottom: 2rem;
		color: color-mix(in srgb, var(--kt-cream) 68%, transparent);
		font: .74rem var(--font-mono);
	}

	.cs-hero-crumb a { color: inherit; text-decoration: none; }
	.cs-hero-crumb a:hover,
	.cs-hero-crumb a:focus-visible { color: var(--kt-cream); text-decoration: underline; }

	.cs-eyebrow {
		margin: 0 0 1rem;
		color: var(--kt-teal-light);
		font: 500 .75rem/1.2 var(--font-mono);
		letter-spacing: .14em;
		text-transform: uppercase;
	}

	.cs-eyebrow::before {
		display: inline-block;
		width: 2rem;
		height: 2px;
		margin-right: .65rem;
		vertical-align: middle;
		background: var(--kt-clay-light);
		content: '';
	}

	.cs-hero h1 {
		margin: 0;
		color: var(--kt-cream);
		font: 600 clamp(3.2rem, 7vw, 5.5rem)/.94 var(--font-heading);
		letter-spacing: -.04em;
	}

	.cs-hero-intro {
		max-width: 32rem;
		margin: 1.75rem 0 0;
		color: color-mix(in srgb, var(--kt-cream) 76%, transparent);
		font-size: clamp(1.05rem, 1.5vw, 1.25rem);
		line-height: 1.6;
	}

	.cs-hero-actions {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 1.25rem;
		margin-top: 2.25rem;
	}

	.cs-hero-primary {
		display: inline-flex;
		align-items: center;
		min-height: 48px;
		padding: .75rem 1.4rem;
		border-radius: 999px;
		background: var(--kt-cream);
		color: var(--kt-indigo);
		font-weight: 600;
		text-decoration: none;
	}

	.cs-hero-secondary {
		position: relative;
		z-index: 1;
		display: inline-flex;
		align-items: center;
		min-height: 44px;
		padding-block: .75rem;
		margin-block: -.625rem;
		color: var(--kt-cream);
		font-weight: 500;
		text-decoration: underline;
		text-decoration-color: var(--kt-teal-light);
		text-decoration-thickness: 2px;
		text-underline-offset: .3rem;
	}

	.cs-hero-primary,
	.cs-hero-secondary { transition: transform .2s ease, opacity .2s ease; }

	:global([data-theme='dark']) .cs-hero-primary {
		background: var(--color-primary);
		color: var(--color-primary-text);
	}

	@media (hover: hover) and (pointer: fine) {
		.cs-hero-primary:hover { transform: translateY(-2px); }
		.cs-hero-secondary:hover { opacity: .7; }
	}

	.cs-hero-scene {
		position: relative;
		z-index: 1;
		pointer-events: none;
		min-width: 0;
		margin: 0 -4rem -4rem 0;
	}

	.cs-hero-svg { display: block; width: 112%; height: auto; overflow: visible; }

	.cs-scene-depth {
		display: block;
		transform: translateY(0);
	}

	.cs-scene-float { animation: cs-float 5s ease-in-out infinite; animation-play-state: paused; }
	.cs-scene-active .cs-scene-float { animation-play-state: running; }
	.cs-scene-phone { animation-delay: -1.5s; }
	.cs-status { animation-delay: -2.7s; }

	.cs-wire-frame,
	.cs-wire-bar,
	.cs-phone-frame,
	.cs-phone-screen,
	.cs-status-card { fill: none; stroke: color-mix(in srgb, var(--kt-cream) 46%, transparent); stroke-width: 2; }
	.cs-wire-bar { fill: color-mix(in srgb, var(--kt-cream) 8%, transparent); }
	.cs-phone-frame { fill: color-mix(in srgb, var(--kt-cream) 7%, transparent); }
	.cs-phone-screen { fill: color-mix(in srgb, var(--kt-cream) 5%, transparent); }
	.cs-status-card { fill: color-mix(in srgb, var(--kt-cream) 8%, transparent); }
	.cs-wire-line { fill: none; stroke: color-mix(in srgb, var(--kt-cream) 35%, transparent); stroke-width: 2; }
	.cs-wire-dot,
	.cs-wire-block,
	.cs-wire-muted { fill: color-mix(in srgb, var(--kt-cream) 42%, transparent); }
	.cs-wire-muted { opacity: .55; }

	.cs-finished {
		opacity: 0;
		animation: cs-fill 9s ease-in-out infinite;
		animation-play-state: paused;
	}
	.cs-scene-active .cs-finished { animation-play-state: running; }
	.cs-fill-1 { animation-delay: .35s; }
	.cs-fill-2 { animation-delay: .9s; }
	.cs-fill-3 { animation-delay: 1.45s; }
	.cs-fill-4 { animation-delay: 2s; }
	.cs-fill-5 { animation-delay: 2.55s; }
	.cs-deployed { animation-delay: 5.9s; }

	.cs-cursor {
		opacity: 0;
		transform: translate(0, 0);
		transform-box: fill-box;
		transform-origin: center;
		animation: cs-cursor 9s ease-in-out infinite;
		animation-play-state: paused;
	}
	.cs-scene-active .cs-cursor { animation-play-state: running; }

	@keyframes cs-fill {
		0%, 12% { opacity: 0; }
		22%, 78% { opacity: 1; }
		90%, 100% { opacity: 0; }
	}

	@keyframes cs-cursor {
		0%, 10% { opacity: 0; transform: translate(0, 0); }
		18% { opacity: 1; transform: translate(0, 0); }
		42% { opacity: 1; transform: translate(78px, 96px); }
		65% { opacity: 1; transform: translate(150px, 178px); }
		82% { opacity: 1; transform: translate(252px, 110px); }
		90%, 100% { opacity: 0; transform: translate(252px, 110px); }
	}

	@keyframes cs-float {
		0%, 100% { transform: translateY(0); }
		50% { transform: translateY(-5px); }
	}

	@supports (animation-timeline: scroll()) {
		@media (min-width: 720px) and (prefers-reduced-motion: no-preference) {
			.cs-scene-depth {
				animation: cs-scene-depth linear both;
				animation-timeline: scroll(root block);
				animation-range: 0 620px;
			}
			@keyframes cs-scene-depth {
				from { transform: translateY(0); }
				to { transform: translateY(-18px); }
			}
		}
	}

	.cs-ticker-wrap {
		position: relative;
		z-index: 2;
		max-width: var(--container-inner);
		margin: clamp(2rem, 4vw, 3.5rem) auto 0;
		padding-inline: 24px;
		overflow: hidden;
	}

	.cs-ticker {
		overflow: hidden;
		border-top: 1px solid color-mix(in srgb, var(--kt-cream) 22%, transparent);
		padding-top: 1rem;
		color: color-mix(in srgb, var(--kt-cream) 70%, transparent);
		font: .72rem var(--font-mono);
		white-space: nowrap;
	}

	.cs-ticker-track {
		display: flex;
		width: max-content;
		animation: cs-ticker 45s linear infinite;
	}

	.cs-ticker-row {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 1rem;
		padding-right: 1rem;
	}

	.cs-ticker:hover .cs-ticker-track { animation-play-state: paused; }
	.cs-ticker i { width: 4px; height: 4px; border-radius: 50%; background: var(--kt-teal); flex: none; }

	@keyframes cs-ticker { to { transform: translateX(-50%); } }

	.cs-sr-only {
		position: absolute;
		width: 1px;
		height: 1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
	}

	@media (max-width: 899px) {
		.cs-hero { padding: 0; }
		.cs-hero-panel { padding: 2.5rem 0 2rem; }
		.cs-hero-grid { grid-template-columns: 1fr; min-height: 0; padding-inline: 20px; }
		.cs-ticker-wrap { padding-inline: 20px; }
		.cs-hero-scene { max-width: calc(100% + 1.5rem); margin: 0 -1.5rem -2rem 0; }
		.cs-hero-svg { width: 100%; }
	}

	@media (max-width: 560px) {
		.cs-hero h1 { font-size: clamp(3rem, 15vw, 4.5rem); }
		.cs-hero-scene { margin-right: -2.5rem; }
	}

	@media (prefers-reduced-motion: reduce) {
		.cs-scene-float,
		.cs-finished,
		.cs-cursor,
		.cs-ticker-track,
		.cs-hero-primary,
		.cs-hero-secondary { animation: none; transition: none; }
		.cs-finished { opacity: 1; }
		.cs-ticker { white-space: normal; }
		.cs-ticker-track { width: 100%; flex-wrap: wrap; row-gap: .5rem; }
		.cs-ticker-row { padding-right: 0; }
		.cs-ticker-row[aria-hidden='true'] { display: none; }
	}

	:global(html[data-fx='lite']) .cs-scene-float,
	:global(html[data-fx='lite']) .cs-finished,
	:global(html[data-fx='lite']) .cs-cursor,
	:global(html[data-fx='lite']) .cs-ticker-track {
		animation: none;
	}

	:global(html[data-fx='lite']) .cs-finished { opacity: 1; }
	:global(html[data-fx='lite']) .cs-ticker { white-space: normal; }
	:global(html[data-fx='lite']) .cs-ticker-track { width: 100%; flex-wrap: wrap; row-gap: .5rem; }
	:global(html[data-fx='lite']) .cs-ticker-row { padding-right: 0; }
	:global(html[data-fx='lite']) .cs-ticker-row[aria-hidden='true'] { display: none; }
</style>
