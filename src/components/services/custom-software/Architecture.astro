<script>
	const archPanel = document.querySelector('.cs-arch-panel');
	const layersWrap = document.querySelector('.cs-arch-layers');
	const detail = document.querySelector('.cs-arch-detail');
	const acc = document.querySelector('.cs-arch-accordion');
	const slabBtns = Array.from(document.querySelectorAll('.cs-layer'));
	const accItems = Array.from(document.querySelectorAll('.cs-acc-item'));
	const accBtns = Array.from(document.querySelectorAll('.cs-acc-btn'));

	if (acc) acc.classList.add('cs-acc-js');

	/* One source of truth: a click, tap or key press is the only thing that
	   changes the active layer. There is no hover preview and no timer. */
	let activeLayer = 1;

	function paint(n) {
		if (layersWrap) layersWrap.setAttribute('data-layer', String(n));
		if (detail) detail.setAttribute('data-layer', String(n));
		slabBtns.forEach(function (b) {
			const on = b.getAttribute('data-layer') === String(n);
			b.classList.toggle('is-active', on);
			b.setAttribute('aria-pressed', on ? 'true' : 'false');
		});
	}

	function activate(n) {
		n = Math.max(1, Math.min(4, Number(n) || 1));
		if (n === activeLayer) return;
		activeLayer = n;
		paint(n);
	}

	slabBtns.forEach(function (b) {
		const index = Number(b.getAttribute('data-layer'));
		b.addEventListener('click', function () { activate(index); });
		b.addEventListener('keydown', function (e) {
			let next = null;
			if (e.key === 'ArrowDown' || e.key === 'ArrowRight') next = activeLayer + 1;
			else if (e.key === 'ArrowUp' || e.key === 'ArrowLeft') next = activeLayer - 1;
			else if (e.key === 'Home') next = 1;
			else if (e.key === 'End') next = 4;
			else if (e.key === 'Enter' || e.key === ' ') next = index;
			if (next === null) return;
			e.preventDefault();
			activate(next);
		});
	});

	if (accBtns.length) {
		accBtns.forEach(function (btn) {
			btn.addEventListener('click', function () {
				var item = btn.closest('.cs-acc-item');
				if (!item) return;
				accItems.forEach(function (it) { it.classList.remove('open'); });
				item.classList.add('open');
				btn.setAttribute('aria-expanded', 'true');
			});
		});
		accItems.forEach(function (item) {
			var btn = item.querySelector('.cs-acc-btn');
			if (btn) btn.setAttribute('aria-expanded', item.classList.contains('open') ? 'true' : 'false');
		});
	}

	paint(1);
</script>

<style>
	.cs-arch { scroll-margin-top: 96px; padding-block: clamp(2.75rem, 4.5vw, 4rem); }

	.cs-arch-intro { max-width: var(--container-inner); margin-inline: auto; padding: 0 24px; }

	.cs-eyebrow { margin: 0 0 1rem; color: var(--kt-teal); font: 500 .75rem/1.2 var(--font-mono); letter-spacing: .14em; text-transform: uppercase; }
	.cs-eyebrow::before { display: inline-block; width: 2rem; height: 2px; margin-right: .65rem; vertical-align: middle; background: var(--kt-clay); content: ''; }

	.cs-arch h2 { margin: 0; color: var(--color-text); font: 600 clamp(2rem, 4.5vw, 3rem)/1.08 var(--font-heading); letter-spacing: -.03em; }

	.cs-arch-intro-text { margin: 1.5rem 0 0; max-width: 40rem; color: var(--color-text-muted); font-size: var(--fs-lead); line-height: 1.6; }

	.cs-arch-pinned { display: none; max-width: var(--container-inner); margin: clamp(2rem, 4vw, 3.5rem) auto 0; padding-inline: 24px; }

	.cs-arch-panel { border: 1px solid var(--cs-soft-border); border-radius: 1.5rem; background: var(--cs-soft-bg); color: var(--cs-soft-text); padding: 2rem; min-height: 26rem; display: flex; flex-direction: column; gap: 2.5rem; align-items: stretch; }

	@media (min-width: 900px) { .cs-arch-panel { flex-direction: row; padding: 2.5rem; } }

	.cs-arch-layers {
		flex: 1;
		display: flex;
		flex-direction: column;
		gap: .625rem;
		justify-content: center;
	}

	.cs-layer {
		position: relative;
		display: flex;
		align-items: center;
		gap: 1rem;
		width: 100%;
		min-height: 4.25rem;
		padding: .5rem 1rem .5rem 1.25rem;
		border: 1px solid color-mix(in srgb, var(--cs-soft-text) 18%, transparent);
		border-radius: 1rem;
		background: var(--cs-soft-tile);
		color: var(--cs-soft-muted);
		text-align: left;
		cursor: pointer;
		transition: opacity 200ms ease, border-color 200ms ease, background-color 200ms ease;
	}
	.cs-layer:focus-visible { outline: 2px solid var(--cs-soft-accent); outline-offset: 3px; }
	.cs-layer.is-active {
		border-color: color-mix(in srgb, var(--cs-soft-accent) 60%, transparent);
		background: color-mix(in srgb, var(--cs-soft-accent) 12%, var(--cs-soft-tile));
		color: var(--cs-soft-text);
	}
	/* 3px accent bar, kept inside the rounded corner. */
	.cs-layer.is-active::before {
		content: '';
		position: absolute;
		left: 0;
		top: .5rem;
		bottom: .5rem;
		width: 3px;
		border-radius: 0 3px 3px 0;
		background: var(--cs-soft-accent);
	}

	.cs-layer-icon {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 36px;
		height: 36px;
		border-radius: 50%;
		border: 1px solid color-mix(in srgb, var(--cs-soft-text) 24%, transparent);
		color: var(--cs-soft-accent);
		flex: none;
	}
	.cs-layer-icon svg { width: 20px; height: 20px; }

	.cs-layer-text { display: flex; align-items: baseline; gap: .75rem; min-width: 0; }
	.cs-layer-num { color: var(--cs-soft-accent); font: 500 1rem/1 var(--font-mono); }
	.cs-layer-name { color: var(--cs-soft-muted); font: 600 1.25rem/1.2 var(--font-heading); letter-spacing: -.01em; transition: color 200ms ease; }
	.cs-layer.is-active .cs-layer-name { color: var(--cs-soft-text); }

	.cs-layer-chevron {
		display: inline-flex;
		margin-left: auto;
		color: var(--cs-soft-muted);
		transition: transform 200ms ease, color 200ms ease;
	}
	.cs-layer-chevron svg { width: 1rem; height: 1rem; }
	.cs-layer.is-active .cs-layer-chevron { color: var(--cs-soft-accent); transform: translateX(3px); }

	@media (hover: hover) and (pointer: fine) {
		.cs-layer:hover { border-color: color-mix(in srgb, var(--cs-soft-text) 38%, transparent); }
		.cs-layer.is-active:hover { border-color: color-mix(in srgb, var(--cs-soft-accent) 75%, transparent); }
	}

	.cs-arch-detail { position: relative; flex: 1; min-width: 0; display: grid; align-content: center; padding-left: 1.5rem; border-left: 1px solid color-mix(in srgb, var(--cs-soft-text) 12%, transparent); }

	.cs-arch-detail-layer { grid-area: 1 / 1; display: grid; grid-template-columns: minmax(0, 1fr) auto; grid-template-rows: auto minmax(0, 1fr) auto; column-gap: 1.5rem; align-items: start; opacity: 0; transform: translateY(10px); visibility: hidden; pointer-events: none; transition: opacity 350ms ease, transform 350ms ease; }
	.cs-arch-detail[data-layer="1"] .cs-arch-detail-layer[data-layer="1"],
	.cs-arch-detail[data-layer="2"] .cs-arch-detail-layer[data-layer="2"],
	.cs-arch-detail[data-layer="3"] .cs-arch-detail-layer[data-layer="3"],
	.cs-arch-detail[data-layer="4"] .cs-arch-detail-layer[data-layer="4"] { opacity: 1; transform: translateY(0); visibility: visible; pointer-events: auto; }

	.cs-arch-detail-layer h3 { grid-column: 1; grid-row: 1; margin: 0 0 1rem; color: var(--cs-soft-text); font: 600 clamp(1.75rem, 2.4vw, 2.25rem)/1.1 var(--font-heading); letter-spacing: -.02em; }
		.cs-arch-detail-layer > p:not(.cs-arch-detail-you-get) { grid-column: 1; grid-row: 2; margin: 0; max-width: 36rem; color: var(--cs-soft-muted); font-size: 1rem; line-height: 1.6; }
	.cs-arch-detail-layer .cs-arch-detail-you-get { grid-column: 1; grid-row: 3; margin: 1.25rem 0 0; color: var(--cs-soft-accent); font: 500 .8rem/1.6 var(--font-mono); letter-spacing: .06em; text-transform: uppercase; }
	.cs-arch-detail-layer .cs-arch-detail-you-get span { color: var(--cs-soft-muted); }
	.cs-arch-detail-layer .cs-arch-diagram { grid-column: 2; grid-row: 1 / 4; width: 140px; height: 140px; max-width: 140px; max-height: 140px; margin: 0; align-self: center; display: block; color: var(--cs-soft-accent); }

	.cs-arch-diagram { width: 100%; height: auto; max-width: 12rem; margin-top: 1rem; display: block; color: var(--cs-soft-accent); }

	@media (max-width: 899px) {
		.cs-acc-item .cs-arch-diagram { display: none; }
		.cs-arch-detail-layer { grid-template-columns: minmax(0, 1fr); grid-template-rows: auto auto auto auto; }
		.cs-arch-detail-layer h3,
		.cs-arch-detail-layer > p:not(.cs-arch-detail-you-get),
		.cs-arch-detail-layer .cs-arch-detail-you-get,
		.cs-arch-detail-layer .cs-arch-diagram { grid-column: 1; }
		.cs-arch-detail-layer h3 { grid-row: 1; }
		.cs-arch-detail-layer > p:not(.cs-arch-detail-you-get) { grid-row: 2; }
		.cs-arch-detail-layer .cs-arch-detail-you-get { grid-row: 3; }
		.cs-arch-detail-layer .cs-arch-diagram { grid-row: 4; justify-self: start; margin-top: 1.5rem; }
	}

	@media (min-width: 900px) and (prefers-reduced-motion: no-preference) {
		:global(html.cs-js) .cs-arch-pinned { display: block; }
		:global(html.cs-js) .cs-arch-accordion { display: none; }
	}

	:global(html[data-fx='lite']) .cs-arch-pinned { display: none; }

	@media (prefers-reduced-motion: reduce) {
		.cs-arch-detail-layer, .cs-layer { transition: none; }
	}

