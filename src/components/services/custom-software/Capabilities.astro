---
---

<section class="cs-cap" aria-labelledby="cs-capabilities-title">
	<div class="cs-cap-head">
		<div class="cs-cap-heading">
			<p class="cs-eyebrow cs-rise">What we build</p>
			<h2 id="cs-capabilities-title" class="cs-rise cs-rise-d1">Software shaped around the way you work.</h2>
			<p class="cs-cap-intro cs-rise cs-rise-d2">Tell us what is slowing your business down. We design and build the system that fixes it, and we stay with you after it goes live.</p>
		</div>
		<div class="cs-cap-nav">
			<button class="cs-cap-nav-btn" id="cs-cap-nav-prev" type="button" aria-label="Previous build card">
				<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 18l-6-6 6-6" /></svg>
			</button>
			<button class="cs-cap-nav-btn" id="cs-cap-nav-next" type="button" aria-label="Next build card">
				<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6-6 6" /></svg>
			</button>
		</div>
	</div>

	<div class="cs-cap-strip" role="region" aria-label="Capability cards" tabindex="0">
		<div class="cs-cap-track">
			<article class="cs-cap-card cs-fade">
				<div class="cs-cap-card-top">
					<span class="cs-cap-num">01</span>
					<svg class="cs-cap-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2" /><path d="M3 10h18" /></svg>
				</div>
				<h3 class="cs-cap-title">Web applications</h3>
				<p class="cs-cap-desc">Full systems that run in any browser. Orders, bookings, records and reports, everything your team handles every day, in one place.</p>
				<div class="cs-cap-divider"></div>
				<div class="cs-cap-good">
					<p class="cs-cap-good-label">Good for</p>
					<p class="cs-cap-good-text">Teams tired of spreadsheets and chat threads.</p>
				</div>
			</article>
			<article class="cs-cap-card cs-fade cs-rise-d1">
				<div class="cs-cap-card-top">
					<span class="cs-cap-num">02</span>
					<svg class="cs-cap-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 11h14v9a2 2 0 0 1-2 2h-10a2 2 0 0 1-2-2z" /><path d="M9 11V7a4 4 0 0 1 8 0v4" /></svg>
				</div>
				<h3 class="cs-cap-title">Mobile apps</h3>
				<p class="cs-cap-desc">Android and iOS apps built for how your customers and staff really use their phones, including on weak networks.</p>
				<div class="cs-cap-divider"></div>
				<div class="cs-cap-good">
					<p class="cs-cap-good-label">Good for</p>
					<p class="cs-cap-good-text">Field teams and customer-facing services.</p>
				</div>
			</article>
			<article class="cs-cap-card cs-fade cs-rise-d2">
				<div class="cs-cap-card-top">
					<span class="cs-cap-num">03</span>
					<svg class="cs-cap-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="8" height="8" rx="1.5" /><rect x="13" y="3" width="8" height="5" rx="1.5" /><rect x="13" y="12" width="8" height="8" rx="1.5" /><path d="M5 21h14" /></svg>
				</div>
				<h3 class="cs-cap-title">Internal tools</h3>
				<p class="cs-cap-desc">Dashboards and workflows that replace manual follow-up so your people stop chasing information.</p>
				<div class="cs-cap-divider"></div>
				<div class="cs-cap-good">
					<p class="cs-cap-good-label">Good for</p>
					<p class="cs-cap-good-text">Operations, finance and admin.</p>
				</div>
			</article>
			<article class="cs-cap-card cs-fade cs-rise-d3">
				<div class="cs-cap-card-top">
					<span class="cs-cap-num">04</span>
					<svg class="cs-cap-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="5" y="11" width="14" height="10" rx="2" /><path d="M8 11V7a4 4 0 0 1 8 0v4" /></svg>
				</div>
				<h3 class="cs-cap-title">Customer portals</h3>
				<p class="cs-cap-desc">A secure place where your customers sign in, see their status, pay, request and download.</p>
				<div class="cs-cap-divider"></div>
				<div class="cs-cap-good">
					<p class="cs-cap-good-label">Good for</p>
					<p class="cs-cap-good-text">Businesses that answer the same questions every day.</p>
				</div>
			</article>
			<article class="cs-cap-card cs-fade cs-rise-d4">
				<div class="cs-cap-card-top">
					<span class="cs-cap-num">05</span>
					<svg class="cs-cap-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="6" cy="6" r="3" /><circle cx="18" cy="18" r="3" /><path d="M8.5 7.5 15.5 14.5M15.5 7.5 8.5 14.5" /></svg>
				</div>
				<h3 class="cs-cap-title">APIs and integrations</h3>
				<p class="cs-cap-desc">We connect your systems to payments, messaging and the tools you already pay for, so data moves on its own.</p>
				<div class="cs-cap-divider"></div>
				<div class="cs-cap-good">
					<p class="cs-cap-good-label">Good for</p>
					<p class="cs-cap-good-text">Companies whose tools do not talk to each other.</p>
				</div>
			</article>
		</div>
	</div>

	<div class="cs-cap-progress" aria-hidden="true"></div>

	<p class="cs-cap-end cs-rise">Not sure which one you need? <a href="/quote" data-quote>Tell us the problem</a></p>
</section>

<script>
	const strip = document.querySelector('.cs-cap-strip');
	const prevBtn = document.getElementById('cs-cap-nav-prev');
	const nextBtn = document.getElementById('cs-cap-nav-next');
	const progress = document.querySelector('.cs-cap-progress');
	if (strip) {
		const cards = Array.from(strip.querySelectorAll('.cs-cap-card'));
		const track = strip.querySelector('.cs-cap-track');
		const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
		const lite = document.documentElement.getAttribute('data-fx') === 'lite';
		const smooth = !reduce && !lite;

		function cardStep() {
			if (!cards.length) return strip.clientWidth;
			const gap = track ? (parseFloat(getComputedStyle(track).columnGap) || 0) : 0;
			return cards[0].getBoundingClientRect().width + gap;
		}

		function maxScroll() { return Math.max(strip.scrollWidth - strip.clientWidth, 0); }

		function update() {
			const max = maxScroll();
			if (prevBtn) prevBtn.disabled = strip.scrollLeft <= 1;
			if (nextBtn) nextBtn.disabled = strip.scrollLeft >= max - 1;
			if (progress) {
				const p = max > 0 ? (strip.scrollLeft + strip.clientWidth) / max : 0;
				progress.style.width = (Math.max(0, Math.min(1, p)) * 100).toFixed(2) + '%';
			}
		}

		function go(dir) {
			const step = cardStep();
			if (!step) return;
			const wanted = strip.scrollLeft + dir * step;
			// Snap the target to a real card offset so it always lands on a card.
			const base = cards.length ? cards[0].offsetLeft : 0;
			const offsets = cards.map((c) => c.offsetLeft - base);
			let target = offsets[0] || 0;
			let best = Infinity;
			offsets.forEach((o) => {
				const d = Math.abs(o - wanted);
				if (d < best) { best = d; target = o; }
			});
			target = Math.max(0, Math.min(maxScroll(), target));
			// Smooth scrolling is cancelled by mandatory snap on touch browsers:
			// suspend snapping for the programmatic scroll, then restore it.
			const previousSnap = strip.style.scrollSnapType;
			if (smooth) strip.style.scrollSnapType = 'none';
			strip.scrollTo({ left: target, behavior: smooth ? 'smooth' : 'auto' });
			if (smooth) {
				let restored = false;
				const restore = function () {
					if (restored) return;
					restored = true;
					strip.style.scrollSnapType = previousSnap;
					strip.removeEventListener('scrollend', restore);
					update();
				};
				strip.addEventListener('scrollend', restore);
				window.setTimeout(restore, 700);
			} else {
				update();
			}
		}

		// Click works for mouse, touch and pen taps alike.
		if (prevBtn) prevBtn.addEventListener('click', function () { go(-1); });
		if (nextBtn) nextBtn.addEventListener('click', function () { go(1); });

		let ticking = false;
		strip.addEventListener('scroll', function () {
			if (ticking) return;
			ticking = true;
			requestAnimationFrame(function () { ticking = false; update(); });
		}, { passive: true });
		strip.addEventListener('scrollend', update, { passive: true });
		strip.addEventListener('keydown', function (e) {
			if (e.key === 'ArrowLeft') { e.preventDefault(); go(-1); }
			else if (e.key === 'ArrowRight') { e.preventDefault(); go(1); }
		});
		window.addEventListener('resize', update);
		if (document.fonts && document.fonts.ready) document.fonts.ready.then(update);
		update();
	}
</script>

<style>
	.cs-cap {
		max-width: var(--container-inner);
		margin-inline: auto;
		padding: clamp(2.75rem, 4.5vw, 4rem) 24px;
	}

	.cs-cap-head {
		display: flex;
		align-items: flex-end;
		justify-content: space-between;
		gap: 2rem;
		margin-bottom: clamp(2.5rem, 6vw, 4.5rem);
	}

	.cs-cap-heading {
		max-width: 44rem;
	}

	.cs-eyebrow {
		margin: 0 0 1rem;
		color: var(--kt-teal);
		font: 500 .75rem/1.2 var(--font-mono);
		letter-spacing: .14em;
		text-transform: uppercase;
	}

	.cs-eyebrow::before {
		display: inline-block;
		width: 2rem;
		height: 2px;
		margin-right: .65rem;
		vertical-align: middle;
		background: var(--kt-clay);
		content: '';
	}

	.cs-cap h2 {
		margin: 0;
		color: var(--color-text);
		font: 600 clamp(2rem, 4.5vw, 3rem)/1.08 var(--font-heading);
		letter-spacing: -.03em;
	}

	.cs-cap-intro {
		margin: 1.5rem 0 0;
		max-width: 40rem;
		color: var(--color-text-muted);
		font-size: var(--fs-lead);
		line-height: 1.6;
	}

	.cs-cap-nav {
		display: flex;
		flex: none;
		gap: .75rem;
	}

	.cs-cap-nav-btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 2.75rem;
		height: 2.75rem;
		border-radius: 50%;
		border: 1px solid color-mix(in srgb, var(--color-text) 30%, transparent);
		background: transparent;
		color: var(--color-text);
		cursor: pointer;
	}

	.cs-cap-nav-btn:disabled {
		opacity: .35;
		cursor: default;
	}

	.cs-cap-strip {
		display: block;
		overflow-x: auto;
		overflow-y: hidden;
		margin-inline: -24px;
		scroll-snap-type: x mandatory;
		scroll-behavior: smooth;
		-webkit-overflow-scrolling: touch;
		scrollbar-width: none;
	}

	.cs-cap-strip::-webkit-scrollbar {
		display: none;
	}

	.cs-cap-track {
		display: flex;
		gap: 20px;
		width: max-content;
	}

	.cs-cap-card {
		flex: 0 0 auto;
		width: 360px;
		height: 420px;
		padding: 1.75rem;
		display: flex;
		flex-direction: column;
		gap: .9rem;
		border: 1px solid var(--cs-panel-border);
		border-radius: 1.5rem;
		background: var(--cs-panel-bg);
		color: var(--cs-panel-text);
		box-shadow: var(--cs-panel-inset);
		scroll-snap-align: start;
	}

	.cs-cap-card-top {
		display: flex;
		align-items: center;
		justify-content: space-between;
	}

	.cs-cap-num {
		color: var(--cs-panel-accent);
		font: 500 2rem/1 var(--font-mono);
	}

	.cs-cap-icon {
		width: 2rem;
		height: 2rem;
		color: var(--cs-panel-accent);
	}

	.cs-cap-title {
		margin: 0;
		color: var(--cs-panel-text);
		font: 600 1.9rem/1.12 var(--font-heading);
		letter-spacing: -.01em;
	}

	.cs-cap-desc {
		margin: 0;
		color: var(--cs-panel-muted);
		font-size: .95rem;
		line-height: 1.55;
	}

	.cs-cap-divider {
		height: 1px;
		background: color-mix(in srgb, var(--cs-panel-text) 18%, transparent);
	}

	.cs-cap-good {
		margin-top: auto;
	}

	.cs-cap-good-label {
		margin: 0 0 .3rem;
		color: var(--cs-panel-accent);
		font: 500 .68rem/1.2 var(--font-mono);
		letter-spacing: .14em;
		text-transform: uppercase;
	}

	.cs-cap-good-text {
		margin: 0;
		color: var(--cs-panel-text);
		font-size: .95rem;
		line-height: 1.5;
	}

	.cs-cap-progress {
		height: 2px;
		margin-top: 1rem;
		background: var(--color-border);
	}


	.cs-cap-end {
		margin: 2.5rem 0 0;
		text-align: center;
		color: var(--color-text-muted);
		font-size: .95rem;
	}

	.cs-cap-end a {
		color: var(--color-accent);
		font-weight: 600;
		text-decoration: underline;
		text-decoration-color: var(--kt-clay);
		text-underline-offset: .3rem;
	}

	@media (max-width: 899px) {
		.cs-cap-card { width: 82vw; height: 340px; padding: 1.5rem; }
		.cs-cap-title { font-size: 1.5rem; }
		.cs-cap-desc { font-size: .85rem; }
		.cs-cap-good-text { font-size: .85rem; }
	}

	@media (hover: hover) and (pointer: fine) {
		.cs-cap-card:hover { transform: translateY(-6px); }
	}

	@media (prefers-reduced-motion: reduce) {
		.cs-cap-strip { scroll-behavior: auto; }
		.cs-cap-card:hover { transform: none; }
	}

	:global(html[data-fx='lite']) .cs-cap-strip { scroll-behavior: auto; }
	:global(html[data-fx='lite']) .cs-cap-card:hover { transform: none; }

</style>
