---
import { CONTACT_WHATSAPP_NUMBER } from '../../../data/contact';

/* Final call to action. Copy is fixed here so this section stays independent
   of the shared closing CTA. The WhatsApp link uses the very same
   number and message construction as that component. */
const WHATSAPP_HREF =
  `https://wa.me/${CONTACT_WHATSAPP_NUMBER}?text=${encodeURIComponent('Hello Karamba, I would like to talk about a project.')}`;

const chips = [
  'A web app',
  'A mobile app',
  'An internal tool',
  'A customer portal',
  'Connecting our tools',
  'Not sure yet',
];
---

<section id="cs-closing" class="cs-cl" aria-labelledby="cs-closing-title">
	<div class="cs-cl-panel cs-fade">
		<div class="cs-cl-inner">
			<div class="cs-cl-copy">
				<p class="cs-cl-eyebrow cs-rise">Start here</p>
				<h2 id="cs-closing-title" class="cs-rise cs-rise-d1">What should we build for you?</h2>
				<p class="cs-cl-line cs-rise cs-rise-d2">Tell us the problem in your own words. We will tell you what it takes, and what we would build first.</p>

				<div class="cs-cl-picks cs-rise cs-rise-d3">
					<p class="cs-cl-picks-label">Pick a starting point</p>
					<div class="cs-cl-chips">
						{chips.map((chip) => (
							<button class="cs-cl-chip" type="button" data-quote data-quote-topic={chip}>{chip}</button>
						))}
					</div>
				</div>

				<div class="cs-cl-actions cs-rise cs-rise-d4">
					<a class="cs-cl-primary" href="/quote" data-quote>Get a quote</a>
					<a class="cs-cl-wa" href={WHATSAPP_HREF} target="_blank" rel="noopener">Message us on WhatsApp</a>
				</div>
			</div>

			<div class="cs-cl-visual" aria-hidden="true">
				<div class="cs-cl-cluster">
					<span class="cs-cl-piece cs-rise cs-cl-p1"></span>
					<span class="cs-cl-piece cs-rise cs-cl-p2"></span>
					<span class="cs-cl-piece cs-rise cs-cl-p3"></span>
					<span class="cs-cl-piece cs-rise cs-cl-p4"></span>
					<span class="cs-cl-piece cs-rise cs-cl-p5"></span>
					<span class="cs-cl-piece cs-rise cs-cl-p6"></span>
				</div>
			</div>
		</div>
	</div>
</section>

<style>
	.cs-cl {
		scroll-margin-top: var(--header-h, 76px);
		padding-block: clamp(2.75rem, 4.5vw, 4rem);
	}

	.cs-cl-panel {
		max-width: var(--container-inner);
		margin-inline: auto;
		padding: clamp(2rem, 5vw, 4rem);
		border: 1px solid var(--cs-panel-border);
		border-radius: 1.5rem;
		background: var(--cs-panel-bg);
		color: var(--cs-panel-text);
		box-shadow: var(--cs-panel-inset);
	}

	.cs-cl-inner {
		display: grid;
		grid-template-columns: minmax(0, 1.1fr) minmax(0, .9fr);
		align-items: center;
		gap: clamp(2rem, 4vw, 4rem);
	}

	.cs-cl-eyebrow {
		margin: 0 0 1rem;
		color: var(--cs-panel-accent);
		font: 500 .75rem/1.2 var(--font-mono);
		letter-spacing: .14em;
		text-transform: uppercase;
	}

	.cs-cl h2 {
		margin: 0;
		color: var(--cs-panel-text);
		font: 600 clamp(2rem, 4vw, 3.25rem)/1.08 var(--font-heading);
		letter-spacing: -.03em;
	}

	.cs-cl-line {
		margin: 1.5rem 0 0;
		max-width: 34rem;
		color: var(--cs-panel-muted);
		font: 400 1rem/1.6 var(--font-body);
	}

	.cs-cl-picks { margin-top: 2rem; }
	.cs-cl-picks-label {
		margin: 0 0 .75rem;
		color: var(--cs-panel-muted);
		font: 500 .72rem/1.2 var(--font-mono);
		letter-spacing: .1em;
		text-transform: uppercase;
	}
	.cs-cl-chips { display: flex; flex-wrap: wrap; gap: .5rem; }
	.cs-cl-chip {
		padding: .45rem .8rem;
		border: 1px solid color-mix(in srgb, var(--cs-panel-text) 35%, transparent);
		border-radius: 999px;
		background: transparent;
		color: var(--cs-panel-text);
		font: 500 .75rem/1.3 var(--font-mono);
		cursor: pointer;
		transition: transform 200ms ease, border-color 200ms ease;
	}
	.cs-cl-chip:hover { border-color: var(--cs-panel-accent); }
	.cs-cl-chip:focus-visible { outline: 2px solid var(--cs-panel-accent); outline-offset: 3px; }

	.cs-cl-actions {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 1rem 1.5rem;
		margin-top: 2rem;
	}
	.cs-cl-primary {
		display: inline-flex;
		align-items: center;
		min-height: 48px;
		padding: .75rem 1.4rem;
		border-radius: 999px;
		background: var(--kt-cream);
		color: var(--kt-indigo);
		font-weight: 600;
		text-decoration: none;
		transition: transform .2s ease;
	}
	.cs-cl-wa {
		color: var(--cs-panel-accent);
		font-weight: 600;
		text-decoration: none;
		transition: opacity .2s ease;
	}
	.cs-cl-wa:hover { opacity: .75; }
	.cs-cl-primary:focus-visible,
	.cs-cl-wa:focus-visible { outline: 2px solid var(--cs-panel-accent); outline-offset: 3px; }

	/* Pieces coming together --------------------------------------------- */
	.cs-cl-visual {
		display: flex;
		align-items: center;
		justify-content: center;
		min-width: 0;
	}
	.cs-cl-cluster {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		grid-template-rows: repeat(2, minmax(0, 1fr));
		gap: .75rem;
		width: min(100%, 300px);
		aspect-ratio: 1 / 1;
	}
	.cs-cl-piece {
		display: block;
		border-radius: 1rem;
		border: 1px solid color-mix(in srgb, var(--cs-panel-text) 22%, transparent);
		background: color-mix(in srgb, var(--cs-panel-text) 14%, transparent);
	}
	.cs-cl-p2 { background: color-mix(in srgb, var(--cs-panel-accent) 32%, transparent); }
	.cs-cl-p3 { background: color-mix(in srgb, var(--cs-panel-text) 8%, transparent); }
	.cs-cl-p4 { background: color-mix(in srgb, var(--kt-clay-light) 80%, transparent); border-color: color-mix(in srgb, var(--kt-clay-light) 55%, transparent); }
	.cs-cl-p5 { background: color-mix(in srgb, var(--cs-panel-accent) 18%, transparent); }
	.cs-cl-p6 { background: color-mix(in srgb, var(--cs-panel-text) 24%, transparent); }

	:global(html.cs-js) .cs-cl-p1 { transform: translate(-20px, -16px) rotate(-6deg); transition-delay: 0ms; }
	:global(html.cs-js) .cs-cl-p2 { transform: translate(14px, -22px) rotate(5deg); transition-delay: 70ms; }
	:global(html.cs-js) .cs-cl-p3 { transform: translate(22px, 10px) rotate(-8deg); transition-delay: 140ms; }
	:global(html.cs-js) .cs-cl-p4 { transform: translate(-18px, 18px) rotate(7deg); transition-delay: 210ms; }
	:global(html.cs-js) .cs-cl-p5 { transform: translate(12px, 20px) rotate(-4deg); transition-delay: 280ms; }
	:global(html.cs-js) .cs-cl-p6 { transform: translate(-14px, -12px) rotate(6deg); transition-delay: 350ms; }
	:global(html.cs-js) .cs-cl-piece {
		transition-duration: 700ms;
		transition-timing-function: cubic-bezier(.2, .7, .2, 1);
	}
	:global(html.cs-js) .cs-cl-piece.is-in { transform: none; }

	:global(html.cs-js[data-fx='lite']) .cs-cl-piece {
		opacity: 1;
		transform: none;
		transition: none;
		transition-delay: 0ms;
	}
	@media (prefers-reduced-motion: reduce) {
		:global(html.cs-js) .cs-cl-piece {
			opacity: 1;
			transform: none;
			transition: none;
			transition-delay: 0ms;
		}
	}
	@media (hover: none) {
		.cs-cl-primary { transform: none; }
	}

	@media (max-width: 899px) {
		.cs-cl-inner { grid-template-columns: minmax(0, 1fr); }
		.cs-cl-visual { order: 2; }
		.cs-cl-cluster { width: min(100%, 200px); max-height: 200px; }
	}
	@media (max-width: 599px) {
		.cs-cl-panel { padding: 1.5rem; }
	}
</style>
