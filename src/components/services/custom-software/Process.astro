</section>

<style>
	.cs-process {
		scroll-margin-top: var(--header-h, 76px);
		padding-block: clamp(2.75rem, 4.5vw, 4rem);
	}

	.cs-process-intro {
		max-width: var(--container-inner);
		margin-inline: auto;
		padding: 0 24px;
	}

	.cs-eyebrow {
		margin: 0 0 1rem;
		color: var(--kt-teal);
		font: 500 .75rem/1.2 var(--font-mono);
		letter-spacing: .14em;
		text-transform: uppercase;
	}
	.cs-eyebrow::before {
		display: inline-block;
		width: 2rem;
		height: 2px;
		margin-right: .65rem;
		vertical-align: middle;
		background: var(--kt-clay);
		content: '';
	}

	.cs-process h2 {
		margin: 0;
		color: var(--color-text);
		font: 600 clamp(1.75rem, 3vw, 2.75rem)/1.1 var(--font-heading);
		letter-spacing: -.03em;
	}

	.cs-process-intro-text {
		margin: 1rem 0 0;
		max-width: 44rem;
		color: var(--color-text-muted);
		font-size: clamp(1rem, 1.5vw, 1.25rem);
		line-height: 1.6;
	}

	/* Stacking steps ---------------------------------------------------- */
	.cs-steps {
		isolation: isolate;
		list-style: none;
		max-width: var(--container-inner);
		margin: 2.5rem auto -64px;
		padding: 0 24px;
	}

	.cs-step {
		height: min(520px, calc(100svh - 190px));
	}

	/* Gives card 4 sticky room; the list's negative bottom margin cancels it
	   so the section rhythm and the gap to Architecture stay unchanged. */
	.cs-step-tail { height: 64px; list-style: none; }

	.cs-step:nth-child(1) .cs-step-panel { background: var(--cs-soft-step-1); }
	.cs-step:nth-child(2) .cs-step-panel { background: var(--cs-soft-step-2); }
	.cs-step:nth-child(3) .cs-step-panel { background: var(--cs-soft-step-3); }
	.cs-step:nth-child(4) .cs-step-panel { background: var(--cs-soft-step-4); }

	.cs-step-panel {
		display: flex;
		flex-direction: column;
		height: 100%;
		overflow: visible;
		padding: 1.5rem 2.5rem;
		border: 1px solid var(--cs-soft-border);
		border-radius: 1.5rem;
		background: var(--cs-soft-step-1);
		color: var(--cs-soft-text);
	}

	.cs-step-head {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		padding-bottom: 1rem;
		border-bottom: 1px solid color-mix(in srgb, var(--cs-soft-text) 18%, transparent);
	}

	.cs-step-num {
		color: var(--cs-soft-accent);
		font: 500 .75rem/1.2 var(--font-mono);
		letter-spacing: .14em;
	}

	.cs-step-label {
		color: var(--cs-soft-accent);
		font: 500 .72rem/1.2 var(--font-mono);
		letter-spacing: .14em;
		text-transform: uppercase;
	}

	.cs-step-body {
		flex: 1;
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
		align-items: center;
		gap: clamp(1.5rem, 3vw, 3rem);
		min-height: 0;
	}

	.cs-step-text {
		max-width: 34rem;
	}

	.cs-step-text h3 {
		margin: 0 0 1rem;
		color: var(--cs-soft-text);
		font: 600 clamp(1.5rem, 2.4vw, 2.25rem)/1.1 var(--font-heading);
		letter-spacing: -.02em;
	}
	.cs-step-text p:not(.cs-step-you-get) {
		margin: 0;
		max-width: 34rem;
		color: var(--cs-soft-muted);
		font-size: 1rem;
		line-height: 1.6;
	}
	.cs-step-you-get {
		margin: 1.25rem 0 0;
		color: var(--cs-soft-accent);
		font: 500 .8rem/1.6 var(--font-mono);
		letter-spacing: .06em;
		text-transform: uppercase;
	}
	.cs-step-you-get span {
		color: var(--cs-soft-muted);
	}

	.cs-step-body > .cs-diagram {
		width: 100%;
		height: 75%;
		max-height: 100%;
		display: block;
		justify-self: center;
		align-self: center;
	}

	/* Diagram tokens are driven by the soft surface variables. */
	.cs-d-note { fill: var(--cs-soft-fill); stroke: var(--cs-soft-line); stroke-width: 1.5; }
	.cs-d-line { fill: var(--cs-soft-line); stroke: none; }
	.cs-d-list { fill: var(--cs-soft-fill); stroke: var(--cs-soft-accent); stroke-width: 1.5; }
	.cs-d-num { fill: var(--cs-soft-text); font: 500 13px/1 var(--font-mono); }
	.cs-d-wire { fill: color-mix(in srgb, var(--cs-soft-fill) 55%, transparent); stroke: var(--cs-soft-line); stroke-width: 1.5; }
	.cs-d-wire-line { fill: var(--cs-soft-line); stroke: none; }
	.cs-d-check-bg { fill: var(--cs-soft-accent); }
	.cs-d-check { stroke: var(--cs-soft-text); stroke-width: 2.2; fill: none; stroke-linecap: round; stroke-linejoin: round; }
	.cs-d-screen { fill: color-mix(in srgb, var(--cs-soft-fill) 60%, transparent); stroke: var(--cs-soft-line); stroke-width: 1.5; }
	.cs-d-line2 { fill: var(--cs-soft-line); stroke: none; }
	.cs-d-progress { fill: color-mix(in srgb, var(--cs-soft-accent) 35%, transparent); }
	.cs-d-screen-f { fill: color-mix(in srgb, var(--cs-soft-fill) 70%, transparent); stroke: var(--cs-soft-line); stroke-width: 1.5; }
	.cs-d-chip-text { fill: var(--cs-soft-text); font: 600 11px/1 var(--font-mono); letter-spacing: .08em; text-transform: uppercase; }

	/* Sticky stacking from 700px up. No JS required. */
	@media (min-width: 700px) {
		.cs-step {
			position: sticky;
			top: calc(var(--header-h, 76px) + 1.5rem + (var(--i) * 1.25rem));
			z-index: calc(var(--i) + 1);
			margin-bottom: 12svh;
		}
		.cs-step:last-child { margin-bottom: 0; }
		/* Cards are always visible on desktop; their panel is the sticky surface. */
		html.cs-js .cs-step.cs-rise { opacity: 1; transform: none; }
	}

	/* Phones stack in the same way as desktop, using the compact header. */
	@media (max-width: 699px) {
		.cs-process { padding-bottom: 4rem; }
		.cs-steps { display: block; margin: 1.5rem auto -2.75rem; padding: 0 20px; }
		.cs-step {
			position: sticky;
			top: calc(var(--header-h, 76px) + 0.75rem + (var(--i) * 0.9rem));
			z-index: calc(var(--i) + 1);
			height: min(520px, calc(100svh - var(--header-h, 76px) - 3.5rem));
			margin-bottom: 10svh;
		}
		.cs-step:nth-child(4) { margin-bottom: 0; }
		.cs-step-tail { height: calc(var(--header-h, 76px) + 0.75rem + (3 * 0.9rem) + 6rem); list-style: none; }
		.cs-step-panel { padding: 1rem 1.25rem; }
		.cs-step-head { padding-bottom: .6rem; }
		.cs-step-text h3 { font-size: 1.35rem; margin-bottom: .6rem; }
		.cs-step-text p:not(.cs-step-you-get) { font-size: .95rem; }
		.cs-step-you-get { font-size: .75rem; margin-top: .75rem; }
