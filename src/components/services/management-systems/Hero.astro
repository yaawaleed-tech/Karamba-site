---
---

<section class="ms-hero" aria-labelledby="ms-hero-title">
	<div class="ms-hero-panel">
		<div class="ms-hero-grid">
			<div class="ms-hero-copy">
				<p class="ms-eyebrow ms-rise">Management systems</p>
				<h1 id="ms-hero-title" class="ms-rise ms-rise-d1"><span class="ms-hero-strong">One clear picture</span><span class="ms-hero-soft">of how you run.</span></h1>
				<p class="ms-hero-intro ms-rise ms-rise-d2">Records, roles, reports and approvals in one system, built on a ready foundation and shaped to how your farm, school, clinic, shop or team already works.</p>
				<div class="ms-hero-actions ms-rise ms-rise-d3">
					<a class="ms-hero-primary" href="/quote" data-quote data-quote-topic="Management systems">Get a quote</a>
					<a class="ms-hero-secondary" href="/#how-we-work">How we work</a>
				</div>
			</div>

			<div class="ms-hero-scene">
				<svg class="ms-hero-svg ms-scene-desktop" viewBox="0 0 520 400" role="img" aria-label="Loose records settling into a ledger, then rising into a report">
					<rect class="ms-ledger" x="24" y="40" width="300" height="320" rx="16" />
					<g class="ms-slots">
						<rect x="40" y="64" width="268" height="40" rx="8" />
						<rect x="40" y="112" width="268" height="40" rx="8" />
						<rect x="40" y="160" width="268" height="40" rx="8" />
						<rect x="40" y="208" width="268" height="40" rx="8" />
						<rect x="40" y="256" width="268" height="40" rx="8" />
						<rect x="40" y="304" width="268" height="40" rx="8" />
					</g>
					<g class="ms-slip ms-slip-1" style="--ms-x:60; --ms-y:150; --ms-r:-7;">
						<rect x="40" y="64" width="268" height="40" rx="8" />
						<text x="54" y="89">Order</text>
						<rect class="ms-slip-rule" x="272" y="84" width="24" height="2" rx="1" />
					</g>
					<g class="ms-slip ms-slip-2" style="--ms-x:120; --ms-y:-30; --ms-r:5;">
						<rect x="40" y="112" width="268" height="40" rx="8" />
						<text x="54" y="137">Student</text>
						<rect class="ms-slip-rule" x="272" y="132" width="24" height="2" rx="1" />
					</g>
					<g class="ms-slip ms-slip-3" style="--ms-x:150; --ms-y:100; --ms-r:-4;">
						<rect x="40" y="160" width="268" height="40" rx="8" />
						<text x="54" y="185">Flock count</text>
						<rect class="ms-slip-rule" x="272" y="180" width="24" height="2" rx="1" />
					</g>
					<g class="ms-slip ms-slip-4" style="--ms-x:-10; --ms-y:-100; --ms-r:8;">
						<rect x="40" y="208" width="268" height="40" rx="8" />
						<text x="54" y="233">Stock line</text>
						<rect class="ms-slip-rule" x="272" y="228" width="24" height="2" rx="1" />
					</g>
					<g class="ms-slip ms-slip-5" style="--ms-x:140; --ms-y:-120; --ms-r:-9;">
						<rect x="40" y="256" width="268" height="40" rx="8" />
						<text x="54" y="281">Patient visit</text>
						<rect class="ms-slip-rule" x="272" y="276" width="24" height="2" rx="1" />
					</g>
					<g class="ms-slip ms-slip-6" style="--ms-x:90; --ms-y:-190; --ms-r:6;">
						<rect x="40" y="304" width="268" height="40" rx="8" />
						<text x="54" y="329">Delivery</text>
						<rect class="ms-slip-rule" x="272" y="324" width="24" height="2" rx="1" />
					</g>
					<g class="ms-tick ms-tick-1">
						<circle cx="284" cy="84" r="8" />
						<path d="m280.5 84 2.5 2.5 5-5.5" />
					</g>
					<g class="ms-tick ms-tick-2">
						<circle cx="284" cy="132" r="8" />
						<path d="m280.5 132 2.5 2.5 5-5.5" />
					</g>
					<g class="ms-tick ms-tick-3">
						<circle cx="284" cy="180" r="8" />
						<path d="m280.5 180 2.5 2.5 5-5.5" />
					</g>
					<g class="ms-tick ms-tick-4">
						<circle cx="284" cy="228" r="8" />
						<path d="m280.5 228 2.5 2.5 5-5.5" />
					</g>
					<g class="ms-tick ms-tick-5">
						<circle cx="284" cy="276" r="8" />
						<path d="m280.5 276 2.5 2.5 5-5.5" />
					</g>
					<g class="ms-tick ms-tick-6">
						<circle cx="284" cy="324" r="8" />
						<path d="m280.5 324 2.5 2.5 5-5.5" />
					</g>
					<rect class="ms-report" x="348" y="40" width="148" height="320" rx="16" />
					<rect class="ms-bar ms-bar-1" x="364" y="240" width="20" height="96" rx="4" />
					<rect class="ms-bar ms-bar-2" x="396" y="184" width="20" height="152" rx="4" />
					<rect class="ms-bar ms-bar-3" x="428" y="128" width="20" height="208" rx="4" />
					<rect class="ms-bar ms-bar-4" x="460" y="208" width="20" height="128" rx="4" />
					<circle class="ms-attn-dot" cx="438" cy="114" r="6" />
				</svg>

				<svg class="ms-hero-svg ms-scene-mobile" viewBox="0 0 340 300" role="img" aria-label="Loose records settling into a ledger, then rising into a report">
					<rect class="ms-ledger" x="0" y="0" width="340" height="184" rx="14" />
					<g class="ms-slots">
						<rect x="16" y="16" width="308" height="32" rx="8" />
						<rect x="16" y="56" width="308" height="32" rx="8" />
						<rect x="16" y="96" width="308" height="32" rx="8" />
						<rect x="16" y="136" width="308" height="32" rx="8" />
					</g>
					<g class="ms-slip ms-slip-1" style="--ms-x:10; --ms-y:100; --ms-r:-5;">
						<rect x="16" y="16" width="308" height="32" rx="8" />
						<text x="30" y="37">Order</text>
						<rect class="ms-slip-rule" x="264" y="31" width="24" height="2" rx="1" />
					</g>
					<g class="ms-slip ms-slip-2" style="--ms-x:-10; --ms-y:-40; --ms-r:4;">
						<rect x="16" y="56" width="308" height="32" rx="8" />
						<text x="30" y="77">Student</text>
						<rect class="ms-slip-rule" x="264" y="71" width="24" height="2" rx="1" />
					</g>
					<g class="ms-slip ms-slip-3" style="--ms-x:14; --ms-y:60; --ms-r:-3;">
						<rect x="16" y="96" width="308" height="32" rx="8" />
						<text x="30" y="117">Flock count</text>
						<rect class="ms-slip-rule" x="264" y="111" width="24" height="2" rx="1" />
					</g>
					<g class="ms-slip ms-slip-4" style="--ms-x:-12; --ms-y:-90; --ms-r:6;">
						<rect x="16" y="136" width="308" height="32" rx="8" />
						<text x="30" y="157">Delivery</text>
						<rect class="ms-slip-rule" x="264" y="151" width="24" height="2" rx="1" />
					</g>
					<g class="ms-tick ms-tick-1">
						<circle cx="304" cy="32" r="7" />
						<path d="m301 32 2 2 4-4.5" />
					</g>
					<g class="ms-tick ms-tick-2">
						<circle cx="304" cy="72" r="7" />
						<path d="m301 72 2 2 4-4.5" />
					</g>
					<g class="ms-tick ms-tick-3">
						<circle cx="304" cy="112" r="7" />
						<path d="m301 112 2 2 4-4.5" />
					</g>
					<g class="ms-tick ms-tick-4">
						<circle cx="304" cy="152" r="7" />
						<path d="m301 152 2 2 4-4.5" />
					</g>
					<rect class="ms-report" x="0" y="200" width="340" height="100" rx="14" />
					<rect class="ms-bar ms-bar-1" x="98" y="260" width="24" height="24" rx="3" />
					<rect class="ms-bar ms-bar-2" x="138" y="246" width="24" height="38" rx="3" />
					<rect class="ms-bar ms-bar-3" x="178" y="228" width="24" height="56" rx="3" />
					<rect class="ms-bar ms-bar-4" x="218" y="250" width="24" height="34" rx="3" />
					<circle class="ms-attn-dot" cx="190" cy="216" r="5" />
				</svg>
			</div>
		</div>

		<div class="ms-ticker-wrap">
			<div class="ms-ticker" aria-hidden="true">
				<div class="ms-ticker-track">
					<div class="ms-ticker-row">
						<span>Students</span><i></i><span>Flocks</span><i></i><span>Patients</span><i></i><span>Stock</span><i></i><span>Orders</span><i></i><span>Deliveries</span><i></i>
					</div>
					<div class="ms-ticker-row" aria-hidden="true">
						<span>Students</span><i></i><span>Flocks</span><i></i><span>Patients</span><i></i><span>Stock</span><i></i><span>Orders</span><i></i><span>Deliveries</span><i></i>
					</div>
				</div>
			</div>
		</div>
	</div>
</section>

<style>
	.ms-hero {
		padding: 0;
		background: var(--color-bg);
		overflow-x: clip;
	}

	.ms-hero-panel {
		position: relative;
		width: 100%;
		max-width: none;
		margin-inline: 0;
		padding: 3.5rem 0 3rem;
		overflow: visible;
		border: 0;
		border-radius: 0 0 1.5rem 1.5rem;
		background: var(--ms-panel-bg);
		color: var(--ms-panel-text);
	}

	.ms-hero-grid {
		display: grid;
		max-width: var(--container-inner);
		margin-inline: auto;
		padding-inline: 24px;
		grid-template-columns: minmax(0, 55fr) minmax(0, 45fr);
		gap: clamp(1.5rem, 5vw, 5rem);
		align-items: center;
		min-height: 570px;
		padding: 0;
	}

	.ms-hero-copy {
		position: relative;
		z-index: 1;
		max-width: 34rem;
	}

	.ms-eyebrow {
		margin: 0 0 1rem;
		color: var(--ms-panel-accent);
		font: 500 .75rem/1.2 var(--font-mono);
		letter-spacing: .14em;
		text-transform: uppercase;
	}

	.ms-eyebrow::before {
		display: inline-block;
		width: 2rem;
		height: 2px;
		margin-right: .65rem;
		vertical-align: middle;
		background: var(--ms-attn);
		content: '';
	}

	.ms-hero h1 {
		margin: 0;
		color: var(--ms-panel-text);
		font: 400 clamp(2.6rem, 7vw, 4rem)/.94 var(--font-heading);
		letter-spacing: -.04em;
	}

	.ms-hero-strong { display: block; font-weight: 600; }
	.ms-hero-soft { display: block; font-weight: 400; color: var(--ms-panel-muted); }

	.ms-hero-intro {
		max-width: 32rem;
		margin: 1.75rem 0 0;
		color: var(--ms-panel-muted);
		font-size: clamp(1.05rem, 1.5vw, 1.25rem);
		line-height: 1.6;
	}

	.ms-hero-actions {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 1.25rem;
		margin-top: 2.25rem;
	}

	.ms-hero-primary {
		display: inline-flex;
		align-items: center;
		min-height: 48px;
		padding: .75rem 1.4rem;
		border-radius: 999px;
		background: var(--kt-cream);
		color: var(--kt-indigo);
		font-weight: 600;
		text-decoration: none;
	}

	.ms-hero-secondary {
		position: relative;
		z-index: 1;
		display: inline-flex;
		align-items: center;
		min-height: 44px;
		padding-block: .75rem;
		margin-block: -.625rem;
		color: var(--ms-panel-text);
		font-weight: 500;
		text-decoration: underline;
		text-decoration-color: var(--ms-panel-accent);
		text-decoration-thickness: 2px;
		text-underline-offset: .3rem;
	}

	.ms-hero-primary,
	.ms-hero-secondary { transition: transform .2s ease, opacity .2s ease; }

	:global([data-theme='dark']) .ms-hero-primary {
		background: var(--color-primary);
		color: var(--color-primary-text);
	}

	@media (hover: hover) and (pointer: fine) {
		.ms-hero-primary:hover { transform: translateY(-2px); }
		.ms-hero-secondary:hover { opacity: .7; }
	}

	.ms-hero-scene {
		position: relative;
		z-index: 1;
		pointer-events: none;
		min-width: 0;
		margin: 0 -4rem -4rem 0;
	}

	.ms-hero-svg { display: block; width: 112%; height: auto; overflow: visible; }
	.ms-scene-mobile { display: none; }

	.ms-ledger {
		fill: none;
		stroke: var(--ms-slot-line);
		stroke-width: 2;
	}

	.ms-slots rect {
		fill: none;
		stroke: var(--ms-slot-line);
		stroke-width: 1.5;
	}

	.ms-slip rect {
		fill: var(--ms-slip-fill);
	}

	.ms-slip text {
		fill: var(--kt-indigo);
		font-family: var(--font-mono);
		font-size: 11px;
	}

	.ms-slip-rule { fill: var(--ms-slip-line); }

	.ms-tick circle { fill: var(--ms-tick); }
	.ms-tick path { fill: none; stroke: var(--kt-indigo); stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }

	.ms-report {
		opacity: 0;
		fill: color-mix(in srgb, var(--kt-cream) 9%, transparent);
		stroke: var(--ms-slot-line);
		stroke-width: 2;
		animation: ms-report 12s ease-out infinite;
	}

	.ms-bar {
		opacity: 0;
		fill: var(--ms-bar-fill);
		transform-box: fill-box;
		transform-origin: bottom;
		transform: scaleY(0);
		animation: ms-bar 12s ease-out infinite;
	}

	.ms-attn-dot {
		opacity: 0;
		fill: var(--ms-attn);
		transform-box: fill-box;
		transform-origin: center;
		animation: ms-attn 12s ease-out infinite;
	}

	.ms-slip {
		opacity: 0;
		transform-box: fill-box;
		transform-origin: center;
		transform: translate(var(--ms-x), var(--ms-y)) rotate(var(--ms-r));
		animation: ms-slip 12s ease-out infinite;
	}

	.ms-tick {
		opacity: 0;
		transform-box: fill-box;
		transform-origin: center;
		transform: scale(.6);
		animation: ms-tick 12s ease-out infinite;
	}

	.ms-slip-2 { animation-delay: .45s; }
	.ms-slip-3 { animation-delay: .9s; }
	.ms-slip-4 { animation-delay: 1.35s; }
	.ms-slip-5 { animation-delay: 1.8s; }
	.ms-slip-6 { animation-delay: 2.25s; }

	.ms-tick-1 { animation-delay: 3s; }
	.ms-tick-2 { animation-delay: 3.45s; }
	.ms-tick-3 { animation-delay: 3.9s; }
	.ms-tick-4 { animation-delay: 4.35s; }
	.ms-tick-5 { animation-delay: 4.8s; }
	.ms-tick-6 { animation-delay: 5.25s; }

	.ms-bar-1 { animation-delay: 4.8s; }
	.ms-bar-2 { animation-delay: 5.1s; }
	.ms-bar-3 { animation-delay: 5.4s; }
	.ms-bar-4 { animation-delay: 5.7s; }

	@keyframes ms-slip {
		0% { opacity: 0; transform: translate(var(--ms-x), var(--ms-y)) rotate(var(--ms-r)); }
		8.33% { opacity: 1; transform: translate(var(--ms-x), var(--ms-y)) rotate(var(--ms-r)); }
		10% { transform: translate(var(--ms-x), var(--ms-y)) rotate(var(--ms-r)); }
		35%, 87.5% { opacity: 1; transform: translate(0, 0) rotate(0deg); }
		100% { opacity: 0; transform: translate(0, 0) rotate(0deg); }
	}

	@keyframes ms-tick {
		0%, 10% { opacity: 0; transform: scale(.6); }
		20%, 87.5% { opacity: 1; transform: scale(1); }
		100% { opacity: 0; transform: scale(.6); }
	}

	@keyframes ms-report {
		0%, 36.6% { opacity: 0; }
		42%, 87.5% { opacity: 1; }
		100% { opacity: 0; }
	}

	@keyframes ms-bar {
		0%, 40% { opacity: 0; transform: scaleY(0); }
		45%, 87.5% { opacity: 1; transform: scaleY(1); }
		100% { opacity: 0; transform: scaleY(0); }
	}

	@keyframes ms-attn {
		0%, 58.3% { opacity: 0; transform: scale(.5); }
		61% { opacity: 1; transform: scale(1.18); }
		64%, 87.5% { opacity: 1; transform: scale(1); }
		100% { opacity: 0; transform: scale(1); }
	}

	.ms-paused .ms-slip,
	.ms-paused .ms-tick,
	.ms-paused .ms-report,
	.ms-paused .ms-bar,
	.ms-paused .ms-attn-dot,
	.ms-paused .ms-ticker-track { animation-play-state: paused; }

	.ms-ticker-wrap {
		position: relative;
		z-index: 2;
		max-width: var(--container-inner);
		margin: clamp(2rem, 4vw, 3.5rem) auto 0;
		padding-inline: 24px;
		overflow: hidden;
	}

	.ms-ticker {
		overflow: hidden;
		border-top: 1px solid color-mix(in srgb, var(--kt-cream) 22%, transparent);
		padding-top: 1rem;
		color: color-mix(in srgb, var(--kt-cream) 70%, transparent);
		font: .72rem var(--font-mono);
		white-space: nowrap;
	}

	.ms-ticker-track {
		display: flex;
		width: max-content;
		animation: ms-ticker 40s linear infinite;
	}

	.ms-ticker-row {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 1rem;
		padding-right: 1rem;
	}

	.ms-ticker i { width: 4px; height: 4px; border-radius: 50%; background: var(--ms-tick); flex: none; }

	@keyframes ms-ticker { to { transform: translateX(-50%); } }

	@media (max-width: 899px) {
		.ms-hero-panel { padding: 2.5rem 0 2rem; }
		.ms-hero-grid { grid-template-columns: 1fr; min-height: 0; padding-inline: 20px; }
		.ms-ticker-wrap { padding-inline: 20px; }
		.ms-hero-scene { max-width: calc(100% + 1.5rem); margin: 0 -1.5rem -2rem 0; }
		.ms-hero-svg { width: 100%; }
	}

	@media (min-width: 640px) and (max-width: 899px) {
		.ms-hero-scene {
			width: min(100%, 520px);
			max-width: none;
			margin: 0 0 -2rem;
		}
	}

	@media (max-width: 639px) {
		.ms-scene-desktop { display: none; }
		.ms-scene-mobile { display: block; }
	}

	@media (max-width: 560px) {
		.ms-hero h1 { font-size: clamp(2.25rem, 9.5vw, 3rem); }
		.ms-hero-scene { margin-right: -2.5rem; }
	}

	@media (prefers-reduced-motion: reduce) {
		.ms-slip,
		.ms-tick,
		.ms-report,
		.ms-bar,
		.ms-attn-dot,
		.ms-ticker-track,
		.ms-hero-primary,
		.ms-hero-secondary { animation: none; transition: none; }
		.ms-slip { opacity: 1; transform: translate(0, 0) rotate(0deg); }
		.ms-tick { opacity: 1; transform: scale(1); }
		.ms-report { opacity: 1; }
		.ms-bar { opacity: 1; transform: scaleY(1); }
		.ms-attn-dot { opacity: 1; transform: scale(1); }
		.ms-ticker { white-space: normal; }
		.ms-ticker-track { width: 100%; flex-wrap: wrap; row-gap: .5rem; }
		.ms-ticker-row { padding-right: 0; }
		.ms-ticker-row[aria-hidden='true'] { display: none; }
	}

	:global(html[data-fx='lite']) .ms-slip,
	:global(html[data-fx='lite']) .ms-tick,
	:global(html[data-fx='lite']) .ms-report,
	:global(html[data-fx='lite']) .ms-bar,
	:global(html[data-fx='lite']) .ms-attn-dot,
	:global(html[data-fx='lite']) .ms-ticker-track { animation: none; }

	:global(html[data-fx='lite']) .ms-slip { opacity: 1; transform: translate(0, 0) rotate(0deg); }
	:global(html[data-fx='lite']) .ms-tick { opacity: 1; transform: scale(1); }
	:global(html[data-fx='lite']) .ms-report { opacity: 1; }
	:global(html[data-fx='lite']) .ms-bar { opacity: 1; transform: scaleY(1); }
	:global(html[data-fx='lite']) .ms-attn-dot { opacity: 1; transform: scale(1); }
	:global(html[data-fx='lite']) .ms-ticker { white-space: normal; }
	:global(html[data-fx='lite']) .ms-ticker-track { width: 100%; flex-wrap: wrap; row-gap: .5rem; }
	:global(html[data-fx='lite']) .ms-ticker-row { padding-right: 0; }
	:global(html[data-fx='lite']) .ms-ticker-row[aria-hidden='true'] { display: none; }
</style>
