		<p class="ms-ind-end">Not on the list? The same shape fits any organisation that runs on records, roles, reports and approvals. <a href="/quote" data-quote data-quote-topic="Management systems">Tell us how yours works</a></p>
	</div>
</section>

<style>
	.ms-ind-section {
		scroll-margin-top: var(--header-h, 76px);
		padding-block: clamp(2.75rem, 4.5vw, 4rem);
		background: var(--color-bg);
		color: var(--ms-soft-text);
	}

	.ms-ind-inner {
		width: min(calc(100% - 48px), var(--container-inner));
		margin-inline: auto;
	}

	.ms-ind-head {
		max-width: 40rem;
		margin-inline: auto;
		text-align: center;
	}

	.ms-ind-eyebrow {
		margin: 0 0 1rem;
		color: var(--ms-soft-accent);
		font: 500 .75rem/1.2 var(--font-mono);
		letter-spacing: .14em;
		text-transform: uppercase;
	}

	.ms-ind-eyebrow::before {
		display: inline-block;
		width: 2rem;
		height: 2px;
		margin-right: .65rem;
		vertical-align: middle;
		background: var(--kt-clay);
		content: '';
	}

	.ms-ind-head h2 {
		margin: 0;
		color: var(--ms-soft-text);
		font: 600 clamp(2rem, 4.5vw, 3rem)/1.08 var(--font-heading);
		letter-spacing: -.03em;
	}

	.ms-ind-strong,
	.ms-ind-soft { display: block; }
	.ms-ind-soft { color: var(--ms-soft-muted); font-weight: 400; }

	.ms-ind-intro {
		margin: 1.5rem 0 0;
		color: var(--ms-soft-muted);
		font-size: var(--fs-lead);
		line-height: 1.6;
	}

	.ms-ind {
		position: relative;
		min-width: 0;
		margin: clamp(2rem, 4vw, 3rem) 0 0;
		padding: 0;
		border: 0;
	}

	.ms-ind-sr,
	.ms-ind-input {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
		border: 0;
	}

	.ms-ind-track {
		position: relative;
		display: grid;
		grid-template-columns: repeat(5, minmax(0, 1fr));
		gap: 0;
		padding: 4px;
		background: var(--ms-tab-track);
		border: 1px solid var(--ms-soft-border);
		border-radius: 999px;
	}

	.ms-ind-thumb {
		position: absolute;
		left: 4px;
		top: 4px;
		bottom: 4px;
		width: calc((100% - 8px) / 5);
		border-radius: 999px;
		background: var(--ms-tab-thumb);
		transform: translateX(calc(var(--i, 0) * 100%));
		transition: transform .35s cubic-bezier(.2, .7, .2, 1);
	}

	.ms-ind-label {
		position: relative;
		z-index: 1;
		display: grid;
		place-items: center;
		min-height: 48px;
		padding: .5rem .25rem;
		border-radius: 999px;
		color: var(--ms-soft-muted);
		font: 500 .75rem/1.2 var(--font-mono);
		letter-spacing: .12em;
		text-transform: uppercase;
		text-align: center;
		cursor: pointer;
	}

	#ms-ind-farms:checked ~ .ms-ind-track .ms-ind-thumb { --i: 0; }
	#ms-ind-schools:checked ~ .ms-ind-track .ms-ind-thumb { --i: 1; }
	#ms-ind-clinics:checked ~ .ms-ind-track .ms-ind-thumb { --i: 2; }
	#ms-ind-shops:checked ~ .ms-ind-track .ms-ind-thumb { --i: 3; }
	#ms-ind-logistics:checked ~ .ms-ind-track .ms-ind-thumb { --i: 4; }

	#ms-ind-farms:checked ~ .ms-ind-track .ms-ind-label[for='ms-ind-farms'],
