<section id="ms-industries" class="ms-ind-section" aria-labelledby="ms-industries-title">
	<div class="ms-ind-inner">
		<div class="ms-ind-head ms-rise">
			<p class="ms-ind-eyebrow">Your sector, in your words</p>
			<h2 id="ms-industries-title"><span class="ms-ind-strong">The same foundation,</span><span class="ms-ind-soft">in your own language.</span></h2>
			<p class="ms-ind-intro">Every organisation runs on records, roles, reports and approvals. Choose a sector to see how the same system takes its shape.</p>
		</div>

		<fieldset class="ms-ind">
			<legend class="ms-ind-sr">Choose a sector</legend>

			<input type="radio" name="ms-industry" id="ms-ind-farms" class="ms-ind-input" checked />
			<input type="radio" name="ms-industry" id="ms-ind-schools" class="ms-ind-input" />
			<input type="radio" name="ms-industry" id="ms-ind-clinics" class="ms-ind-input" />
			<input type="radio" name="ms-industry" id="ms-ind-shops" class="ms-ind-input" />
			<input type="radio" name="ms-industry" id="ms-ind-logistics" class="ms-ind-input" />

			<div class="ms-ind-track">
				<span class="ms-ind-thumb" aria-hidden="true"></span>
				<label class="ms-ind-label" for="ms-ind-farms">Farms</label>
				<label class="ms-ind-label" for="ms-ind-schools">Schools</label>
				<label class="ms-ind-label" for="ms-ind-clinics">Clinics</label>
				<label class="ms-ind-label" for="ms-ind-shops">Shops</label>
				<label class="ms-ind-label" for="ms-ind-logistics">Logistics</label>
			</div>

			<div class="ms-ind-screen ms-scale-in">
				<div class="ms-ind-stage">
					<article class="ms-ind-panel" data-panel="farms">
						<div class="ms-ind-top">
							<h3 class="ms-ind-title">Farm system</h3>
							<span class="ms-ind-chip ms-ind-chip-filled">Built and in use at Bluelite</span>
						</div>
						<div class="ms-ind-body">
							<div class="ms-ind-figure">
								<div class="ms-ind-scene ms-scene-farms">
									<p class="ms-scene-title">Flock board</p>
									<div class="ms-farm-grid">
										<div class="ms-farm-tile ms-anim" style="--delay:.05s"><span class="ms-farm-pen">Pen 1</span><span class="ms-farm-count">1,200</span><span class="ms-farm-day">Day 14</span><span class="ms-farm-bar"><i class="ms-anim" style="--pct:33%; --delay:.18s"></i></span></div>
										<div class="ms-farm-tile ms-anim" style="--delay:.10s"><span class="ms-farm-pen">Pen 2</span><span class="ms-farm-count">1,180</span><span class="ms-farm-day">Day 14</span><span class="ms-farm-bar"><i class="ms-anim" style="--pct:33%; --delay:.23s"></i></span></div>
										<div class="ms-farm-tile ms-anim" style="--delay:.15s"><span class="ms-farm-pen">Pen 3</span><span class="ms-farm-count">1,240</span><span class="ms-farm-day">Day 9</span><span class="ms-farm-bar"><i class="ms-anim" style="--pct:21%; --delay:.28s"></i></span></div>
										<div class="ms-farm-tile ms-anim" style="--delay:.20s"><span class="ms-farm-pen">Pen 4</span><span class="ms-farm-count">1,150</span><span class="ms-farm-day">Day 9</span><span class="ms-farm-bar"><i class="ms-anim" style="--pct:21%; --delay:.33s"></i></span></div>
										<div class="ms-farm-tile ms-anim" style="--delay:.25s"><span class="ms-farm-pen">Pen 5</span><span class="ms-farm-count">1,210</span><span class="ms-farm-day">Day 21</span><span class="ms-farm-bar"><i class="ms-anim" style="--pct:50%; --delay:.38s"></i></span></div>
										<div class="ms-farm-tile ms-anim" style="--delay:.30s"><span class="ms-farm-pen">Pen 6</span><span class="ms-farm-count">1,190</span><span class="ms-farm-day">Day 21</span><span class="ms-farm-bar"><i class="ms-anim" style="--pct:50%; --delay:.43s"></i></span></div>
									</div>
									<div class="ms-be-row">
										<span class="ms-be-label">Break-even</span>
										<span class="ms-be-track"><i class="ms-anim" style="--pct:64%; --delay:.5s"></i><span class="ms-be-chip ms-anim" style="--delay:.58s">Covered</span></span>
									</div>
								</div>
								<p class="ms-ind-caption">Sample view</p>
							</div>
							<div class="ms-ind-list">
								<div class="ms-ind-item"><p class="ms-ind-item-label">Flocks</p><p class="ms-ind-item-text">Every pen and batch counted, from the first day to the last.</p></div>
								<div class="ms-ind-item"><p class="ms-ind-item-label">Daily records</p><p class="ms-ind-item-text">Staff record on the phone, even without a connection, and it syncs when they are back online.</p></div>
								<div class="ms-ind-item"><p class="ms-ind-item-label">Break-even</p><p class="ms-ind-item-text">See the price that covers your costs, and try different prices before you set one.</p></div>
								<div class="ms-ind-item"><p class="ms-ind-item-label">Closing a batch</p><p class="ms-ind-item-text">Only the manager closes a batch, so the final figures are settled.</p></div>
							</div>
						</div>
					</article>

					<article class="ms-ind-panel" data-panel="schools">
