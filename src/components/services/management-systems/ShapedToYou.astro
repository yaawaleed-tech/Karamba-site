---
---

<section id="ms-shape" class="ms-shape" aria-labelledby="ms-shape-title">
	<div class="ms-shape-inner">
		<div class="ms-shape-head ms-rise">
			<p class="ms-shape-eyebrow">Ready and shaped</p>
			<h2 id="ms-shape-title"><span class="ms-shape-strong">A ready foundation,</span><span class="ms-shape-soft">shaped around you.</span></h2>
			<p class="ms-shape-intro">Start from what every organisation needs, then add what only you need.</p>
		</div>

		<div class="ms-shape-grid">
			<input type="checkbox" id="ms-shape-toggle" class="ms-shape-input" />

			<label class="ms-shape-toggle" for="ms-shape-toggle">
				<span class="ms-shape-plus" aria-hidden="true"></span>
				<span class="ms-shape-add" aria-hidden="true">Add your shape</span>
				<span class="ms-shape-back" aria-hidden="true">Back to the foundation</span>
				<span class="ms-shape-sr">Show the version shaped to you</span>
			</label>

			<div class="ms-shape-stage ms-scale-in">
				<div class="ms-shape-block ms-block-records">
					<svg class="ms-block-icon" viewBox="0 0 24 24" fill="none" stroke="var(--ms-soft-accent)" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
						<rect x="4" y="6" width="16" height="3" rx="1.5" />
						<rect x="4" y="11" width="16" height="3" rx="1.5" />
						<rect x="4" y="16" width="12" height="3" rx="1.5" />
					</svg>
					<span class="ms-block-label">Records</span>
					<span class="ms-block-sub">Your fields</span>
					<span class="ms-block-frame" aria-hidden="true"></span>
					<span class="ms-block-chip" aria-hidden="true">1</span>
				</div>
				<div class="ms-shape-block ms-block-roles">
					<svg class="ms-block-icon" viewBox="0 0 24 24" fill="none" stroke="var(--ms-soft-accent)" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
						<circle cx="12" cy="8" r="3.5" />
						<path d="M5 20 a7 7 0 0 1 14 0" />
					</svg>
					<span class="ms-block-label">Roles</span>
					<span class="ms-block-sub">Your roles</span>
					<span class="ms-block-frame" aria-hidden="true"></span>
					<span class="ms-block-chip" aria-hidden="true">2</span>
				</div>
				<div class="ms-shape-block ms-block-summaries">
					<svg class="ms-block-icon" viewBox="0 0 24 24" fill="none" stroke="var(--ms-soft-accent)" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
						<rect x="5" y="12" width="3" height="7" />
						<rect x="10.5" y="8" width="3" height="11" />
						<rect x="16" y="4" width="3" height="15" />
					</svg>
					<span class="ms-block-label">Summaries</span>
					<span class="ms-block-sub">Your reports</span>
					<span class="ms-block-frame" aria-hidden="true"></span>
					<span class="ms-block-chip" aria-hidden="true">3</span>
				</div>
				<div class="ms-shape-block ms-block-access">
					<svg class="ms-block-icon" viewBox="0 0 24 24" fill="none" stroke="var(--ms-soft-accent)" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
						<rect x="5" y="11" width="14" height="9" rx="2" />
						<path d="M8 11 V8 a4 4 0 0 1 8 0 V11" />
					</svg>
					<span class="ms-block-label">Sign-in and access</span>
				</div>
				<div class="ms-shape-block ms-block-devices">
					<svg class="ms-block-icon" viewBox="0 0 24 24" fill="none" stroke="var(--ms-soft-accent)" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
						<rect x="3" y="5" width="13" height="9" rx="1.5" />
						<path d="M6 17 H13" />
						<rect x="17" y="9" width="4" height="8" rx="1" />
					</svg>
					<span class="ms-block-label">Phone and computer</span>
				</div>
				<div class="ms-shape-block ms-block-slot">
					<span class="ms-slot-ready" aria-hidden="true">
						<svg class="ms-block-icon" viewBox="0 0 24 24" fill="none" stroke="var(--ms-soft-accent)" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="8" /><path d="M8 12 l3 3 l5 -6" /></svg>
						<span class="ms-block-label">Room for your steps</span>
					</span>
					<span class="ms-slot-filled">
						<svg class="ms-block-icon" viewBox="0 0 24 24" fill="none" stroke="var(--ms-soft-accent)" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="8" /><path d="M8 12 l3 3 l5 -6" /></svg>
						<span class="ms-block-label">Your approval steps</span>
					</span>
					<span class="ms-block-chip" aria-hidden="true">4</span>
				</div>
			</div>

			<div class="ms-shape-panels">
				<div class="ms-shape-panel ms-panel-ready">
					<h3 class="ms-shape-panel-title">Ready from day one</h3>
					<p class="ms-shape-panel-intro">We start from a ready foundation, so the parts every organisation needs are already in place.</p>
					<ul class="ms-shape-list">
						<li>Sign-in and secure access for every person</li>
						<li>Roles, so each person sees their own part</li>
						<li>Records with a note of who recorded each entry</li>
						<li>Summaries and totals that update as you work</li>
						<li>Screens that work on a phone and a computer</li>
					</ul>
				</div>
				<div class="ms-shape-panel ms-panel-shaped">
					<h3 class="ms-shape-panel-title">Shaped to you</h3>
					<p class="ms-shape-panel-intro">Then we shape it around how your organisation actually works, so it feels like yours from the first day.</p>
					<ol class="ms-shape-numbered">
						<li><span class="ms-list-chip" aria-hidden="true">1</span><span>Your fields and forms, in your own words</span></li>
						<li><span class="ms-list-chip" aria-hidden="true">2</span><span>Your roles, from the owner to every member of staff</span></li>
						<li><span class="ms-list-chip" aria-hidden="true">3</span><span>Your reports, in the figures you decide with</span></li>
						<li><span class="ms-list-chip" aria-hidden="true">4</span><span>Your approval steps, exactly where you need them</span></li>
					</ol>
				</div>
			</div>
		</div>

		<div class="ms-rollout ms-rise">
			<p class="ms-rollout-label">How it rolls out</p>
			<div class="ms-rollout-steps">
				<span class="ms-rollout-line" aria-hidden="true"><i></i><i></i></span>
				<div class="ms-rollout-step ms-rise">
					<span class="ms-rollout-node" aria-hidden="true">1</span>
					<h3 class="ms-rollout-title">Agree the shape</h3>
					<p class="ms-rollout-text">We learn how you work and settle your records, roles, reports and approvals together.</p>
					<span class="ms-rollout-connector" aria-hidden="true"></span>
				</div>
				<div class="ms-rollout-step ms-rise ms-rise-d1">
					<span class="ms-rollout-node" aria-hidden="true">2</span>
					<h3 class="ms-rollout-title">Build on the foundation</h3>
					<p class="ms-rollout-text">We shape the ready foundation around you and show you progress as we go.</p>
					<span class="ms-rollout-connector" aria-hidden="true"></span>
				</div>
				<div class="ms-rollout-step ms-rise ms-rise-d2">
					<span class="ms-rollout-node" aria-hidden="true">3</span>
					<h3 class="ms-rollout-title">Launch and look after it</h3>
					<p class="ms-rollout-text">We help your team get started, and support is available after launch.</p>
				</div>
			</div>
		</div>
	</div>
</section>

<style>
	.ms-shape {
		scroll-margin-top: var(--header-h, 76px);
		padding-block: clamp(2.75rem, 4.5vw, 4rem);
		background: var(--color-bg);
		color: var(--ms-soft-text);
	}

	.ms-shape-inner { width: min(calc(100% - 48px), var(--container-inner)); margin-inline: auto; }

	.ms-shape-head { max-width: 44rem; }

	.ms-shape-eyebrow {
		margin: 0 0 1rem;
		color: var(--ms-soft-accent);
		font: 500 .75rem/1.2 var(--font-mono);
		letter-spacing: .14em;
		text-transform: uppercase;
	}
	.ms-shape-eyebrow::before {
		display: inline-block;
		width: 2rem;
		height: 2px;
		margin-right: .65rem;
		vertical-align: middle;
		background: var(--kt-clay);
		content: '';
	}

	.ms-shape h2 {
		margin: 0;
		font: 600 clamp(2rem, 4.5vw, 3rem)/1.08 var(--font-heading);
		letter-spacing: -.03em;
	}
	.ms-shape-strong, .ms-shape-soft { display: block; }
	.ms-shape-soft { color: var(--ms-soft-muted); font-weight: 400; }

	.ms-shape-intro {
		margin: 1.5rem 0 0;
		max-width: 34rem;
		color: var(--ms-soft-muted);
		font-size: var(--fs-lead);
		line-height: 1.6;
	}

	.ms-shape-grid {
		display: grid;
		margin-top: clamp(2rem, 4vw, 3rem);
	}

	.ms-shape-sr {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
		border: 0;
	}

	.ms-shape-input {
		grid-area: 1 / 1;
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
		border: 0;
	}

	.ms-shape-toggle {
		grid-area: toggle;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: .75rem;
		min-height: 3rem;
		padding: 0 1.5rem;
		border: 1px solid var(--ms-soft-border);
		border-radius: 999px;
		background: var(--ms-tab-thumb);
		color: var(--ms-tab-thumb-text);
		font: 500 .8rem/1.2 var(--font-mono);
		letter-spacing: .12em;
		text-transform: uppercase;
		cursor: pointer;
		justify-self: start;
	}

	.ms-shape-plus {
		position: relative;
		width: 14px;
		height: 14px;
		flex: none;
		transform: rotate(0deg);
		transition: transform .3s ease;
	}
	.ms-shape-plus::before,
	.ms-shape-plus::after { content: ''; position: absolute; background: currentColor; }
	.ms-shape-plus::before { left: 0; right: 0; top: 6px; height: 2px; }
	.ms-shape-plus::after { top: 0; bottom: 0; left: 6px; width: 2px; }

	.ms-shape-back { display: none; }
	.ms-shape-input:checked ~ .ms-shape-toggle .ms-shape-add { display: none; }
	.ms-shape-input:checked ~ .ms-shape-toggle .ms-shape-back { display: inline; }
	.ms-shape-input:checked ~ .ms-shape-toggle .ms-shape-plus { transform: rotate(45deg); }
	.ms-shape-input:focus-visible + .ms-shape-toggle { outline: 2px solid var(--ms-soft-accent); outline-offset: 3px; }

	.ms-shape-stage {
		grid-area: stage;
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		grid-template-rows: repeat(3, minmax(0, 1fr));
		gap: 12px;
		min-width: 0;
		padding: 20px;
		border: 1px solid var(--ms-soft-border);
		border-radius: 1.5rem;
		background: var(--ms-soft-bg);
	}

	.ms-shape-block {
		position: relative;
		min-width: 0;
		min-height: 104px;
		padding: 14px;
		border: 1px solid var(--ms-soft-tile-border);
		border-radius: 1rem;
		background: var(--ms-soft-tile);
		transition: opacity .2s ease;
	}

	.ms-block-icon { display: block; width: 24px; height: 24px; }
	.ms-block-label {
		position: absolute;
		left: 14px;
		bottom: 12px;
		max-width: calc(100% - 28px);
		color: var(--ms-soft-text);
		font: 400 .95rem/1.2 var(--font-body);
	}

	.ms-block-sub {
		position: absolute;
		left: 14px;
		bottom: 12px;
		opacity: 0;
		color: var(--ms-soft-accent);
		font: 500 .68rem/1.2 var(--font-mono);
		letter-spacing: .12em;
		text-transform: uppercase;
		transition: opacity .2s ease;
	}
	.ms-shape-input:checked ~ .ms-shape-stage .ms-block-records .ms-block-label,
	.ms-shape-input:checked ~ .ms-shape-stage .ms-block-roles .ms-block-label,
	.ms-shape-input:checked ~ .ms-shape-stage .ms-block-summaries .ms-block-label { opacity: 0; }
	.ms-shape-input:checked ~ .ms-shape-stage .ms-block-records .ms-block-sub,
	.ms-shape-input:checked ~ .ms-shape-stage .ms-block-roles .ms-block-sub,
	.ms-shape-input:checked ~ .ms-shape-stage .ms-block-summaries .ms-block-sub { opacity: 1; }

	.ms-block-frame {
		position: absolute;
		inset: -4px;
		border: 1.5px dashed var(--ms-soft-accent);
		border-radius: 1.25rem;
		opacity: 0;
		transform: scale(.94);
		pointer-events: none;
		transition: opacity .2s ease, transform .2s ease;
	}
	.ms-block-chip,
	.ms-list-chip {
		display: inline-grid;
		place-items: center;
		width: 22px;
		height: 22px;
		flex: none;
		border-radius: 50%;
		background: var(--ms-soft-accent);
		color: var(--ms-tab-thumb-text);
		font: 500 .72rem/1 var(--font-mono);
	}
	.ms-block-chip {
		position: absolute;
		top: -10px;
		right: -10px;
		opacity: 0;
		transform: scale(.6);
		transition: opacity .2s ease, transform .2s ease;
	}

	.ms-shape-input:checked ~ .ms-shape-stage .ms-block-records .ms-block-frame,
	.ms-shape-input:checked ~ .ms-shape-stage .ms-block-roles .ms-block-frame,
	.ms-shape-input:checked ~ .ms-shape-stage .ms-block-summaries .ms-block-frame { opacity: 1; transform: none; }
	.ms-shape-input:checked ~ .ms-shape-stage .ms-block-records .ms-block-chip,
	.ms-shape-input:checked ~ .ms-shape-stage .ms-block-roles .ms-block-chip,
	.ms-shape-input:checked ~ .ms-shape-stage .ms-block-summaries .ms-block-chip,
	.ms-shape-input:checked ~ .ms-shape-stage .ms-block-slot .ms-block-chip { opacity: 1; transform: scale(1); }

	.ms-shape-input:checked ~ .ms-shape-stage .ms-block-records .ms-block-frame { transition-duration: .35s; transition-delay: 0s; }
	.ms-shape-input:checked ~ .ms-shape-stage .ms-block-roles .ms-block-frame { transition-duration: .35s; transition-delay: .08s; }
	.ms-shape-input:checked ~ .ms-shape-stage .ms-block-summaries .ms-block-frame { transition-duration: .35s; transition-delay: .16s; }
	.ms-shape-input:checked ~ .ms-shape-stage .ms-block-records .ms-block-chip { transition-delay: 0s; }
	.ms-shape-input:checked ~ .ms-shape-stage .ms-block-roles .ms-block-chip { transition-delay: .08s; }
	.ms-shape-input:checked ~ .ms-shape-stage .ms-block-summaries .ms-block-chip { transition-delay: .16s; }
	.ms-shape-input:checked ~ .ms-shape-stage .ms-block-slot .ms-block-chip { transition-delay: .24s; }

	.ms-shape-input:checked ~ .ms-shape-stage .ms-block-access,
	.ms-shape-input:checked ~ .ms-shape-stage .ms-block-devices { opacity: .95; }

	.ms-slot-ready,
	.ms-slot-filled { position: absolute; inset: 0; padding: 14px; }
	.ms-slot-ready { opacity: 1; border: 1.5px dashed var(--ms-soft-tile-border); border-radius: 1rem; transition: opacity .2s ease; }
	.ms-slot-ready .ms-block-icon { opacity: .5; }
	.ms-slot-ready .ms-block-label { left: 14px; bottom: 12px; color: var(--ms-soft-muted); }
	.ms-slot-filled {
		opacity: 0;
		border: 1px solid var(--ms-soft-tile-border);
		border-radius: 1rem;
		background: var(--ms-soft-tile);
		transition: opacity .2s ease;
	}
	.ms-shape-input:checked ~ .ms-shape-stage .ms-block-slot .ms-slot-filled { opacity: 1; transition-duration: .35s; transition-delay: .32s; }
	.ms-shape-input:checked ~ .ms-shape-stage .ms-block-slot .ms-slot-ready { opacity: 0; transition-delay: .32s; }
	.ms-slot-filled .ms-block-label { left: 14px; bottom: 12px; color: var(--ms-soft-accent); font-family: var(--font-mono); font-size: .68rem; letter-spacing: .12em; text-transform: uppercase; }

	.ms-shape-panels { grid-area: panels; display: grid; min-width: 0; align-self: end; }
	.ms-shape-panel {
		grid-area: 1 / 1;
		min-width: 0;
		opacity: 0;
		visibility: hidden;
		pointer-events: none;
		transform: translateY(8px);
		transition: opacity .3s ease, transform .3s ease, visibility 0s linear .3s;
	}
	.ms-shape-input:checked ~ .ms-shape-panels .ms-panel-ready,
	.ms-shape-input:not(:checked) ~ .ms-shape-panels .ms-panel-shaped { opacity: 0; visibility: hidden; }
	.ms-shape-input:not(:checked) ~ .ms-shape-panels .ms-panel-ready,
	.ms-shape-input:checked ~ .ms-shape-panels .ms-panel-shaped {
		opacity: 1;
		visibility: visible;
		pointer-events: auto;
		transform: none;
		transition-delay: 0s, 0s, 0s;
	}

	.ms-shape-panel-title {
		margin: 0;
		color: var(--ms-soft-text);
		font: 600 clamp(1.75rem, 3vw, 2.5rem)/1.15 var(--font-heading);
		letter-spacing: -.02em;
	}
	.ms-shape-panel-intro {
		margin: 1rem 0 0;
		color: var(--ms-soft-muted);
		font: 400 1.0625rem/1.6 var(--font-body);
	}
	.ms-shape-list,
	.ms-shape-numbered { list-style: none; margin: 1.5rem 0 0; padding: 0; display: grid; gap: .85rem; }
	.ms-shape-list li {
		display: grid;
		grid-template-columns: 8px minmax(0, 1fr);
		gap: .75rem;
		align-items: baseline;
		color: var(--ms-soft-text);
		font: 400 1rem/1.5 var(--font-body);
	}
	.ms-shape-list li::before { content: ''; width: 8px; height: 8px; border-radius: 50%; background: var(--ms-soft-accent); }
	.ms-shape-numbered li { display: flex; gap: .75rem; align-items: flex-start; color: var(--ms-soft-text); font: 400 1rem/1.5 var(--font-body); }

	.ms-rollout { margin-top: clamp(3rem, 6vw, 5rem); }
	.ms-rollout-label {
		margin: 0 0 1.5rem;
		color: var(--ms-soft-accent);
		font: 500 .75rem/1.2 var(--font-mono);
		letter-spacing: .14em;
		text-transform: uppercase;
	}
	.ms-rollout-steps { --rollout-gap: 2rem; position: relative; display: grid; }
	.ms-rollout-line { position: absolute; inset: 0; pointer-events: none; }
	.ms-rollout-line i { position: absolute; top: 20px; height: 1.5px; background: var(--ms-soft-accent); transform: scaleX(0); transform-origin: left center; transition: transform .8s ease-out; }
	html.ms-js .ms-rollout.is-in .ms-rollout-line i { transform: scaleX(1); }
	.ms-rollout-step { position: relative; min-width: 0; }
	.ms-rollout-node {
		display: grid;
		place-items: center;
		width: 2.5rem;
		height: 2.5rem;
		border: 1.5px solid var(--ms-soft-accent);
		border-radius: 50%;
		background: var(--color-bg);
		color: var(--ms-soft-accent);
		font: 500 .9rem/1 var(--font-mono);
	}
	.ms-rollout-title { margin: 1rem 0 .5rem; color: var(--ms-soft-text); font: 600 1.35rem/1.2 var(--font-heading); }
	.ms-rollout-text { margin: 0; color: var(--ms-soft-muted); font: 400 1rem/1.6 var(--font-body); }
	.ms-rollout-connector { display: none; }

	@media (min-width: 1000px) {
		.ms-shape-grid {
			grid-template-columns: minmax(0, 1.1fr) minmax(0, .9fr);
			grid-template-areas: 'stage panels' 'stage toggle';
			column-gap: 4rem;
		}
		.ms-shape-panels { align-self: end; }
		.ms-shape-toggle { align-self: start; margin-top: 1.5rem; }
	}

	@media (max-width: 999px) {
		.ms-shape-grid {
			grid-template-columns: minmax(0, 1fr);
			grid-template-areas: 'toggle' 'stage' 'panels';
			gap: 1.5rem;
		}
	}

	@media (min-width: 800px) {
		.ms-rollout-steps { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--rollout-gap); }
		.ms-rollout-line i:first-child { left: 20px; width: calc((100% - 2 * var(--rollout-gap)) / 3 + var(--rollout-gap)); }
		.ms-rollout-line i:last-child { left: calc(20px + (100% - 2 * var(--rollout-gap)) / 3 + var(--rollout-gap)); width: calc((100% - 2 * var(--rollout-gap)) / 3 + var(--rollout-gap)); }
		.ms-rollout-connector { display: none; }
	}

	@media (max-width: 799px) {
		.ms-rollout-line { display: none; }
		.ms-rollout-step:not(:last-child)::before { display: none; }
		.ms-rollout-steps { grid-template-columns: minmax(0, 1fr); }
		.ms-rollout-step { display: grid; grid-template-columns: 2.5rem minmax(0, 1fr); column-gap: 1rem; }
		.ms-rollout-node { grid-column: 1; grid-row: 1; position: relative; z-index: 1; }
		.ms-rollout-title {
			grid-column: 2;
			grid-row: 1;
			min-height: 2.5rem;
			display: flex;
			align-items: center;
			margin: 0;
		}
		.ms-rollout-text { grid-column: 2; grid-row: 2; margin: .25rem 0 2rem; }
		.ms-rollout-step:last-child .ms-rollout-text { margin-bottom: 0; }
		.ms-rollout-connector {
			display: block;
			grid-column: 1;
			grid-row: 2;
			justify-self: center;
			align-self: stretch;
			width: 1.5px;
