---
---

<section id="ms-parts" class="ms-parts" aria-labelledby="ms-parts-title">
	<div class="ms-parts-inner">
		<div class="ms-parts-layout">
			<div class="ms-parts-intro">
				<p class="ms-parts-eyebrow ms-rise">The four moving parts</p>
				<h2 id="ms-parts-title" class="ms-rise ms-rise-d1"><span class="ms-parts-strong">Every organisation asks</span><span class="ms-parts-soft">the same four questions.</span></h2>
				<p class="ms-parts-lede ms-rise ms-rise-d2">Whatever you run, the work comes down to four things. We build the system around them, then shape each one to how you actually work.</p>
				<nav class="ms-parts-index ms-rise ms-rise-d3" aria-label="The four moving parts">
					<p class="ms-parts-jump">Jump to</p>
					<a href="#ms-part-records">01 Records</a>
					<a href="#ms-part-roles">02 Roles</a>
					<a href="#ms-part-reports">03 Reports</a>
					<a href="#ms-part-approvals">04 Approvals</a>
				</nav>
			</div>

			<ol class="ms-parts-list">
				<li class="ms-part ms-fade" id="ms-part-records">
					<span class="ms-part-rule" aria-hidden="true"></span>
					<div class="ms-part-grid">
						<span class="ms-part-num" aria-hidden="true">01</span>
						<div class="ms-part-content">
							<div class="ms-part-main">
								<div class="ms-part-copy">
									<p class="ms-part-label">Records</p>
									<h3 class="ms-part-q">Where is it?</h3>
									<p class="ms-part-answer">Every person, product, batch or order lives in one place, with a note of who recorded each entry.</p>
								</div>
								<svg class="ms-part-diagram" viewBox="0 0 160 100" fill="none" stroke="var(--ms-soft-accent)" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
									<rect class="ms-d-rec" x="20" y="10" width="100" height="60" rx="8" />
									<rect class="ms-d-rec" x="30" y="20" width="100" height="60" rx="8" />
									<rect class="ms-d-rec" x="40" y="30" width="100" height="60" rx="8" />
									<rect class="ms-d-line" x="54" y="46" width="60" height="4" rx="2" fill="var(--ms-soft-accent)" stroke="none" />
									<rect class="ms-d-line" x="54" y="56" width="46" height="4" rx="2" fill="var(--ms-soft-accent)" stroke="none" />
									<rect class="ms-d-line" x="54" y="66" width="52" height="4" rx="2" fill="var(--ms-soft-accent)" stroke="none" />
								</svg>
							</div>
							<dl class="ms-part-trio">
								<div><dt>You get</dt><dd>One searchable home for your records</dd></div>
								<div><dt>What it means for you</dt><dd>No more hunting through notebooks, chats and sheets</dd></div>
								<div><dt>Replaces</dt><dd>Paper files and scattered spreadsheets</dd></div>
							</dl>
						</div>
					</div>
				</li>

				<li class="ms-part ms-fade" id="ms-part-roles">
					<span class="ms-part-rule" aria-hidden="true"></span>
					<div class="ms-part-grid">
						<span class="ms-part-num" aria-hidden="true">02</span>
						<div class="ms-part-content">
							<div class="ms-part-main">
								<div class="ms-part-copy">
									<p class="ms-part-label">Roles</p>
									<h3 class="ms-part-q">Who can see it?</h3>
									<p class="ms-part-answer">Each person signs in and sees only the part of the work that is theirs, from the owner to the newest member of staff.</p>
								</div>
								<svg class="ms-part-diagram" viewBox="0 0 160 100" fill="none" stroke="var(--ms-soft-accent)" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
									<circle class="ms-d-person" cx="30" cy="16" r="8" />
									<circle class="ms-d-person" cx="80" cy="16" r="8" />
									<circle class="ms-d-person" cx="130" cy="16" r="8" />
									<rect class="ms-d-bar" style="--p:0" x="12" y="36" width="36" height="6" rx="3" />
									<rect class="ms-d-bar" style="--p:0" x="12" y="48" width="36" height="6" rx="3" />
									<rect class="ms-d-bar" style="--p:0" x="12" y="60" width="36" height="6" rx="3" />
									<rect class="ms-d-bar" style="--p:1" x="62" y="36" width="36" height="6" rx="3" />
									<rect class="ms-d-bar" style="--p:1" x="62" y="48" width="36" height="6" rx="3" />
									<rect class="ms-d-bar" style="--p:2" x="112" y="36" width="36" height="6" rx="3" />
								</svg>
							</div>
							<dl class="ms-part-trio">
								<div><dt>You get</dt><dd>Sign-in and a clear view for every role</dd></div>
								<div><dt>What it means for you</dt><dd>The right people act, and nobody sees what they should not</dd></div>
								<div><dt>Replaces</dt><dd>Shared passwords and open files</dd></div>
							</dl>
						</div>
					</div>
				</li>

				<li class="ms-part ms-fade" id="ms-part-reports">
					<span class="ms-part-rule" aria-hidden="true"></span>
					<div class="ms-part-grid">
						<span class="ms-part-num" aria-hidden="true">03</span>
						<div class="ms-part-content">
							<div class="ms-part-main">
								<div class="ms-part-copy">
									<p class="ms-part-label">Reports</p>
									<h3 class="ms-part-q">How are we doing?</h3>
									<p class="ms-part-answer">Figures gather themselves as work is recorded, so a summary is ready when you need it instead of at the end of the month.</p>
								</div>
								<svg class="ms-part-diagram" viewBox="0 0 160 100" fill="none" stroke="var(--ms-soft-accent)" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
									<path d="M12 88h136" />
									<rect class="ms-d-rbar" style="--b:0" x="20" y="64" width="14" height="20" />
									<rect class="ms-d-rbar" style="--b:1" x="44" y="50" width="14" height="34" />
									<rect class="ms-d-rbar" style="--b:2" x="68" y="56" width="14" height="28" />
									<rect class="ms-d-rbar" style="--b:3" x="92" y="34" width="14" height="50" />
									<rect class="ms-d-rbar" style="--b:4" x="116" y="22" width="14" height="62" />
								</svg>
							</div>
							<dl class="ms-part-trio">
								<div><dt>You get</dt><dd>Summaries and totals that update as you work</dd></div>
								<div><dt>What it means for you</dt><dd>You decide with today's numbers</dd></div>
								<div><dt>Replaces</dt><dd>Evenings spent adding things up by hand</dd></div>
							</dl>
						</div>
					</div>
				</li>

				<li class="ms-part ms-fade" id="ms-part-approvals">
					<span class="ms-part-rule" aria-hidden="true"></span>
					<div class="ms-part-grid">
						<span class="ms-part-num" aria-hidden="true">04</span>
						<div class="ms-part-content">
							<div class="ms-part-main">
								<div class="ms-part-copy">
									<p class="ms-part-label">Approvals</p>
									<h3 class="ms-part-q">Who said yes?</h3>
									<p class="ms-part-answer">Important steps wait for the right person to approve them, so nothing goes ahead on a guess.</p>
								</div>
								<svg class="ms-part-diagram" viewBox="0 0 160 100" fill="none" stroke="var(--ms-soft-accent)" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
									<path d="M39 50h32M89 50h32" />
									<circle class="ms-d-node" style="--n:0" cx="30" cy="50" r="9" />
									<circle class="ms-d-node" style="--n:1" cx="80" cy="50" r="9" />
									<circle class="ms-d-node ms-d-pending" style="--n:2" cx="130" cy="50" r="9" stroke="var(--ms-attn)" stroke-dasharray="4 4" />
									<path class="ms-d-check" style="--n:0" d="M24 50 L28 54 L36 45" />
									<path class="ms-d-check" style="--n:1" d="M74 50 L78 54 L86 45" />
								</svg>
							</div>
							<dl class="ms-part-trio">
								<div><dt>You get</dt><dd>Sign-off steps built into the work</dd></div>
								<div><dt>What it means for you</dt><dd>Mistakes are caught before they count</dd></div>
								<div><dt>Replaces</dt><dd>Verbal go-aheads and forgotten messages</dd></div>
							</dl>
						</div>
					</div>
				</li>
			</ol>
		</div>
	</div>
</section>

<style>
	.ms-parts {
		scroll-margin-top: var(--header-h, 76px);
		padding-block: clamp(2.75rem, 4.5vw, 4rem);
		background: var(--color-bg);
		color: var(--ms-soft-text);
	}

	.ms-parts-inner {
		width: min(calc(100% - 48px), var(--container-inner));
		margin-inline: auto;
	}

	.ms-parts-eyebrow {
		margin: 0 0 1rem;
		color: var(--ms-soft-accent);
		font: 500 .75rem/1.2 var(--font-mono);
		letter-spacing: .14em;
		text-transform: uppercase;
	}

	.ms-parts-eyebrow::before {
		display: inline-block;
		width: 2rem;
		height: 2px;
		margin-right: .65rem;
		vertical-align: middle;
		background: var(--kt-clay);
		content: '';
	}

	.ms-parts h2 {
		margin: 0;
		color: var(--ms-soft-text);
		font: 600 clamp(1.5rem, 2.15vw, 1.95rem)/1.12 var(--font-heading);
		letter-spacing: -.03em;
	}

	.ms-parts-strong,
	.ms-parts-soft { display: block; }
	.ms-parts-soft { color: var(--ms-soft-muted); font-weight: 400; }

	.ms-parts-lede {
		margin: 1.5rem 0 0;
		max-width: 34rem;
		color: var(--ms-soft-muted);
		font-size: var(--fs-lead);
		line-height: 1.6;
	}

	.ms-parts-index { margin-top: 2.5rem; }
	.ms-parts-jump {
		margin: 0 0 .75rem;
		color: var(--ms-soft-accent);
		font: 500 .68rem/1.2 var(--font-mono);
		letter-spacing: .14em;
		text-transform: uppercase;
	}
	.ms-parts-index a {
		display: block;
		width: fit-content;
		padding: .3rem 0;
		color: var(--ms-soft-muted);
		font: 500 .8rem/1.4 var(--font-mono);
		text-decoration: none;
	}
	.ms-parts-index a:hover { color: var(--ms-soft-text); text-decoration: underline; text-underline-offset: .3rem; }
	.ms-parts-index a:focus-visible { outline: 2px solid var(--ms-soft-accent); outline-offset: 3px; }

	@media (min-width: 1000px) {
		.ms-parts-layout {
			display: grid;
			grid-template-columns: minmax(0, .7fr) minmax(0, 1.3fr);
			gap: clamp(3rem, 6vw, 6rem);
			align-items: start;
		}
		.ms-parts-intro { position: sticky; top: 7rem; align-self: start; }
	}

	@media (max-width: 999px) {
		.ms-parts-index { display: none; }
	}

	.ms-parts-list { list-style: none; margin: 0; padding: 0; }

	.ms-part {
		position: relative;
		padding: clamp(2rem, 4vw, 3rem) 0;
		scroll-margin-top: 7rem;
	}

	.ms-part-rule {
		display: block;
		height: 1px;
		background: var(--ms-soft-border);
		transform-origin: left center;
	}

	.ms-part-grid {
		display: grid;
		grid-template-columns: clamp(4.5rem, 7vw, 6rem) minmax(0, 1fr);
		gap: clamp(1.25rem, 3vw, 2.5rem);
		padding-top: 1.5rem;
	}

	.ms-part-num {
		color: var(--ms-soft-line);
		font: 400 clamp(4rem, 8vw, 7rem)/1 var(--font-heading);
	}

	.ms-part-content {
		display: grid;
		grid-template-columns: minmax(0, 1fr) 8rem;
		grid-template-areas: 'copy diagram' 'trio trio';
		column-gap: 2rem;
		row-gap: 1.75rem;
		min-width: 0;
	}

	.ms-part-main { grid-area: copy; display: contents; }
	.ms-part-copy { min-width: 0; }
	.ms-part-label {
		margin: 0 0 .75rem;
		color: var(--ms-soft-accent);
		font: 500 .72rem/1.2 var(--font-mono);
		letter-spacing: .14em;
		text-transform: uppercase;
	}

	.ms-part-q {
		margin: 0;
		color: var(--ms-soft-text);
		font: 600 clamp(1.6rem, 3vw, 2.4rem)/1.15 var(--font-heading);
		letter-spacing: -.02em;
	}

	.ms-part-answer {
		margin: 1rem 0 0;
		max-width: 46ch;
		color: var(--ms-soft-muted);
		font: 400 1.0625rem/1.6 var(--font-body);
	}

	.ms-part-diagram { grid-area: diagram; width: 8rem; height: auto; align-self: start; }

	.ms-part-trio { grid-area: trio; display: grid; gap: 1rem; margin: 0; }
	.ms-part-trio dt {
		margin: 0 0 .4rem;
		color: var(--ms-soft-accent);
		font: 500 .68rem/1.2 var(--font-mono);
		letter-spacing: .14em;
		text-transform: uppercase;
	}
	.ms-part-trio dd { margin: 0; color: var(--ms-soft-text); font: 400 .9rem/1.5 var(--font-body); }

	@media (min-width: 1200px) {
		.ms-part-trio { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1rem; }
		.ms-part-trio > div { padding-left: 1rem; border-left: 1px solid var(--ms-soft-border); }
		.ms-part-trio > div:first-child { padding-left: 0; border-left: 0; }
	}

	@media (max-width: 1199px) {
		.ms-part-trio > div + div { border-top: 1px solid var(--ms-soft-border); padding-top: 1rem; }
	}

	@media (max-width: 999px) {
		.ms-part-content { grid-template-columns: minmax(0, 1fr); grid-template-areas: 'copy' 'trio' 'diagram'; }
		.ms-part-diagram { width: 7.5rem; }
	}

	@media (max-width: 639px) {
		.ms-parts-inner { width: calc(100% - 40px); }
		.ms-part { padding: 1.75rem 0 2.5rem; }
		.ms-part-grid {
			display: grid;
			grid-template-columns: auto minmax(0, 1fr);
			column-gap: .75rem;
			row-gap: 0;
			grid-template-areas: none;
		}
		.ms-part-content,
		.ms-part-main,
		.ms-part-copy { display: contents; }
		.ms-part-num { grid-area: auto; grid-column: 1; grid-row: 1; font-size: 3rem; align-self: end; }
		.ms-part-label { grid-area: auto; grid-column: 2; grid-row: 1; align-self: end; margin: 0; }
		.ms-part-q { grid-area: auto; grid-column: 1 / -1; grid-row: 2; margin: .75rem 0; }
		.ms-part-answer { grid-area: auto; grid-column: 1 / -1; grid-row: 3; margin: 0 0 1.5rem; }
		.ms-part-trio { grid-area: auto; grid-column: 1 / -1; grid-row: 4; margin: 0 0 1.5rem; }
		.ms-part-diagram { grid-area: auto; grid-column: 1 / -1; grid-row: 5; justify-self: start; width: 7.5rem; position: static; margin: 0; }
	}

	/* Entrance motion. Hidden states only exist with the page script. */
	html.ms-js .ms-part-rule { transform: scaleX(0); transition: transform .8s ease-out; }
	html.ms-js .ms-part-num { opacity: 0; transform: translateY(12px); transition: opacity .6s ease-out, transform .6s ease-out; }
	html.ms-js .ms-part-label,
	html.ms-js .ms-part-q,
	html.ms-js .ms-part-answer { opacity: 0; transform: translateY(12px); transition: opacity .6s ease-out, transform .6s ease-out; }
	html.ms-js .ms-part-label { transition-delay: .08s; }
	html.ms-js .ms-part-q { transition-delay: .16s; }
	html.ms-js .ms-part-answer { transition-delay: .24s; }

	html.ms-js .ms-part.is-in .ms-part-rule { transform: scaleX(1); }
	html.ms-js .ms-part.is-in .ms-part-num,
	html.ms-js .ms-part.is-in .ms-part-label,
	html.ms-js .ms-part.is-in .ms-part-q,
	html.ms-js .ms-part.is-in .ms-part-answer { opacity: 1; transform: none; }

	html.ms-js .ms-d-rec { opacity: 0; transform: translateX(-16px); transition: opacity .5s ease-out, transform .5s ease-out; }
	html.ms-js .ms-d-rec:nth-of-type(2) { transition-delay: .1s; }
	html.ms-js .ms-d-rec:nth-of-type(3) { transition-delay: .2s; }
	html.ms-js .ms-d-line { opacity: 0; transition: opacity .5s ease-out .3s; }
	html.ms-js .ms-part.is-in .ms-d-rec { opacity: 1; transform: none; }
	html.ms-js .ms-part.is-in .ms-d-line { opacity: 1; }

	html.ms-js .ms-d-person { opacity: 0; transition: opacity .5s ease-out; }
	html.ms-js .ms-d-bar { opacity: 0; transform: scaleX(0); transform-origin: left center; transition: opacity .5s ease-out, transform .5s ease-out; transition-delay: calc(var(--p, 0) * .06s); }
	html.ms-js .ms-part.is-in .ms-d-person { opacity: 1; }
	html.ms-js .ms-part.is-in .ms-d-bar { opacity: 1; transform: none; }

	html.ms-js .ms-d-rbar { opacity: 0; transform: scaleY(0); transform-origin: bottom center; transition: opacity .5s ease-out, transform .5s ease-out; transition-delay: calc(var(--b, 0) * .08s); }
	html.ms-js .ms-part.is-in .ms-d-rbar { opacity: 1; transform: none; }

	html.ms-js .ms-d-node,
	html.ms-js .ms-d-check { opacity: 0; transition: opacity .5s ease-out; }
	html.ms-js .ms-d-node { transition-delay: calc(var(--n, 0) * .12s); }
	html.ms-js .ms-d-check { transition-delay: calc(var(--n, 0) * .12s + .12s); }
	html.ms-js .ms-d-pending { transition-delay: .48s; }
	html.ms-js .ms-part.is-in .ms-d-node,
	html.ms-js .ms-part.is-in .ms-d-check { opacity: 1; }

	@media (prefers-reduced-motion: reduce) {
		html.ms-js .ms-part-rule,
		html.ms-js .ms-part-num,
		html.ms-js .ms-part-label,
		html.ms-js .ms-part-q,
		html.ms-js .ms-part-answer,
		html.ms-js .ms-d-rec,
		html.ms-js .ms-d-line,
		html.ms-js .ms-d-person,
		html.ms-js .ms-d-bar,
		html.ms-js .ms-d-rbar,
		html.ms-js .ms-d-node,
		html.ms-js .ms-d-check { opacity: 1 !important; transform: none !important; transition: none !important; }
	}

	:global(html.ms-js[data-fx='lite']) .ms-part-rule,
	:global(html.ms-js[data-fx='lite']) .ms-part-num,
	:global(html.ms-js[data-fx='lite']) .ms-part-label,
	:global(html.ms-js[data-fx='lite']) .ms-part-q,
	:global(html.ms-js[data-fx='lite']) .ms-part-answer,
	:global(html.ms-js[data-fx='lite']) .ms-d-rec,
	:global(html.ms-js[data-fx='lite']) .ms-d-line,
	:global(html.ms-js[data-fx='lite']) .ms-d-person,
	:global(html.ms-js[data-fx='lite']) .ms-d-bar,
	:global(html.ms-js[data-fx='lite']) .ms-d-rbar,
	:global(html.ms-js[data-fx='lite']) .ms-d-node,
	:global(html.ms-js[data-fx='lite']) .ms-d-check { opacity: 1 !important; transform: none !important; transition: none !important; }
</style>
