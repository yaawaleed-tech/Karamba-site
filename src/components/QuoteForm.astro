---
import {
  CONTACT_EMAIL,
  CONTACT_EMAIL_URL,
  CONTACT_WHATSAPP_DISPLAY,
  WHATSAPP_QUOTE_URL,
} from '../data/contact';

/* Shared quote form, used inline on /quote and inside the quote dialog.
   One instance per idPrefix; the script below wires every instance on the
   page independently, so the dialog and page copies never collide. */

interface Props {
  /** Unique prefix for element ids (label association). */
  idPrefix: string;
  /** Success ending: a Close button (dialog) or a home link (/quote). */
  successMode: 'close' | 'home';
}

const { idPrefix, successMode } = Astro.props;
const ACCESS_KEY = import.meta.env.PUBLIC_WEB3FORMS_KEY;
---

<form
  data-quote-form={idPrefix}
  data-access-key={ACCESS_KEY}
  novalidate
  class="quote-form space-y-5"
>
  <div data-quote-fields>
    <input type="hidden" name="topic" value="" data-quote-topic-field />
    <div class="grid gap-5 sm:grid-cols-2">
      <div class="field-wrap">
        <label for={`${idPrefix}-name`} class="form-label text-sm font-medium">Your name</label>
        <input
          type="text" id={`${idPrefix}-name`} name="name" required
          autocomplete="name"
          aria-describedby={`${idPrefix}-name-error`}
          class="form-field mt-1.5 w-full rounded-lg px-4 py-2.5 text-base"
          style="background-color: var(--color-bg); color: var(--color-text);"
        />
        <p class="field-error" id={`${idPrefix}-name-error`} data-error-for="name" aria-live="polite" hidden></p>
      </div>
      <div class="field-wrap">
        <label for={`${idPrefix}-contact`} class="form-label text-sm font-medium">WhatsApp number or email</label>
        <input
          type="text" id={`${idPrefix}-contact`} name="contact" required
          autocomplete="off" inputmode="text"
          aria-describedby={`${idPrefix}-contact-error`}
          class="form-field mt-1.5 w-full rounded-lg px-4 py-2.5 text-base"
          style="background-color: var(--color-bg); color: var(--color-text);"
        />
        <p class="field-error" id={`${idPrefix}-contact-error`} data-error-for="contact" aria-live="polite" hidden></p>
      </div>
    </div>

    <div class="field-wrap mt-5">
      <label for={`${idPrefix}-message`} class="form-label text-sm font-medium">What would you like to build or fix?</label>
      <textarea
        id={`${idPrefix}-message`} name="message" rows="5" required
        placeholder="For example: we track admissions on paper and it takes days."
        aria-describedby={`${idPrefix}-message-error`}
        class="form-field mt-1.5 w-full resize-none rounded-lg px-4 py-2.5 text-base"
        style="background-color: var(--color-bg); color: var(--color-text);"
      ></textarea>
      <p class="field-error" id={`${idPrefix}-message-error`} data-error-for="message" aria-live="polite" hidden></p>
    </div>

    <!-- Honeypot spam trap, hidden from real visitors -->
    <input type="checkbox" name="botcheck" class="hidden" style="display: none;" tabindex="-1" aria-hidden="true" autocomplete="off" />

    <button
      type="submit"
      class="mt-5 w-full rounded-full px-7 py-3.5 text-sm font-semibold transition-transform hover:scale-[1.02] disabled:opacity-60"
      style="background-color: var(--color-primary); color: var(--color-primary-text);"
    >
      Send message
    </button>
  </div>

  <div data-quote-success hidden>
    <p class="text-base" style="color: var(--color-text);">
      Thanks, we have received your message and will reply within 24 hours.
    </p>
    {successMode === 'close' ? (
      <button
        type="button"
        data-quote-close
        class="mt-5 rounded-full px-7 py-3 text-sm font-semibold transition-transform hover:scale-[1.02]"
        style="background-color: var(--color-primary); color: var(--color-primary-text);"
      >
        Close
      </button>
    ) : (
      <a
        href="/"
        class="mt-5 inline-block rounded-full px-7 py-3 text-sm font-semibold transition-transform hover:scale-[1.02]"
        style="background-color: var(--color-primary); color: var(--color-primary-text);"
      >
        Back to home
      </a>
    )}
  </div>

  <div data-quote-error hidden role="status">
    <p class="text-base" style="color: var(--color-text);">
      Something went wrong. Please try WhatsApp or email us directly instead.
    </p>
    <p class="mt-3 flex flex-wrap gap-x-5 gap-y-2 text-sm font-medium">
      <a
        href={WHATSAPP_QUOTE_URL}
        target="_blank"
        rel="noopener noreferrer"
        class="transition-opacity hover:opacity-70"
        style="color: var(--color-primary);"
      >
        WhatsApp: {CONTACT_WHATSAPP_DISPLAY}
      </a>
      <a
        href={CONTACT_EMAIL_URL}
        class="wrap-anywhere transition-opacity hover:opacity-70"
        style="color: var(--color-primary);"
      >
        {CONTACT_EMAIL}
      </a>
    </p>
  </div>

  <p class="links-row mt-5 text-sm" style="color: var(--color-text-muted);">
    <span>Prefer WhatsApp?</span>
    <a
      href={WHATSAPP_QUOTE_URL}
      target="_blank"
      rel="noopener noreferrer"
      class="font-medium transition-opacity hover:opacity-70"
      style="color: var(--color-primary);"
    >
      {CONTACT_WHATSAPP_DISPLAY}
    </a>
    <span aria-hidden="true"> · </span>
    <a
      href={CONTACT_EMAIL_URL}
      class="wrap-anywhere font-medium transition-opacity hover:opacity-70"
      style="color: var(--color-primary);"
    >
      {CONTACT_EMAIL}
    </a>
  </p>
</form>

<style>
  /* Labels stay visible at all times; errors appear beneath their field. */
  .form-label {
    color: var(--color-text);
    display: inline-block;
  }
  /* Links row: flex gap (not source whitespace, which the compiler trims)
     so the label, number and email stay separated and wrap sensibly. */
  .links-row {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25em 0.5em;
  }
  .field-error {
    margin: 0.4rem 0 0;
    font-size: 0.82rem;
    color: #e05252;
  }
  /* The resting border lives here rather than inline on each field: an inline
     style outranks any stylesheet rule, so :focus could never recolour it. */
  .form-field {
    border: 1px solid var(--color-border);
    transition:
      border-color 0.25s ease,
      box-shadow 0.25s ease;
  }
  /* Branded focus state in accent-strong so keyboard users always see it. */
  .form-field:focus {
    outline: none;
    border-color: var(--color-accent-strong);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--color-accent-strong) 25%, transparent);
  }
  .form-field[aria-invalid="true"] {
    border-color: #e05252;
  }

  @media (prefers-reduced-motion: reduce) {
    .form-field {
      transition: none;
    }
  }
</style>

<script>
  // Wires every quote form on the page independently (the dialog copy and
  // the /quote copy can coexist). Runs once no matter how many copies of
  // this script Astro emits, and waits for parsing so late forms exist.
  (function () {
    if (window.__quoteFormWired) return;
    window.__quoteFormWired = true;

    function validEmail(v) {
      return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(v);
    }
    function validPhone(v) {
      const digits = v.replace(/\D/g, '');
      return digits.length >= 7 && digits.length <= 15;
    }

    function wire(form) {
      if (form.hasAttribute('data-wired')) return;
      form.setAttribute('data-wired', '');
      const get = (name) => form.querySelector(`[name="${name}"]`);
      const nameInput = get('name');
      const contactInput = get('contact');
      const messageInput = get('message');
      const botInput = get('botcheck');
      const btn = form.querySelector('[type="submit"]');
      const fields = form.querySelector('[data-quote-fields]');
      const success = form.querySelector('[data-quote-success]');
      const errorBox = form.querySelector('[data-quote-error]');
      const accessKey = form.getAttribute('data-access-key') || '';
      if (!nameInput || !contactInput || !messageInput || !btn || !fields || !success || !errorBox) return;

      function setError(name, message) {
        const input = get(name);
        const err = form.querySelector(`[data-error-for="${name}"]`);
        if (!input || !err) return;
        if (message) {
          input.setAttribute('aria-invalid', 'true');
          err.textContent = message;
          err.hidden = false;
        } else {
          input.removeAttribute('aria-invalid');
          err.textContent = '';
          err.hidden = true;
        }
      }

      form.addEventListener('submit', async function (e) {
        e.preventDefault();
        errorBox.hidden = true;
        let ok = true;
        let firstBad = null;

        const name = nameInput.value.trim();
        const contact = contactInput.value.trim();
        const message = messageInput.value.trim();

        if (!name) {
          setError('name', 'Please tell us your name.');
          ok = false;
          firstBad = firstBad || nameInput;
        } else {
          setError('name', '');
        }
        if (!contact) {
          setError('contact', 'Please add your WhatsApp number or email.');
          ok = false;
          firstBad = firstBad || contactInput;
        } else if (!validEmail(contact) && !validPhone(contact)) {
          setError('contact', 'That does not look like an email address or a phone number.');
          ok = false;
          firstBad = firstBad || contactInput;
        } else {
          setError('contact', '');
        }
        if (!message) {
          setError('message', 'Please describe what you want to build or fix.');
          ok = false;
          firstBad = firstBad || messageInput;
        } else {
          setError('message', '');
        }
        if (!ok) {
          if (firstBad) firstBad.focus();
          return;
        }

        btn.disabled = true;
        btn.textContent = 'Sending...';
        const controller = new AbortController();
        const timer = window.setTimeout(() => controller.abort(), 12000);
        try {
          const body = {
            access_key: accessKey,
            subject: 'New inquiry from karambatechnologies.com',
            name,
            contact,
            message,
          };
          if (botInput && botInput.checked) body.botcheck = 'on';
          const res = await fetch('https://api.web3forms.com/submit', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
            body: JSON.stringify(body),
            signal: controller.signal,
          });
          const data = await res.json();
          if (!data.success) throw new Error((data && data.message) || 'Submission failed');
          form.reset();
          form.classList.add('is-sent');
          fields.hidden = true;
          errorBox.hidden = true;
          success.hidden = false;
        } catch (err) {
          errorBox.hidden = false;
        } finally {
          window.clearTimeout(timer);
          btn.disabled = false;
          btn.textContent = 'Send message';
        }
      });
    }

    function wireAll() {
      document.querySelectorAll('form[data-quote-form]').forEach(wire);
    }
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', wireAll);
    } else {
      wireAll();
    }
  })();
</script>
