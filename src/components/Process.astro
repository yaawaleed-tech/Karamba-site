---
const steps = [
	{
		number: '01',
		title: 'Discovery',
		description: 'We learn how your business runs today, including the paperwork, the bottlenecks, the goals, before writing a line of code.',
	},
	{
		number: '02',
		title: 'Design',
		description: 'We map out the system and design the interface around your workflow, so it feels obvious from day one.',
	},
	{
		number: '03',
		title: 'Build',
		description: 'We build in focused stages, sharing progress along the way rather than disappearing until "done".',
	},
	{
		number: '04',
		title: 'Support',
		description: 'We stay on after launch, fixing, improving, and keeping things running as your business grows.',
	},
];
---

<!-- Full-bleed band: the section paints edge to edge, the container lives inside -->
<section id="process" style="background-color: var(--color-bg-subtle);">
	<div class="mx-auto max-w-6xl px-6 py-20">
		<div class="scroll-reveal max-w-xl">
			<h2 class="font-heading text-3xl font-bold sm:text-4xl" style="color: var(--color-text);">
				How We Work
			</h2>
			<p class="mt-3 text-lg" style="color: var(--color-text-muted);">
				A simple process, so you always know what happens next.
			</p>
		</div>

		<div class="relative mt-14 grid gap-10 sm:grid-cols-2 lg:grid-cols-4">
			<!-- connecting line, desktop only -->
			<div
				class="absolute left-0 right-0 top-6 hidden h-px lg:block"
				style="background-color: var(--color-border);"
			>
			</div>

			{steps.map((step, i) => (
				<div class={`scroll-reveal scroll-reveal-delay-${i + 1} relative`}>
					<div
						class="relative z-10 flex h-12 w-12 items-center justify-center rounded-full font-heading text-sm font-bold"
						style="background-color: var(--color-primary); color: var(--color-primary-text);"
					>
						{step.number}
					</div>
					<h3 class="mt-5 font-heading text-lg font-semibold" style="color: var(--color-text);">
						{step.title}
					</h3>
					<p class="mt-2 text-sm leading-relaxed" style="color: var(--color-text-muted);">
						{step.description}
					</p>
				</div>
			))}
		</div>
	</div>
</section>
