---
import { Image } from 'astro:assets';
import shot1 from '../assets/case-study/bluelite-1.png';
import shot2 from '../assets/case-study/bluelite-2.png';

const techUsed = ['Next.js', 'Tailwind CSS', 'Vercel', 'GitHub'];
---

<section id="work" class="mx-auto max-w-6xl px-6 py-20">
	<div class="max-w-xl">
		<span class="text-sm font-semibold" style="color: var(--color-primary);">Selected Work</span>
		<h2 class="mt-2 font-heading text-3xl font-bold sm:text-4xl" style="color: var(--color-text);">
			Bluelite Poultry
		</h2>
		<p class="mt-3 text-lg" style="color: var(--color-text-muted);">
			A QR-powered batch story page, built for our own farm — the first of its kind among broiler farms in Kano.
		</p>
	</div>

	<div class="mt-10 grid gap-6 sm:grid-cols-2">
		<div class="overflow-hidden rounded-2xl" style="border: 1px solid var(--color-border);">
			<Image
				src={shot1}
				alt="Bluelite Poultry batch story page, desktop view"
				class="w-full"
				widths={[640, 1280]}
				sizes="(min-width: 640px) 50vw, 100vw"
			/>
		</div>
		<div class="overflow-hidden rounded-2xl" style="border: 1px solid var(--color-border);">
			<Image
				src={shot2}
				alt="Bluelite Poultry batch story page, browser view"
				class="w-full"
				widths={[640, 1280]}
				sizes="(min-width: 640px) 50vw, 100vw"
			/>
		</div>
	</div>

	<div class="mt-12 grid gap-8 sm:grid-cols-3">
		<div>
			<h3 class="font-heading text-sm font-semibold uppercase tracking-wide" style="color: var(--color-primary);">
				The Problem
			</h3>
			<p class="mt-3 text-sm leading-relaxed" style="color: var(--color-text-muted);">
				Bluelite wanted premium visibility for its birds and a way to show buyers the story behind every
				batch — something we haven't seen other broiler farms in Kano doing.
			</p>
		</div>
		<div>
			<h3 class="font-heading text-sm font-semibold uppercase tracking-wide" style="color: var(--color-primary);">
				What We Built
			</h3>
			<p class="mt-3 text-sm leading-relaxed" style="color: var(--color-text-muted);">
				A mobile-first page for each batch, opened by scanning a QR code on the pack. It shows the
				harvest date, rearing details, and a direct WhatsApp ordering link — updated with every new batch.
			</p>
		</div>
		<div>
			<h3 class="font-heading text-sm font-semibold uppercase tracking-wide" style="color: var(--color-primary);">
				Result
			</h3>
			<p class="mt-3 text-sm leading-relaxed" style="color: var(--color-text-muted);">
				Live now, with QR-labelled packs shipping from the next batch. Built fast and lightweight —
				exactly the standard we hold every client project to.
			</p>
		</div>
	</div>

	<div class="mt-10 flex flex-wrap items-center justify-between gap-6 border-t pt-8" style="border-color: var(--color-border);">
		<div class="flex flex-wrap gap-2">
			{techUsed.map((tech) => (
				<span
					class="rounded-full px-3 py-1 text-xs font-medium"
					style="background-color: var(--color-bg-subtle); color: var(--color-text-muted); border: 1px solid var(--color-border);"
				>
					{tech}
				</span>
			))}
		</div>
		<a
			href="https://bluelite-poultry.vercel.app/"
			target="_blank"
			rel="noopener noreferrer"
			class="inline-flex items-center gap-1.5 text-sm font-semibold transition-opacity hover:opacity-70"
			style="color: var(--color-primary);"
		>
			Visit the live site
			<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="h-4 w-4">
				<path fill-rule="evenodd" d="M4.25 5.5a.75.75 0 00-.75.75v9c0 .414.336.75.75.75h9a.75.75 0 00.75-.75v-4a.75.75 0 011.5 0v4A2.25 2.25 0 0113.25 17.5h-9A2.25 2.25 0 012 15.25v-9a2.25 2.25 0 012.25-2.25h4a.75.75 0 010 1.5h-4z" clip-rule="evenodd" />
				<path fill-rule="evenodd" d="M6.194 12.806a.75.75 0 001.06 0l7.5-7.5v2.688a.75.75 0 001.5 0v-4.5a.75.75 0 00-.75-.75h-4.5a.75.75 0 000 1.5h2.688l-7.5 7.5a.75.75 0 000 1.06z" clip-rule="evenodd" />
			</svg>
		</a>
	</div>
</section>