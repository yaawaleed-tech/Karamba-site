---
import SectionHeading from './SectionHeading.astro';
import {
  CONTACT_WHATSAPP_DISPLAY,
  CONTACT_WHATSAPP_NUMBER,
} from '../data/contact';

/* Closing call to action: headline, primary pill opening the quote
   dialog, and a quiet WhatsApp link. All copy lives here. */

const HEADING_STRONG = 'What does your team';
const HEADING_SOFT = 'repeat every day?';
const LINE =
  'Tell us. If software can take it off your plate, we will say so. If it cannot, we will say that too.';
const WHATSAPP_HREF =
  `https://wa.me/${CONTACT_WHATSAPP_NUMBER}?text=${encodeURIComponent('Hello Karamba, I would like to talk about a project.')}`;

const pieceUrls = import.meta.glob(
  '../assets/brand/karamba-pieces/*.webp',
  { query: '?url', import: 'default', eager: true },
) as Record<string, string>;
function pieceUrl(file: string): string {
  const hit = Object.entries(pieceUrls).find(([path]) => path.endsWith('/' + file));
  return hit ? hit[1] : '';
}
---

<section id="closing-cta" class="closing-section">
	<div class="cta-wrap">
		<div class="cta-main">
			<SectionHeading strong={HEADING_STRONG} soft={HEADING_SOFT} />
			<p class="cta-line">{LINE}</p>
			<div class="cta-actions">
				<a
					href="/quote"
					data-quote
					class="cta-shimmer rounded-full px-7 py-3.5 text-sm font-semibold"
					style="background-color: var(--color-primary); color: var(--color-primary-text);"
				>
					<span>Get a quote</span>
				</a>
				<a
					href={WHATSAPP_HREF}
					target="_blank"
					rel="noopener"
					class="cta-wa"
				>
					Message us on WhatsApp
				</a>
			</div>
		</div>
			<img
				class="cta-piece"
				src={pieceUrl('arrow.webp')}
				alt=""
				aria-hidden="true"
				loading="lazy"
			/>
		</div>
</section>

<style>
	/* Full-bleed band: square edges, content vertically centred. The
	   footer follows directly with no gap. overflow: clip (not hidden)
	   crops the arrow without trapping anything. */
	#closing-cta {
		/* 
		  Container knobs for ClosingCta:
		  --closing-container: 1240px (default) use for inner container max-width.
		  --closing-pad-x: 24px (default) use for horizontal padding.
		  Setting --closing-container to none and --closing-pad-x to 48px makes
		  the content start near the left edge of the screen.
		  Default behaviour keeps the same left edge as the other sections.
		*/
		position: relative;
		overflow: clip;
		margin: 0;
		min-height: clamp(380px, 56svh, 560px);
		display: flex;
		align-items: center;
		background-color: var(--color-soft);
		--closing-container: 1240px;
		--closing-pad-x: 24px;
	}
	/* SectionHeading size knob: the shared component now reads
	   --section-heading-size and falls back to its own clamp when the
	   variable is unset, so every other section is untouched.
	   Set only at min-width 900px, so phones and tablets keep the
	   shared default. The .heading/.strong/.soft elements are rendered
	   by SectionHeading and carry that component's scope attribute,
	   so they are addressed with :global() to escape this scope.
	   No max-width or width exists on the heading or its wrapper
	   (.section-heading has none) that could force a wrap. */
	@media (min-width: 900px) {
		#closing-cta {
			--section-heading-size: clamp(2.2rem, min(4.4vw, 7.5svh), 4rem);
		}
		#closing-cta :global(.heading) {
			white-space: nowrap;
		}
		#closing-cta :global(.heading) :global(.strong),
		#closing-cta :global(.heading) :global(.soft) {
			display: block;
			white-space: nowrap;
		}
	}
	:global([data-theme='dark']) #closing-cta {
		background-color: var(--color-bg-subtle);
		border-top: 1px solid var(--color-border);
	}
	@media (prefers-color-scheme: dark) {
		:global(:root:not([data-theme='light'])) #closing-cta {
			background-color: var(--color-bg-subtle);
			border-top: 1px solid var(--color-border);
		}
	}
	.cta-wrap {
		width: 100%;
		max-width: var(--closing-container);
		margin-inline: auto;
		padding-inline: var(--closing-pad-x);
		padding-block: clamp(3rem, 8svh, 5rem);
	}
	@media (min-width: 900px) {
		.cta-wrap {
			display: grid;
			grid-template-columns: minmax(1, 62%) minmax(1, 38%);
			gap: 0;
			padding-block: 5rem;
		}
	}
	@media (max-width: 899.98px) {
		.cta-wrap {
			padding-inline: 20px;
		}
	}
	.cta-main {
		position: relative;
		z-index: 1;
	}
	.cta-line {
		margin: 1.25rem 0 0;
		max-width: 46ch;
		font-size: 1.125rem;
		line-height: 1.6;
		color: var(--color-text-muted);
	}
	.cta-actions {
		margin-top: 2rem;
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 1rem 1.5rem;
	}
	.cta-wa {
		display: inline-flex;
		align-items: center;
		min-height: 44px;
		padding: 0.6rem 0;
		font-weight: 600;
		color: var(--color-primary);
		text-decoration: none;
		transition: opacity 0.2s ease;
	}
	.cta-wa:hover {
		opacity: 0.7;
	}
	.cta-shimmer:focus-visible,
	.cta-wa:focus-visible {
		outline: 2px solid var(--color-accent-strong);
		outline-offset: 3px;
	}

	/* Primary pill shimmer, same look as the header button. */
	.cta-shimmer {
		position: relative;
		overflow: hidden;
		display: inline-block;
		transition: transform 0.25s ease, box-shadow 0.25s ease;
	}
	.cta-shimmer::after {
		content: '';
		position: absolute;
		top: 0;
		left: -60%;
		width: 40%;
		height: 100%;
		background: linear-gradient(120deg, transparent, rgba(255,255,255,0.45), transparent);
		transform: skewX(-20deg);
		transition: left 0.6s ease;
	}
	@media (hover: hover) and (pointer: fine) {
		.cta-shimmer:hover {
			transform: scale(1.05);
			box-shadow: 0 8px 24px -6px color-mix(in srgb, var(--color-primary) 55%, transparent);
		}
		.cta-shimmer:hover::after {
			left: 130%;
		}
	}
	@media (hover: none) {
		.cta-shimmer::after {
			transition: none;
			animation: cta-shimmer-sweep 5s ease-in-out infinite;
		}
		.cta-shimmer:active { transform: scale(0.96); }
	}
	@keyframes cta-shimmer-sweep {
		0%, 76% { left: -60%; }
		100% { left: 130%; }
	}

	/* Arrow piece, anchored to the bottom-right of the band, rotated -6deg,
   partly cropped by the viewport's right edge (overflow: clip on the band). */
.cta-piece {
		position: absolute;
		bottom: 0;
		right: 0;
		width: clamp(260px, 24vw, 420px);
		height: auto;
		transform: rotate(-6deg);
		pointer-events: none;
	}
	@media (max-width: 899.98px) {
		.cta-piece {
			display: none;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.cta-shimmer,
		.cta-wa {
			transition: none;
		}
		.cta-shimmer::after {
			animation: none;
		}
	}
</style>
