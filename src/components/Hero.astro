---
import HeroMark from './HeroMark.astro';
import HeroPeriphery from './HeroPeriphery.astro';

/* Hero copy: edit these constants to change the text. Rendered inside the
   stage, under the logo, by HeroMark. */
const HERO_HEADLINE = 'Many pieces. One system.';
const HERO_SUPPORT =
	'Software, automation and digital tools for businesses that run on more than spreadsheets.';
---

<div class="hero-track" id="hero-track">
<!-- 1px marker at the very top of the track. It leaves the viewport as
     soon as the page scrolls, which pauses the phone caption scheduler.
     No scroll listener involved. -->
<div class="hero-sentinel" aria-hidden="true"></div>
<section id="hero" class="hero" data-mk-l="off" data-mk-r="off">
	<HeroPeriphery />
	<div class="hero-inner">
		<HeroMark headline={HERO_HEADLINE} support={HERO_SUPPORT} />
	</div>

	<!-- Scroll cue, sits in the hero's bottom padding. The span carries the
	     position and the scroll-driven fade so the link keeps its own hover
	     transition untouched. -->
	<span class="scroll-cue-fade absolute bottom-6 left-1/2 -translate-x-1/2">
	<a
		href="#services"
		class="scroll-cue"
		aria-label="Scroll down to What We Do"
	>
		<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="scroll-cue-icon h-5 w-5" style="color: var(--color-text-muted);">
			<path d="M6 9.5l6 6 6-6" />
		</svg>
	</a>
	</span>
</section>
</div>

<style>
	/* Full-viewport hero (minus the ~76px sticky header) with the stage
	   centred. overflow: clip so the assembling pieces, which start far
	   off-screen, never cause scrollbars mid-flight. */
	.hero {
		position: relative;
		overflow: clip;
		min-height: calc(100vh - 76px);
		min-height: calc(100svh - 76px);
		display: flex;
		align-items: center;
		justify-content: center;
		padding: 24px 0 64px;
	}
	/* Stage width caps at 1200px, the padded column, and the height that
	   fits a short laptop viewport (1366x768): the vh term reserves 76px
	   for the header plus cue and breathing room, floored at 280px. */
	.hero-inner {
		position: relative;
		z-index: 1;
		width: min(1200px, 100%, max(280px, calc((100vh - 176px) * 1.6129)));
		width: min(1200px, 100%, max(280px, calc((100svh - 176px) * 1.6129)));
		margin-inline: auto;
		padding-inline: 16px;
	}

	/* Dark stage: deep indigo with a very faint 64px grid from the border
	   token. Light stays cream (the body background shows through). The
	   data-theme ancestor is :global because it lives on <html>. */
	:global([data-theme='dark']) .hero {
		background-color: var(--color-bg-subtle);
		background-image:
			linear-gradient(color-mix(in srgb, var(--color-border) 10%, transparent) 1px, transparent 1px),
			linear-gradient(90deg, color-mix(in srgb, var(--color-border) 10%, transparent) 1px, transparent 1px);
		background-size: 64px 64px;
	}
	@media (prefers-color-scheme: dark) {
		:global(:root:not([data-theme='light'])) .hero {
			background-color: var(--color-bg-subtle);
			background-image:
				linear-gradient(color-mix(in srgb, var(--color-border) 10%, transparent) 1px, transparent 1px),
				linear-gradient(90deg, color-mix(in srgb, var(--color-border) 10%, transparent) 1px, transparent 1px);
			background-size: 64px 64px;
		}
	}

	/* Scroll cue */
	.scroll-cue {
		display: flex;
		transition: opacity 0.3s ease;
	}
	@media (hover: hover) and (pointer: fine) {
		.scroll-cue:hover {
			opacity: 0.7;
		}
	}
	@media (hover: none) {
		.scroll-cue:active { opacity: 0.7; }
	}
	.scroll-cue-icon {
		animation: scroll-cue-bounce 2s ease-in-out infinite;
	}
	@keyframes scroll-cue-bounce {
		0%, 100% { transform: translateY(0); }
		50% { transform: translateY(6px); }
	}

	@media (prefers-reduced-motion: reduce) {
		.scroll-cue-icon { animation: none; opacity: 1; transform: none; }
	}

	/* ---- Pinned scroll exit (desktop only, motion-safe, view-timeline
	   browsers only) ----
	   Knobs live on :root in global.css: --header-h-compact (sticky offset,
	   flush under the compressed header), --hero-scroll-distance (extra
	   pinned scroll length). The hero height still uses --header-h, so at
	   scroll position 0 the hero looks exactly as before. Progress p runs
	   0 to 100% across the pinned distance (contain range of the track).
	   Outside this gate the track is a plain wrapper and the hero renders
	   exactly as before: no pin, no extra length, no overlap. */
	@supports (animation-timeline: view()) {
		@media (min-width: 720px) and (prefers-reduced-motion: no-preference) {
			.hero-track {
				height: calc(100svh - var(--header-h) + var(--hero-scroll-distance));
				view-timeline: --hero block;
				view-timeline-inset: var(--header-h) 0 0 0;
			}
			.hero {
				position: sticky;
				top: var(--header-h-compact);
				height: calc(100vh - var(--header-h));
				height: calc(100svh - var(--header-h));
			}
			/* Scroll cue fades 0 to 18%. */
			.scroll-cue-fade {
				animation: hero-cue-out linear both;
				animation-timeline: --hero;
				animation-range: contain 0% contain 100%;
			}
			@keyframes hero-cue-out {
				0% { opacity: 1; }
				18%, 100% { opacity: 0; }
			}
		}
	}

	/* ---- Mobile base (Chunk 3A): phone hero below 720px. The flex column
	   is already vertically centred; this only pins the height to the
	   header variable. The stage stacks logo, caption, dots, headline and
	   support in order (see HeroMark). */
	@media (max-width: 719.98px) {
		.hero {
			min-height: calc(100svh - var(--header-h));
		}
	}

	/* 1px, out of flow, so it never affects layout or sizing. */
	.hero-sentinel {
		position: absolute;
		top: 0;
		left: 0;
		width: 1px;
		height: 1px;
		pointer-events: none;
	}

	/* ---- Phone hero exit (Chunk 3B2): the hero pins for the phone
	   distance and plays the scatter sequence from scroll. Knobs live on
	   :root in global.css (--hero-scroll-distance-phone). The header
	   variable matches desktop because the header markup is identical on
	   phones, so --header-h-compact already describes it. */
	@supports (animation-timeline: view()) {
		@media (max-width: 719.98px) and (prefers-reduced-motion: no-preference) {
			.hero-track {
				height: calc(100svh - var(--header-h) + var(--hero-scroll-distance-phone));
				view-timeline: --hero block;
				view-timeline-inset: var(--header-h) 0 0 0;
			}
			.hero {
				position: sticky;
				top: var(--header-h-compact);
				height: calc(100vh - var(--header-h));
				height: calc(100svh - var(--header-h));
			}
			/* Scroll cue leaves with the rest of the rest-state UI, 0 to
			   10%, then cannot be tapped. */
			.scroll-cue-fade {
				animation: phone-cue-out linear both;
				animation-timeline: --hero;
				animation-range: contain 0% contain 100%;
			}
			@keyframes phone-cue-out {
				0% { opacity: 1; visibility: visible; }
				10%, 100% { opacity: 0; visibility: hidden; }
			}
		}
	}
</style>
