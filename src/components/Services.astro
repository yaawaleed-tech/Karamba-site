---

<!-- Full-bleed band: the section paints edge to edge, the container lives inside -->
<section id="services" style="background-color: var(--color-bg-subtle);">
	<div class="mx-auto max-w-6xl px-6 py-20">
		<div class="scroll-reveal max-w-xl">
			<h2 class="font-heading text-3xl font-bold sm:text-4xl" style="color: var(--color-text);">
				What We Do
			</h2>
			<p class="mt-3 text-lg" style="color: var(--color-text-muted);">
				Practical software, built and supported end to end.
			</p>
		</div>

		<div class="mt-12 grid gap-6 sm:grid-cols-2">
			{services.map((service, i) => (
				<div
					class={`tilt-card scroll-reveal scroll-reveal-delay-${i + 1} rounded-2xl p-7`}
					style="background-color: var(--color-card-bg); border: 1px solid var(--color-border);"
				>
					<div
						class="flex h-12 w-12 items-center justify-center rounded-xl"
						style="background-color: var(--color-bg-subtle);"
					>
						<svg
							xmlns="http://www.w3.org/2000/svg"
							fill="none"
							viewBox="0 0 24 24"
							stroke-width="1.5"
							stroke="currentColor"
							class="h-6 w-6"
							style="color: var(--color-primary);"
						>
							<path stroke-linecap="round" stroke-linejoin="round" d={service.icon} />
						</svg>
					</div>
					<h3 class="mt-5 font-heading text-lg font-semibold" style="color: var(--color-text);">
						{service.title}
					</h3>
					<p class="mt-2 text-sm leading-relaxed" style="color: var(--color-text-muted);">
						{service.benefit}
					</p>
				</div>
			))}
		</div>
	</div>
</section>
