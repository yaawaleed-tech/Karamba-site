---
import manifest from '../assets/brand/karamba-pieces/manifest.json';
import QuoteForm from './QuoteForm.astro';

/* Site-wide quote dialog, rendered once by the layout so it exists on
   every page. Native <dialog> gives modal focus trapping; one small
   script below owns open/close, history, backdrop and delegation. */

interface ManifestPiece {
  k: string;
  file: string;
  x: number;
  y: number;
  w: number;
  h: number;
}

const DIALOG_TITLE = 'What should we build?';
const DIALOG_LINE =
  'Describe the work your team repeats every day, or the system you need. We read every message and reply within 24 hours.';
const PIECES = manifest.pieces as ManifestPiece[];

const pieceUrls = import.meta.glob(
  '../assets/brand/karamba-pieces/*.webp',
  { query: '?url', import: 'default', eager: true },
) as Record<string, string>;
function pieceUrl(file: string): string {
  const hit = Object.entries(pieceUrls).find(([path]) => path.endsWith('/' + file));
  return hit ? hit[1] : '';
}
const pct = (v: number, base: number) => `${((v / base) * 100).toFixed(3)}%`;
---

<dialog id="quote-dialog" class="quote-dialog" aria-labelledby="quote-dialog-title">
	<div class="quote-shell">
		<div class="quote-visual" aria-hidden="true">
			<div class="quote-logo">
				{PIECES.map((p, i) => (
					<img
						src={pieceUrl(p.file)}
						alt=""
						loading="lazy"
						draggable="false"
						class="qpiece"
						style={`left:${pct(p.x, 656)};top:${pct(p.y, 684)};width:${pct(p.w, 656)};height:${pct(p.h, 684)};--i:${i}`}
					/>
				))}
			</div>
			<p class="quote-visual-line">We reply within 24 hours.</p>
		</div>

		<div class="quote-main">
			<button
				type="button"
				data-quote-close
				class="quote-close"
				aria-label="Close"
			>
				<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" class="h-5 w-5" aria-hidden="true">
					<path d="M6 6l12 12M18 6L6 18"></path>
				</svg>
			</button>
			<h2 id="quote-dialog-title" class="quote-title" tabindex="-1" autofocus>{DIALOG_TITLE}</h2>
			<p class="quote-line">{DIALOG_LINE}</p>
			<QuoteForm idPrefix="quote-dialog" successMode="close" />
		</div>
	</div>
</dialog>

<style>
	/* Centring is explicit: Tailwind's preflight (author origin, layered)
	   beats the UA dialog rule on origin, so UA margin:auto never applies
	   and the box would stick to the top-left. Unlayered margin:auto here
	   restores both-axis centring under position:fixed + inset:0. */
	.quote-dialog {
		border: 0;
		padding: 0;
		background: transparent;
		position: fixed;
		inset: 0;
		margin: auto;
		width: min(960px, calc(100vw - 2rem));
		max-width: 100%;
		max-height: min(90svh, 100% - 2rem);
		opacity: 0;
		transform: translateY(12px) scale(0.98);
		transition:
			opacity 0.25s ease,
			transform 0.25s ease;
	}
	.quote-dialog.is-open {
		opacity: 1;
		transform: none;
	}
	.quote-dialog::backdrop {
		background: color-mix(in srgb, var(--color-bg) 70%, transparent);
	}
	@media (hover: hover) and (pointer: fine) {
		.quote-dialog::backdrop {
			backdrop-filter: blur(6px);
			-webkit-backdrop-filter: blur(6px);
		}
	}

	.quote-shell {
		display: grid;
		grid-template-columns: 320px 1fr;
		max-height: 90svh;
		border-radius: 24px;
		overflow: hidden;
		background-color: var(--color-card-bg);
		border: 1px solid var(--color-border);
		box-shadow: 0 32px 80px -16px color-mix(in srgb, var(--color-text) 30%, transparent);
	}

	/* Left visual: soft panel, static radial glow (no filter, no motion). */
	.quote-visual {
		position: relative;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 1.25rem;
		padding: 2.5rem 2rem;
		background-color: var(--color-soft);
		overflow: hidden;
	}
	:global([data-theme='dark']) .quote-visual {
		background-color: var(--color-bg-subtle);
	}
	@media (prefers-color-scheme: dark) {
		:global(:root:not([data-theme='light'])) .quote-visual {
			background-color: var(--color-bg-subtle);
		}
	}
	.quote-visual::before {
		content: '';
		position: absolute;
		inset: -20%;
		pointer-events: none;
		background: radial-gradient(
			closest-side,
			color-mix(in srgb, var(--color-accent) 28%, transparent),
			transparent 72%
		);
	}
	.quote-logo {
		position: relative;
		width: min(190px, 70%);
		aspect-ratio: 656 / 684;
	}
	.quote-logo img {
		position: absolute;
	}
	.quote-dialog.is-open .qpiece {
		animation: qpiece-in 0.7s ease-out backwards;
		animation-delay: calc(var(--i, 0) * 50ms);
	}
	@keyframes qpiece-in {
		from {
			transform: translateY(16px) scale(0.92);
			opacity: 0;
		}
		to {
			transform: none;
			opacity: 1;
		}
	}
	.quote-visual-line {
		position: relative;
		margin: 0;
		font-size: 0.85rem;
		font-weight: 600;
		color: var(--color-text);
	}

	.quote-main {
		position: relative;
		background-color: var(--color-card-bg);
		padding: 2rem 2rem 2.25rem;
		overflow-y: auto;
		min-height: 0;
	}
	.quote-close {
		position: absolute;
		top: 0.9rem;
		right: 0.9rem;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-width: 44px;
		min-height: 44px;
		border: 0;
		border-radius: 999px;
		background: transparent;
		color: var(--color-text);
		cursor: pointer;
		transition: background-color 0.2s ease;
	}
	.quote-close:hover {
		background-color: var(--color-bg-subtle);
	}
	.quote-title {
		margin: 0;
		padding-right: 3rem;
		font-family: var(--font-heading);
		font-size: 1.75rem;
		font-weight: 700;
		line-height: 1.2;
		color: var(--color-text);
	}
	.quote-title:focus {
		outline: none;
	}
	.quote-line {
		margin: 0.6rem 0 1.5rem;
		font-size: 0.95rem;
		line-height: 1.55;
		color: var(--color-text-muted);
	}

	/* Scroll lock while open: overflow removes the scrollbar and the
	   stable gutter holds its place, so the page cannot jog sideways. */
	:global(html.quote-lock) {
		overflow: hidden;
		scrollbar-gutter: stable;
	}

	/* Phones: full-bleed sheet, visual hidden, form scrolls. */
	@media (max-width: 639.98px) {
		.quote-dialog {
			width: 100vw;
			max-width: 100vw;
			height: 100svh;
			max-height: 100svh;
			margin: 0;
		}
		.quote-shell {
			grid-template-columns: 1fr;
			border-radius: 0;
			border-left: 0;
			border-right: 0;
			height: 100%;
			max-height: 100svh;
		}
		.quote-visual {
			display: none;
		}
		.quote-main {
			padding: 1.5rem 1.25rem 2rem;
		}
		.quote-title {
			font-size: 1.5rem;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.quote-dialog {
			transition: none;
		}
		.quote-dialog.is-open .qpiece {
			animation: none;
		}
	}
</style>

<script>
  // Site-wide quote dialog. Rendered once by the layout; this script owns
  // opening, history, backdrop, focus and the /quote delegation.
  (function () {
    const dialog = document.getElementById('quote-dialog');
    if (!dialog || typeof dialog.showModal !== 'function') return;
    const heading = dialog.querySelector('#quote-dialog-title');
    const form = dialog.querySelector('[data-quote-form]');
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
    let opener = null;

    function onQuotePage() {
      return window.location.pathname.replace(/\/+$/, '') === '/quote';
    }

    function openDialog(openerEl) {
      if (dialog.open) return;
      opener = openerEl && openerEl.isConnected ? openerEl : null;
      dialog.showModal();
      const topicField = dialog.querySelector('[data-quote-topic-field]');
      if (topicField) topicField.value = opener?.getAttribute('data-quote-topic') || '';
      requestAnimationFrame(() => {
        requestAnimationFrame(() => dialog.classList.add('is-open'));
      });
      document.documentElement.classList.add('quote-lock');
      try {
        history.pushState({ quote: true }, '', '#quote');
      } catch (e) {}
      // Every device lands on the heading: native showModal() focuses
      // the autofocus element, and this covers the programmatic paths.
      // The heading carries outline:none so no ring or caret shows.
      if (heading) heading.focus({ preventScroll: true });
    }

    function visualClose() {
      if (!dialog.open) return;
      dialog.classList.remove('is-open');
      document.documentElement.classList.remove('quote-lock');
      // A sent form reverts to a fresh blank form for the next open;
      // anything merely typed stays exactly as left.
      if (form && form.classList.contains('is-sent')) {
        form.classList.remove('is-sent');
        const fields = form.querySelector('[data-quote-fields]');
        const success = form.querySelector('[data-quote-success]');
        if (fields) fields.hidden = false;
        if (success) success.hidden = true;
      }
      const finish = () => {
        if (dialog.open && !dialog.classList.contains('is-open')) dialog.close();
      };
      if (reduced.matches) finish();
      else window.setTimeout(finish, 260);
      if (opener && opener.isConnected) opener.focus({ preventScroll: true });
      opener = null;
    }

    function uiClose() {
      // Pop our own history entry when it is current; the popstate handler
      // below performs the visual close, so the stack never grows.
      if (history.state && history.state.quote) history.back();
      else visualClose();
    }

    window.addEventListener('popstate', () => {
      if (dialog.open) visualClose();
    });
    dialog.addEventListener('cancel', (e) => {
      e.preventDefault();
      uiClose();
    });
    dialog.querySelectorAll('[data-quote-close]').forEach((btn) => {
      btn.addEventListener('click', uiClose);
    });

    // Backdrop clicks close; a drag that starts inside must not.
    let downOnBackdrop = false;
    dialog.addEventListener('mousedown', (e) => {
      downOnBackdrop = e.target === dialog;
    });
    dialog.addEventListener('mouseup', (e) => {
      if (downOnBackdrop && e.target === dialog) uiClose();
      downOnBackdrop = false;
    });

    // Every /quote link or [data-quote] control opens the dialog, except on
    // /quote itself where the page already is the form.
    document.addEventListener('click', (e) => {
      const link = e.target && e.target.closest ? e.target.closest('a[href="/quote"], [data-quote]') : null;
      if (!link || onQuotePage()) return;
      if (e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
      e.preventDefault();
      openDialog(link);
    });

    // HeroMark and friends open through here; plain navigation is the fallback.
    window.__quoteDialogOpen = function (openerEl) {
      openDialog(openerEl || null);
    };

    // Deep link: any page loaded with #quote opens the dialog, without
    // pushing (there is nothing to pop back to yet).
    if (window.location.hash === '#quote') openDialog(null);
  })();
</script>
