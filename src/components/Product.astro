---
import { Image } from 'astro:assets';
import mockup1 from '../assets/product/mockup-1.jpg';

const features = [
	{
		title: 'Break-Even Selling Price',
		benefit: 'See exactly what price to sell at to make a profit, calculated from your real costs.',
	},
	{
		title: 'Live Flock Counts',
		benefit: 'Know how many birds are in the pen, how many sold, and how many were lost — always up to date.',
	},
	{
		title: 'Financial Analysis & Traceability',
		benefit: 'Every transaction recorded and traceable, with clear financial reports whenever you need them.',
	},
];
---

<section id="product" class="mx-auto max-w-6xl px-6 py-20">
	<div class="grid items-center gap-12 lg:grid-cols-2">
		<div>
			<span
				class="inline-flex items-center gap-2 rounded-full px-4 py-1.5 text-xs font-semibold"
				style="background-color: var(--color-accent); color: var(--color-accent-text);"
			>
				<span class="h-1.5 w-1.5 rounded-full" style="background-color: var(--color-accent-text);"></span>
				In development · Recruiting pilot farms
			</span>

			<h2 class="mt-5 font-heading text-3xl font-bold sm:text-4xl" style="color: var(--color-text);">
				Broiler Farm Management System
			</h2>
			<p class="mt-3 text-lg" style="color: var(--color-text-muted);">
				Software built for broiler farmers — from 50 birds to 5,000 — to replace the notebook with real numbers.
			</p>

			<div class="mt-8 space-y-5">
				{features.map((f) => (
					<div class="flex gap-3.5">
						<div
							class="mt-1 flex h-6 w-6 flex-none items-center justify-center rounded-full"
							style="background-color: var(--color-bg-subtle);"
						>
							<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="h-3.5 w-3.5" style="color: var(--color-primary);">
								<path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 01.143 1.052l-8 10.5a.75.75 0 01-1.127.075l-4.5-4.5a.75.75 0 011.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 011.05-.143z" clip-rule="evenodd" />
							</svg>
						</div>
						<div>
							<h3 class="font-heading text-sm font-semibold" style="color: var(--color-text);">
								{f.title}
							</h3>
							<p class="mt-1 text-sm" style="color: var(--color-text-muted);">
								{f.benefit}
							</p>
						</div>
					</div>
				))}
			</div>

			<a
				href="#contact"
				class="mt-9 inline-block rounded-full px-7 py-3.5 text-sm font-semibold transition-transform hover:scale-105"
				style="background-color: var(--color-primary); color: var(--color-primary-text);"
			>
				Join the Pilot Farms
			</a>
		</div>

		<div class="relative">
			<div
				class="absolute -inset-4 rounded-3xl opacity-20 blur-2xl"
				style="background: linear-gradient(135deg, var(--color-primary), var(--color-accent));"
			>
			</div>
			<div class="relative overflow-hidden rounded-2xl" style="border: 1px solid var(--color-border);">
				<Image
					src={mockup1}
					alt="Broiler Farm Management System preview"
					class="w-full"
					widths={[640, 1280]}
					sizes="(min-width: 1024px) 560px, 100vw"
				/>
				<span
					class="absolute right-3 top-3 rounded-full px-3 py-1 text-xs font-semibold"
					style="background-color: rgba(5,7,15,0.75); color: #fff;"
				>
					Preview
				</span>
			</div>
		</div>
	</div>
</section>