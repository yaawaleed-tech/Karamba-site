---
/* AudiencePills: outlined pills for who a service is for. Same look as the
   home card tags: outlined, muted, static (not links, so no touch sizing). */

interface Props {
  items: string[];
}

const { items } = Astro.props;
---

<ul class="ap-list rv-s">
	{items.map((item, i) => (
		<li class="ap-pill" style={`--i:${i}`}>{item}</li>
	))}
</ul>

<style>
	.ap-list {
		list-style: none;
		margin: 2rem 0 0;
		padding: 0;
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
	}
	.ap-pill {
		border: 1px solid var(--color-border);
		border-radius: 999px;
		padding: 0.3rem 0.8rem;
		font-size: 0.8rem;
		color: var(--color-text-muted);
	}
</style>
