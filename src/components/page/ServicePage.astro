---
import PageHero from './PageHero.astro';
import Faq from './Faq.astro';
import RelatedLinks from './RelatedLinks.astro';
import ClosingCta from '../ClosingCta.astro';
import { COMMON_FAQ, MOBILE_APPS_FAQ, type ServiceEntry } from '../../data/services';

interface Props { entry: ServiceEntry; }
const { entry } = Astro.props;
const faqItems = entry.slug === 'custom-software' ? [MOBILE_APPS_FAQ, ...COMMON_FAQ] : COMMON_FAQ;
const patterns: Record<string, { heading: string; intro: string; items: string[]; note: string }> = {
  'custom-software': { heading: 'Built around', intro: 'your working reality.', items: ['Web applications', 'Mobile applications', 'Clear ownership conversations'], note: 'Illustration: one product can bring a team, a customer and a useful record into the same flow.' },
  'management-systems': { heading: 'One view of', intro: 'the work.', items: ['Shops', 'Schools', 'Funds', 'Any organisation'], note: 'Illustration: a management system can give each role the information it needs without making every person see everything.' },
  'automation-and-ai': { heading: 'Less repeat', intro: 'work.', items: ['A task starts', 'Information moves', 'A person checks the result'], note: 'Illustration: automation is most useful when a person can see, review and change the outcome.' },
  'cloud-and-support': { heading: 'Look after', intro: 'the system.', items: ['Hosted systems', 'Ongoing support', 'Terms agreed per project'], note: 'Illustration: a healthy handover leaves clear places to look when a question comes up.' },
};
const pattern = patterns[entry.slug] ?? patterns['custom-software'];
const related = entry.slug === 'websites-and-branding' ? ['custom-software', 'management-systems'] : undefined;
---

<PageHero
  breadcrumb={[{ label: 'Home', href: '/' }, { label: 'Services', href: '/services' }, { label: entry.name }]}
  eyebrow="Services" strong={entry.strong} soft={entry.soft} intro={entry.outcome}
  primaryLabel="Get a quote" primaryHref="/quote"
  quoteTopic={entry.name}
  secondaryLabel="How we work" secondaryHref="/#how-we-work" scene={entry.scene} animated tone="mist"
/>

<main class={`service-main service-${entry.slug}`} data-service={entry.slug}>
  <section class="service-section service-section--feature rv" aria-labelledby="feature-title">
    <div class="service-copy"><p class="eyebrow"><span aria-hidden="true"></span>01 / Illustration</p>
      <h2 id="feature-title"><span>{pattern.heading}</span> {pattern.intro}</h2>
      <p>{pattern.note}</p></div>
    <ol class="service-steps" aria-label="Illustrative sequence">
      {pattern.items.map((item, i) => <li style={`--i:${i}`}><span class="figures">0{i + 1}</span><b>{item}</b></li>)}
    </ol>
  </section>

  <section class="service-section service-section--grid rv" aria-labelledby="detail-title">
    <div class="section-marker figures">02</div><div><p class="eyebrow"><span aria-hidden="true"></span>Details matter</p>
      <h2 id="detail-title"><span>Make the</span> next step clear.</h2>
      <div class="detail-grid">
        <article><span class="detail-icon" aria-hidden="true">+</span><h3>Start with the need</h3><p>We begin with what the work needs to do, not with a fixed package.</p></article>
        <article><span class="detail-icon" aria-hidden="true">→</span><h3>Agree the shape</h3><p>Scope, code ownership and support terms are discussed for each project.</p></article>
      </div>
    </div>
  </section>

  <section class="service-section service-section--band rv" aria-labelledby="band-title">
    <div class="band-rule"></div><p class="eyebrow"><span aria-hidden="true"></span>03 / A measured approach</p>
    <h2 id="band-title"><span>Useful now.</span> Ready to change later.</h2>
    <p>Illustration: a good digital tool leaves room for the next question without pretending to know it today.</p>
  </section>

  <section class="service-section service-section--list rv" aria-labelledby="list-title">
    <div class="section-marker figures">04</div><div><p class="eyebrow"><span aria-hidden="true"></span>What to bring</p>
      <h2 id="list-title"><span>A useful</span> starting point.</h2>
      <ul class="ruled-items"><li>What feels slow or unclear today</li><li>Who needs to use the result</li><li>What a good first version would change</li></ul>
    </div>
  </section>
  {entry.slug === 'websites-and-branding' && (
    <>
      <section class="service-section website-section rv" aria-labelledby="visitor-title">
        <div class="section-marker figures">05</div><div>
          <p class="eyebrow"><span aria-hidden="true"></span>Illustration / A clear path</p>
          <h2 id="visitor-title"><span>From first look</span> to first message.</h2>
          <p class="website-note">Illustration: a visitor sees a clear offer, finds proof in the right place and knows what to do next.</p>
          <div class="path-line" aria-hidden="true"><i></i><i></i><i></i></div>
        </div>
      </section>
      <section class="service-section website-board rv" aria-labelledby="board-title">
        <div><p class="eyebrow"><span aria-hidden="true"></span>Illustration / A small board</p><h2 id="board-title"><span>Make the</span> identity easy to use.</h2></div>
        <div class="board"><b>TYPE</b><strong>Colour, spacing, words.</strong><span>Example only. A brand board can give a team a shared reference.</span></div>
      </section>
    </>
  )}
  <section class="service-section service-section--questions rv" aria-labelledby="questions-title">
    <div><p class="eyebrow"><span aria-hidden="true"></span>Questions</p><h2 id="questions-title"><span>Before we</span> start.</h2></div>
    <Faq items={faqItems} />
  </section>
  <section class="service-section service-section--related rv" aria-labelledby="related-title">
    <div><p class="eyebrow"><span aria-hidden="true"></span>Continue exploring</p><h2 id="related-title"><span>See</span> also.</h2></div>
    <RelatedLinks current={entry.slug} slugs={related} />
  </section>
</main>
<ClosingCta strong={entry.closing.strong} soft={entry.closing.soft} line={entry.closing.line}
  buttonLabel={entry.closing.button} tone={entry.closing.tone} />
<script type="application/ld+json" set:html={JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map((item) => ({
    '@type': 'Question', name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
})} />

<style>
  .service-main { overflow: clip; }
  .service-section { max-width: var(--container-inner); margin-inline: auto; padding: var(--space-section) 24px; }
  .service-section--feature { display:grid; grid-template-columns: minmax(0, .9fr) minmax(300px, .75fr); gap: clamp(3rem, 9vw, 9rem); align-items:center; }
  .service-copy h2, .service-section h2 { font: 600 var(--fs-h2)/1.08 var(--font-heading); letter-spacing:-.02em; margin:.6rem 0 1.2rem; }
  h2 span { color:var(--color-text-muted); font-weight:400; }
  .service-copy > p:last-child, .service-section--band > p:last-child { max-width:44ch; color:var(--color-text-muted); line-height:1.7; }
  .eyebrow { font:500 .72rem/1.2 var(--font-mono); letter-spacing:.12em; text-transform:uppercase; color:var(--color-text-muted); }
  .eyebrow span { display:inline-block; width:2.5rem; height:2px; margin-right:.6rem; vertical-align:middle; background:var(--color-clay-ink); }
  .service-steps { list-style:none; padding:1rem 0; margin:0; border-top:1px solid var(--color-line); }
  .service-steps li { display:flex; gap:1.2rem; align-items:center; padding:1.15rem 0; border-bottom:1px solid var(--color-line); transform:translateX(calc(var(--i) * 1.2rem)); }
  .service-steps .figures, .section-marker { color:var(--color-clay-ink); font:500 1rem var(--font-mono); }
  .service-section--grid, .service-section--list { display:grid; grid-template-columns:4rem minmax(0,1fr); gap:1.5rem; border-top:1px solid var(--color-line); }
  .detail-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:1rem; margin-top:2rem; }
  .detail-grid article { min-height:12rem; padding:1.5rem; background:var(--color-surface-soft); border-radius:1.2rem; }
  .detail-icon { color:var(--color-clay-ink); font:2rem var(--font-mono); }
  .detail-grid h3 { margin:2rem 0 .4rem; font:600 var(--fs-h3)/1.2 var(--font-heading); }
  .detail-grid p { margin:0; color:var(--color-text-muted); line-height:1.6; }
  .service-section--band { max-width:none; padding-inline:max(24px, calc((100% - var(--container-inner))/2)); background:var(--color-panel); color:var(--color-panel-text); }
  .service-section--band .eyebrow, .service-section--band p { color:var(--color-panel-text-muted); }
  .service-section--band h2 span { color:var(--color-panel-text-muted); }
  .band-rule { width:100%; height:1px; margin-bottom:2.5rem; background:var(--color-panel-line); }
  .ruled-items { list-style:none; padding:0; margin:1.5rem 0 0; border-top:1px solid var(--color-line); }
  .ruled-items li { padding:1rem 0; border-bottom:1px solid var(--color-line); }
  .service-section--questions, .service-section--related { display:grid; grid-template-columns:minmax(220px,.65fr) minmax(0,1fr); gap:4rem; border-top:1px solid var(--color-line); }
  .service-section--related { align-items:start; }
  .website-section { display:grid; grid-template-columns:4rem minmax(0,1fr); gap:1.5rem; border-top:1px solid var(--color-line); }
  .website-note { max-width:42ch; color:var(--color-text-muted); line-height:1.7; }
  .path-line { display:flex; align-items:center; gap:0; max-width:34rem; margin-top:3rem; }
  .path-line::before { content:''; flex:1; height:1px; background:var(--color-clay-ink); }
  .path-line i { width:.65rem; height:.65rem; margin-left:3rem; border-radius:50%; background:var(--color-clay-ink); }
  .website-board { display:grid; grid-template-columns:minmax(220px,.65fr) minmax(0,1fr); gap:4rem; border-top:1px solid var(--color-line); }
  .board { display:grid; gap:1rem; padding:2rem; min-height:14rem; border:1px solid var(--color-line); border-radius:1.2rem; background:var(--color-surface-soft); }
  .board b { color:var(--color-clay-ink); font:500 .7rem var(--font-mono); letter-spacing:.15em; }
  .board strong { font:600 clamp(1.7rem,3vw,2.7rem)/1.1 var(--font-heading); }
  .board span { color:var(--color-text-muted); }
  @media (max-width:899px) { .service-section, .service-section--feature, .service-section--questions, .service-section--related, .website-section, .website-board { display:block; padding-block:4.5rem; } .service-section--feature .service-steps { margin-top:2.5rem; } .service-section--grid, .service-section--list { display:block; } .section-marker { margin-bottom:1.5rem; } .detail-grid { grid-template-columns:1fr; } .service-steps li { transform:none; } .website-board .board { margin-top:2rem; } }
  @media (prefers-reduced-motion:no-preference) { .rv { opacity:0; transform:translateY(1.5rem); animation:rise linear both; animation-timeline:view(); animation-range:entry 8% cover 28%; } }
  @keyframes rise { to { opacity:1; transform:none; } }
  @media (prefers-reduced-motion:reduce) { .rv { opacity:1; transform:none; } }
</style>
