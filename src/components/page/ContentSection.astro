---
import SectionHeading from '../SectionHeading.astro';

/* ContentSection: the repeated section wrapper for service pages. Same
   container as the home sections so the left edge matches everywhere. */

interface Props {
  eyebrow?: string;
  strong: string;
  soft: string;
}

const { eyebrow, strong, soft } = Astro.props;
---

<section class="content-section">
	<div class="cs-inner">
		<div class="rv">
			<SectionHeading eyebrow={eyebrow} strong={strong} soft={soft} />
		</div>
		<slot />
	</div>
</section>

<style>
	.cs-inner {
		max-width: var(--container-inner);
		margin-inline: auto;
		padding-inline: 24px;
		padding-block: var(--space-section);
		/* Section heading size hook for the shared component. */
		--section-heading-size: var(--fs-h2);
	}
	@media (max-width: 899.98px) {
		.cs-inner {
			padding-inline: 20px;
		}
	}
</style>
