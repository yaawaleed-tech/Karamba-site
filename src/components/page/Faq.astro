---
import type { FaqItem } from '../../data/services';

/* Faq: native details and summary, no JavaScript. Hairline separated,
   plus and minus drawn with CSS. */

interface Props {
  items: FaqItem[];
}

const { items } = Astro.props;
---

<div class="faq-list rv-s">
	{items.map((item, i) => (
		<details class="faq-item" style={`--i:${i}`} name="service-faq">
			<summary class="faq-q">
				<span class="faq-q-text">{item.q}</span>
				<span class="faq-icon" aria-hidden="true"></span>
			</summary>
			<p class="faq-a">{item.a}</p>
		</details>
	))}
</div>

<style>
	.faq-list {
		margin: 2.5rem 0 0;
	}
	.faq-item {
		border-top: 1px solid color-mix(in srgb, var(--color-text) 18%, transparent);
	}
	.faq-item:last-child {
		border-bottom: 1px solid color-mix(in srgb, var(--color-text) 18%, transparent);
	}
	.faq-q {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1.5rem;
		min-height: 44px;
		margin: 0;
		padding-block: 1rem;
		font-family: var(--font-heading);
		font-weight: 600;
		font-size: var(--fs-h3);
		line-height: 1.3;
		color: var(--color-text);
		cursor: pointer;
		list-style: none;
	}
	.faq-q::marker {
		content: none;
	}
	.faq-q::-webkit-details-marker {
		display: none;
	}
	.faq-q:focus-visible {
		outline: 2px solid var(--color-accent-strong);
		outline-offset: 4px;
	}
	.faq-q-text {
		min-width: 0;
	}
	/* Plus sign from two bars; the vertical bar folds away when open. */
	.faq-icon {
		position: relative;
		flex: none;
		width: 14px;
		height: 14px;
	}
	.faq-icon::before,
	.faq-icon::after {
		content: '';
		position: absolute;
		background-color: var(--color-accent-strong);
	}
	.faq-icon::before {
		left: 0;
		right: 0;
		top: 6px;
		height: 2px;
	}
	.faq-icon::after {
		top: 0;
		bottom: 0;
		left: 6px;
		width: 2px;
		transition: transform 0.2s ease;
	}
	.faq-item[open] .faq-icon::after {
		transform: scaleY(0);
	}
	.faq-a {
		margin: 0;
		padding-bottom: 1.25rem;
		max-width: 62ch;
		line-height: 1.6;
		color: var(--color-text-muted);
	}
	@media (prefers-reduced-motion: reduce) {
		.faq-icon::after {
			transition: none;
		}
	}
</style>
