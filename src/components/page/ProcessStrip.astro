---
import { STEPS } from '../HowWeWork.astro';

/* ProcessStrip: the four project steps as a static ruler. A thin line
   with four dots on desktop, a vertical list on phones. Step copy is
   imported from the home PACE section, never retyped. Static, no scroll
   animation. */
---

<ol class="ps-list rv-s rv-line">
	{STEPS.map((step, i) => (
		<li class="ps-step" style={`--i:${i}`}>
			<span class="ps-dot" aria-hidden="true"></span>
			<span class="ps-letter" aria-hidden="true">{step.letter}</span>
			<h3 class="ps-name">{step.name}</h3>
			<p class="ps-desc">{step.description}</p>
		</li>
	))}
</ol>

<style>
	.ps-list {
		position: relative;
		list-style: none;
		margin: 2.5rem 0 0;
		padding: 0;
		display: grid;
		gap: 2rem;
	}
	@media (min-width: 900px) {
		.ps-list {
			grid-template-columns: repeat(4, minmax(0, 1fr));
		}
		/* The ruler line runs behind the four dots. Drawn with ::after
		   so the line-draw utility can play it. */
		.ps-list::after {
			content: '';
			position: absolute;
			top: 6px;
			left: 0;
			right: 0;
			height: 1px;
			background-color: var(--color-border);
			pointer-events: none;
		}
	}
	@media (max-width: 899.98px) {
		.ps-list::after {
			content: '';
			position: absolute;
			top: 8px;
			bottom: 8px;
			left: 6px;
			width: 1px;
			background-color: var(--color-border);
			pointer-events: none;
		}
	}
	.ps-step {
		display: flex;
		flex-direction: column;
		gap: 0;
		min-width: 0;
	}
	@media (max-width: 899.98px) {
		.ps-step {
			display: grid;
			grid-template-columns: 13px minmax(0, 1fr);
			column-gap: 1rem;
		}
		.ps-dot {
			grid-column: 1;
			grid-row: 1;
		}
		.ps-letter {
			grid-column: 2;
			grid-row: 1;
		}
		.ps-name {
			grid-column: 2;
			grid-row: 2;
		}
		.ps-desc {
			grid-column: 2;
			grid-row: 3;
		}
	}
	.ps-dot {
		display: block;
		width: 13px;
		height: 13px;
		border-radius: 50%;
		background-color: var(--color-accent-strong);
		position: relative;
		z-index: 1;
	}
	.ps-letter {
		margin-top: 0.75rem;
		font-size: 0.8rem;
		font-weight: 600;
		letter-spacing: 0.2em;
		color: var(--color-accent-strong);
	}
	.ps-name {
		margin: 0.35rem 0 0;
		font-family: var(--font-heading);
		font-weight: 600;
		font-size: 1.25rem;
		line-height: 1.3;
		color: var(--color-text);
	}
	.ps-desc {
		margin: 0.5rem 0 0;
		line-height: 1.6;
		color: var(--color-text-muted);
	}
</style>
