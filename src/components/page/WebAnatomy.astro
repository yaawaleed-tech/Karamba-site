---
import SectionHeading from '../SectionHeading.astro';

/* WebAnatomy: the pinned "what a website is made of" section for the
   websites page.

   Desktop, inside the scroll-driven gate, the section pins while five
   parts of a browser frame are called out in turn. Everywhere else
   (below 1200px, without view() support, or with reduced motion) it is a
   plain section: heading, the fully built frame, then the same five
   labels as a ruled list. One source of markup, so screen readers get the
   same content in both modes. */

interface Label {
  n: string;
  side: 'left' | 'right';
  at: string;
  title: string;
  text: string;
}

const LABELS: Label[] = [
  {
    n: '01',
    side: 'right',
    at: '11%',
    title: 'Navigation',
    text: 'Helps visitors find their way.',
  },
  {
    n: '02',
    side: 'left',
    at: '33%',
    title: 'Headline',
    text: 'Says what you do, in one line.',
  },
  {
    n: '03',
    side: 'right',
    at: '38%',
    title: 'Image',
    text: 'Shows the work, the place or the product.',
  },
  {
    n: '04',
    side: 'left',
    at: '68%',
    title: 'Content blocks',
    text: 'Holds the details people come for.',
  },
  {
    n: '05',
    side: 'right',
    at: '91%',
    title: 'Footer',
    text: 'Keeps contact details and links in one place.',
  },
];
---

<section class="anat-section" aria-labelledby="anat-heading">
	<div class="anat-track">
		<div class="anat-stage">
			<div class="anat-head">
				<SectionHeading
					eyebrow="Anatomy"
					strong="What a website"
					soft="is made of."
				/>
			</div>

			<div class="anat-figure">
				<div class="anat-frame" aria-hidden="true">
					<div class="fbar">
						<span class="fdot fdot-clay"></span>
						<span class="fdot fdot-mist"></span>
						<span class="fdot fdot-teal"></span>
						<span class="fbar-address"></span>
					</div>

					<div class="fnav">
						<span class="fnav-logo"></span>
						<span class="fnav-link"></span>
						<span class="fnav-link"></span>
						<span class="fnav-link"></span>
						<span class="fnav-link"></span>
						<span class="fnav-cta"></span>
					</div>

					<div class="fhead">
						<span class="fhead-bar fhead-bar-1"></span>
						<span class="fhead-bar fhead-bar-2"></span>
						<span class="fhead-thin fhead-thin-1"></span>
						<span class="fhead-thin fhead-thin-2"></span>
						<span class="fhead-cta"></span>
					</div>

					<div class="fimg">
						<span class="fimg-sun"></span>
						<span class="fimg-hill"></span>
					</div>

					<div class="fcards">
						<span class="fcard"></span>
						<span class="fcard"></span>
						<span class="fcard"></span>
					</div>

					<div class="ffoot">
						<div class="ffoot-col">
							<span class="ffoot-bar"></span>
							<span class="ffoot-bar"></span>
							<span class="ffoot-bar"></span>
						</div>
						<div class="ffoot-col">
							<span class="ffoot-bar"></span>
							<span class="ffoot-bar"></span>
							<span class="ffoot-bar"></span>
						</div>
						<div class="ffoot-col">
							<span class="ffoot-bar"></span>
							<span class="ffoot-bar"></span>
						</div>
					</div>
				</div>

				<ol class="anat-labels rv-s">
					{LABELS.map((label) => (
						<li
							class="anat-label"
							data-side={label.side}
							data-n={label.n}
							style={`--at:${label.at};--i:${LABELS.indexOf(label)}`}
						>
							<span class="anat-leader" aria-hidden="true"></span>
							<span class="anat-num figures" aria-hidden="true">{label.n}</span>
							<h3 class="anat-title">{label.title}</h3>
							<p class="anat-text">{label.text}</p>
						</li>
					))}
				</ol>

				<p class="anat-caption">Illustration: the parts of a typical business website.</p>
			</div>
		</div>
	</div>
</section>

<style>
	/* Knobs. --anat-distance is the extra scroll length the pinned stage
	   holds for; the track is one screen less the header plus that, and the
	   stage is exactly one screen less the header. */
	.anat-section {
		--anat-distance: 260svh;
		--anat-frame-w: min(720px, 52vw);
		--anat-frame-h: min(56svh, 440px);
		--anat-label-w: min(260px, 15vw);
		--anat-gap: 24px;
		--section-heading-size: var(--fs-h2);
		margin: 0;
		/* No overflow, no contain, no transform anywhere on this chain: a
		   sticky stage needs all of them to stay visible. */
	}
	.anat-track {
		/* Full-bleed: the pinned diagram needs the whole viewport width for
		   the frame plus two label columns. Only the heading is held to the
		   normal container so it still lines up with the rest of the page. */
		padding-inline: 24px;
	}
	.anat-head {
		max-width: var(--container-inner);
		margin-inline: auto;
		width: 100%;
	}
	@media (max-width: 899.98px) {
		.anat-track {
			padding-inline: 20px;
		}
	}
	/* Below the pinned breakpoint the frame takes the full column width,
	   so it never ends up a tall narrow strip on a phone. */
	@media (max-width: 1199.98px) {
		.anat-figure {
			width: 100%;
		}
	}
	@media (max-width: 899.98px) {
		.anat-frame {
			height: min(46svh, 380px);
		}
	}
	.anat-stage {
		display: grid;
		justify-items: center;
		align-content: center;
		gap: 1.5rem;
	}
	.anat-figure {
		position: relative;
		width: var(--anat-frame-w);
		max-width: 100%;
	}
	.anat-caption {
		margin: 1.25rem 0 0;
		font-size: 0.8rem;
		text-align: center;
		color: var(--color-text-muted);
	}

	/* ---- Static mode: frame plus a ruled list of the same labels ---- */
	.anat-labels {
		list-style: none;
		margin: 2rem 0 0;
		padding: 0;
	}
	.anat-label {
		position: relative;
		padding: 1rem 0;
	}
	.anat-label::after {
		content: '';
		position: absolute;
		left: 0;
		right: 0;
		top: 0;
		height: 1px;
		background-color: color-mix(in srgb, var(--color-text) 18%, transparent);
	}
	.anat-label:last-child {
		border-bottom: 1px solid color-mix(in srgb, var(--color-text) 18%, transparent);
	}
	.anat-leader {
		display: none;
	}
	.anat-num {
		min-width: 2.5rem;
		font-size: 1.25rem;
		font-weight: 500;
		letter-spacing: 0.15em;
		color: var(--color-clay-ink);
	}
	.anat-title {
		margin: 0.25rem 0 0;
		font-family: var(--font-heading);
		font-weight: 600;
		font-size: var(--fs-h3);
		line-height: 1.25;
		color: var(--color-text);
	}
	.anat-text {
		margin: 0.35rem 0 0;
		max-width: 34ch;
		font-size: 0.95rem;
		line-height: 1.5;
		color: var(--color-text-muted);
	}

	/* ---- The frame: plain divs, tokens only ---- */
	.anat-frame {
		position: relative;
		width: 100%;
		height: var(--anat-frame-h);
		border: 1px solid var(--color-border);
		border-radius: 16px;
		background-color: var(--color-card-bg);
		overflow: hidden;
	}
	.fbar {
		position: absolute;
		inset: 0 0 auto 0;
		height: 11%;
		display: flex;
		align-items: center;
		gap: 6px;
		padding-inline: 3%;
		border-bottom: 1px solid var(--color-border);
	}
	.fdot {
		width: 7px;
		height: 7px;
		border-radius: 50%;
		flex: none;
	}
	.fdot-clay { background-color: var(--color-clay); }
	.fdot-mist { background-color: var(--color-soft); }
	.fdot-teal { background-color: var(--color-accent); }
	.fbar-address {
		margin-left: 4%;
		width: 42%;
		height: 42%;
		border-radius: 999px;
		background-color: color-mix(in srgb, var(--color-soft) 55%, var(--color-card-bg));
	}
	.fnav {
		position: absolute;
		left: 5%;
		top: 14%;
		width: 90%;
		height: 8%;
		display: flex;
		align-items: center;
		gap: 2%;
	}
	.fnav-logo {
		width: 12%;
		height: 44%;
		border-radius: 3px;
		background-color: var(--color-accent);
		flex: none;
	}
	.fnav-link {
		width: 11%;
		height: 26%;
		border-radius: 999px;
		background-color: color-mix(in srgb, var(--color-text) 16%, transparent);
		flex: none;
	}
	.fnav-cta {
		margin-left: auto;
		width: 16%;
		height: 46%;
		border-radius: 999px;
		background-color: var(--color-accent);
		flex: none;
	}
	.fhead {
		position: absolute;
		left: 5%;
		top: 27%;
		width: 44%;
		height: 28%;
	}
	.fhead-bar {
		height: 15%;
		border-radius: 999px;
		background-color: var(--color-text);
		transform-origin: left center;
	}
	.fhead-bar-1 { width: 92%; margin-bottom: 7%; }
	.fhead-bar-2 { width: 58%; }
	.fhead-thin {
		height: 8%;
		border-radius: 999px;
		background-color: color-mix(in srgb, var(--color-text) 20%, transparent);
	}
	.fhead-thin-1 { width: 80%; margin-top: 12%; }
	.fhead-thin-2 { width: 62%; margin-top: 5%; }
	.fhead-cta {
		display: block;
		width: 26%;
		height: 13%;
		margin-top: 10%;
		border-radius: 999px;
		background-color: var(--color-accent);
	}
	.fimg {
		position: absolute;
		left: 55%;
		top: 27%;
		width: 40%;
		height: 28%;
		border-radius: 12px;
		background-color: var(--color-soft);
		overflow: hidden;
	}
	.fimg-sun {
		position: absolute;
		left: 12%;
		top: 14%;
		width: 22%;
		aspect-ratio: 1;
		border-radius: 50%;
		background-color: var(--color-card-bg);
	}
	.fimg-hill {
		position: absolute;
		left: 0;
		right: 0;
		bottom: 0;
		height: 58%;
		background-color: var(--color-accent);
		clip-path: polygon(0% 100%, 26% 34%, 48% 66%, 68% 30%, 100% 100%);
	}
	.fcards {
		position: absolute;
		left: 5%;
		top: 60%;
		width: 90%;
		height: 17%;
		display: flex;
		gap: 3%;
	}
	.fcard {
		flex: 1;
		border-radius: 8px;
		background-color: color-mix(in srgb, var(--color-soft) 45%, var(--color-card-bg));
	}
	.ffoot {
		position: absolute;
		left: 5%;
		top: 81%;
		width: 90%;
		height: 12%;
		display: flex;
		gap: 6%;
		padding-top: 3%;
		border-top: 1px solid var(--color-border);
	}
	.ffoot-col {
		flex: 1;
		display: flex;
		flex-direction: column;
		gap: 12%;
	}
	.ffoot-bar {
		height: 16%;
		border-radius: 999px;
		background-color: color-mix(in srgb, var(--color-text) 16%, transparent);
	}

	/* ---- Pinned mode ---- */
	@supports (animation-timeline: view()) {
		@media (prefers-reduced-motion: no-preference) {
			@media (min-width: 1200px) {
				/* Side labels need 260px columns plus a frame to fit; below
				   1200px the labels would collide, so the static list is
				   used instead. See the width arithmetic in the report. */
				.anat-track {
					/* The track is one screen less the header, plus the pin
					   distance. It declares the timeline; every animation
					   inside references it by name. */
					height: calc(100svh - var(--header-h-compact) + var(--anat-distance));
					view-timeline: --anat block;
				}
				.anat-stage {
					position: sticky;
					top: var(--header-h-compact);
					height: calc(100svh - var(--header-h-compact));
					overflow: visible;
				}
				.anat-labels {
					margin: 0;
					height: 0;
				}
				.anat-label {
					position: absolute;
					top: var(--at);
					margin-top: -0.4rem;
					width: var(--anat-label-w);
					padding: 0;
					z-index: 1;
				}
				.anat-label[data-side='right'] {
					right: calc(-1 * (var(--anat-label-w) + var(--anat-gap)));
				}
				.anat-label[data-side='left'] {
					left: calc(-1 * (var(--anat-label-w) + var(--anat-gap)));
				}
				.anat-label::after {
					display: none;
				}
				.anat-label:last-child {
					border-bottom: none;
				}
				.anat-leader {
					display: block;
					position: absolute;
					top: 0.55rem;
					width: var(--anat-gap);
					height: 1px;
					background-color: color-mix(in srgb, var(--color-text) 30%, transparent);
				}
				.anat-label[data-side='right'] .anat-leader {
					right: calc(-1 * var(--anat-gap));
					transform-origin: left center;
				}
				.anat-label[data-side='left'] .anat-leader {
					left: calc(-1 * var(--anat-gap));
					transform-origin: right center;
				}
				/* The dot sits at the frame edge, its own box with its own
				   opacity animation, so nothing shares a property. */
				.anat-leader::after {
					content: '';
					position: absolute;
					top: 50%;
					width: 7px;
					height: 7px;
					border-radius: 50%;
					background-color: var(--color-clay);
					opacity: 0;
				}
				.anat-label[data-side='right'] .anat-leader::after {
					right: -3px;
					transform: translateY(-50%);
				}
				.anat-label[data-side='left'] .anat-leader::after {
					left: -3px;
					transform: translateY(-50%);
				}

				/* Frame: opacity and scale. */
				.anat-frame {
					animation: anat-frame-in linear both;
					animation-timeline: --anat;
					animation-range: contain 0.1% contain 6%;
				}
				@keyframes anat-frame-in {
					from { opacity: 0; transform: scale(0.96); }
					to { opacity: 1; transform: none; }
				}
				/* The frame ring is a separate box so the frame itself keeps
				   a single animation. */
				.anat-frame::after {
					content: '';
					position: absolute;
					inset: 0;
					border: 1px solid color-mix(in srgb, var(--color-text) 40%, transparent);
					border-radius: 16px;
					pointer-events: none;
					opacity: 0;
					animation: anat-ring linear both;
					animation-timeline: --anat;
					animation-range: contain 90% contain 99.9%;
				}
				@keyframes anat-ring {
					to { opacity: 1; }
				}

				.fnav {
					animation: anat-part-up linear both;
					animation-timeline: --anat;
					animation-range: contain 8% contain 20%;
				}
				@keyframes anat-part-up {
					from { opacity: 0; transform: translateY(-16px); }
					to { opacity: 1; transform: none; }
				}
				.fhead-bar-1 {
					animation: anat-bar linear both;
					animation-timeline: --anat;
					animation-range: contain 24% contain 33%;
				}
				.fhead-bar-2 {
					animation: anat-bar linear both;
					animation-timeline: --anat;
					animation-range: contain 27% contain 36%;
				}
				@keyframes anat-bar {
					from { transform: scaleX(0); }
					to { transform: scaleX(1); }
				}
				.fhead-thin,
				.fhead-cta {
					animation: anat-fade linear both;
					animation-timeline: --anat;
					animation-range: contain 30% contain 36%;
				}
				@keyframes anat-fade {
					from { opacity: 0; }
					to { opacity: 1; }
				}
				.fimg {
					animation: anat-img linear both;
					animation-timeline: --anat;
					animation-range: contain 40% contain 52%;
				}
				@keyframes anat-img {
					from { opacity: 0; transform: scale(0.9); }
					to { opacity: 1; transform: none; }
				}
				.fcard:nth-child(1) {
					animation: anat-card linear both;
					animation-timeline: --anat;
					animation-range: contain 56% contain 70%;
				}
				.fcard:nth-child(2) {
					animation: anat-card linear both;
					animation-timeline: --anat;
					animation-range: contain 60% contain 70%;
				}
				.fcard:nth-child(3) {
					animation: anat-card linear both;
					animation-timeline: --anat;
					animation-range: contain 64% contain 70%;
				}
				@keyframes anat-card {
					from { opacity: 0; transform: translateY(24px); }
					to { opacity: 1; transform: none; }
				}
				.ffoot {
					animation: anat-foot linear both;
					animation-timeline: --anat;
					animation-range: contain 74% contain 84%;
				}
				@keyframes anat-foot {
					from { opacity: 0; transform: translateY(18px); }
					to { opacity: 1; transform: none; }
				}

				/* Labels: the longhands here out-specify the kit's
				   `.rv-s > *` rule for the timeline and range only. The
				   shorthand stays on the side rules below, so no shorthand
				   ever competes with these longhands, and the label
				   animation-name is the one from its own side. */
				.anat-figure .anat-labels.rv-s > .anat-label {
					animation-timeline: --anat;
					animation-range: contain var(--label-from) contain var(--label-to);
				}
				.anat-label[data-n='01'] { --label-from: 14%; --label-to: 24%; }
				.anat-label[data-n='02'] { --label-from: 30%; --label-to: 40%; }
				.anat-label[data-n='03'] { --label-from: 46%; --label-to: 56%; }
				.anat-label[data-n='04'] { --label-from: 62%; --label-to: 72%; }
				.anat-label[data-n='05'] { --label-from: 80%; --label-to: 90%; }
				.anat-label[data-side='right'] {
					animation: anat-label-in-right linear both;
				}
				.anat-label[data-side='left'] {
					animation: anat-label-in-left linear both;
				}
				@keyframes anat-label-in-right {
					from { opacity: 0; transform: translateX(24px); }
					to { opacity: 1; transform: none; }
				}
				@keyframes anat-label-in-left {
					from { opacity: 0; transform: translateX(-24px); }
					to { opacity: 1; transform: none; }
				}
				.anat-leader {
					animation: anat-leader linear both;
					animation-timeline: --anat;
					animation-range: contain 10% contain 20%;
				}
				@keyframes anat-leader {
					from { transform: scaleX(0); }
					to { transform: scaleX(1); }
				}
				.anat-leader::after {
					animation: anat-dot linear both;
					animation-timeline: --anat;
					animation-range: contain 20% contain 24%;
				}
				@keyframes anat-dot {
					from { opacity: 0; }
					to { opacity: 1; }
				}
			}
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.anat-leader::after {
			opacity: 1;
		}
	}

</style>

<script>
	/* DEV-ONLY pinned-stage readout (?anat=debug). import.meta.env.DEV is
	   replaced with false at build time, so the minifier drops this whole
	   block and nothing of it ships to production. */
	if (import.meta.env.DEV && window.location.search.includes('anat=debug')) {
		const track = document.querySelector('.anat-track');
		const stage = document.querySelector('.anat-stage');
		const box = document.createElement('pre');
		box.setAttribute('aria-hidden', 'true');
		box.style.cssText =
			'position:fixed;left:8px;top:8px;z-index:9999;margin:0;padding:8px;' +
			'font:11px/1.5 monospace;white-space:pre;color:#fff;' +
			'background:rgba(0,0,0,.75);pointer-events:none;';
		document.body.appendChild(box);
		function frame() {
			if (!track || !stage) return;
			const cs = getComputedStyle(stage);
			const rect = stage.getBoundingClientRect();
			const t = track.getBoundingClientRect();
			const top = parseFloat(cs.top) || 0;
			const stuck = Math.abs(rect.top - top) <= 1;
			const vh = window.innerHeight || 1;
			// Progress of the contain range: 0 when the track top reaches the
			// viewport top, 1 when the track bottom reaches the viewport bottom.
			const span = Math.max(1, track.offsetHeight - vh);
			const travelled = vh - t.top;
			const progress = Math.min(100, Math.max(0, (travelled / span) * 100));
			const rows = [...stage.querySelectorAll('.anat-frame, .fnav, .fhead-bar-1, .fimg, .fcard, .ffoot, .anat-label')]
				.map((el) => `${el.className.split(' ')[0]}=${getComputedStyle(el).opacity}`)
				.join(' ');
			box.textContent =
				`trackH=${Math.round(track.offsetHeight)} stageH=${Math.round(stage.offsetHeight)}\n` +
				`position=${cs.position} top=${top} rectTop=${Math.round(rect.top)} stuck=${stuck}\n` +
				`containProgress=${progress.toFixed(1)}%\n${rows}`;
			requestAnimationFrame(frame);
		}
		requestAnimationFrame(frame);
	}
</script>