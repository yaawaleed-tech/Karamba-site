---
import SectionHeading from '../SectionHeading.astro';
import { PROMISES } from '../../data/services';

/* WhyKaramba: full-bleed indigo band with three promise columns separated
   by hairlines. No cards. Copy comes from the services data file. */

const HEADING_STRONG = 'What you';
const HEADING_SOFT = 'can expect.';
---

<section class="why-band" aria-label="What you can expect">
	<div class="why-inner">
		<div class="rv">
			<SectionHeading tone="inverse" strong={HEADING_STRONG} soft={HEADING_SOFT} />
		</div>
		<div class="why-grid rv-s">
			{PROMISES.map((promise, i) => (
				<div class="why-col rv-line" style={`--i:${i}`}>
					<span class="why-num figures" aria-hidden="true">0{i + 1}</span>
					<h3 class="why-title">{promise.title}</h3>
					<p class="why-text">{promise.text}</p>
				</div>
			))}
		</div>
	</div>
</section>

<style>
	.why-band {
		margin: 0;
		background-color: var(--color-panel);
	}
	.why-inner {
		max-width: var(--container-inner);
		margin-inline: auto;
		padding-inline: 24px;
		padding-block: var(--space-section);
		/* Section heading size hook for the shared component. */
		--section-heading-size: var(--fs-h2);
	}
	@media (max-width: 899.98px) {
		.why-inner {
			padding-inline: 20px;
		}
	}
	.why-grid {
		display: grid;
		gap: 2rem;
		margin-top: 2.5rem;
	}
	.why-col {
		position: relative;
	}
	@media (min-width: 900px) {
		.why-grid {
			grid-template-columns: repeat(3, minmax(0, 1fr));
			gap: 0 2.5rem;
		}
		.why-col + .why-col {
			padding-inline-start: 2.5rem;
		}
		/* Divider drawn with ::after so the line-draw utility can play it. */
		.why-col + .why-col::after {
			content: '';
			position: absolute;
			top: 0;
			bottom: 0;
			left: 0;
			width: 1px;
			background-color: color-mix(in srgb, var(--color-panel-text) 22%, transparent);
			pointer-events: none;
		}
	}
	@media (max-width: 899.98px) {
		.why-col + .why-col {
			padding-top: 2rem;
		}
		.why-col + .why-col::after {
			content: '';
			position: absolute;
			top: 0;
			left: 0;
			right: 0;
			height: 1px;
			background-color: color-mix(in srgb, var(--color-panel-text) 22%, transparent);
			pointer-events: none;
		}
	}
	.why-num {
		display: block;
		min-width: 3ch;
		font-size: 1.25rem;
		font-weight: 500;
		letter-spacing: 0.2em;
		/* The band is indigo in both themes, so the light clay holds. */
		color: var(--kt-clay-light);
	}
	.why-title {
		margin: 0.75rem 0 0;
		font-family: var(--font-heading);
		font-weight: 600;
		font-size: var(--fs-h3);
		line-height: 1.3;
		color: var(--color-panel-text);
	}
	.why-text {
		margin: 0.5rem 0 0;
		line-height: 1.6;
		color: var(--color-panel-muted);
	}
</style>
